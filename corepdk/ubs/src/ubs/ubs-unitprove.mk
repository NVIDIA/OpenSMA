# we analyse all files in the autogenerated default.gpr
UBS_PROVE_FLAGS  ?= -U --checks-as-errors=on

ubs-prove-banner: 
	$(ubs_banner_str 'UNITPROVE')

UBS_PROVE_STAGES := ubs-prove-banner

prove: $(UBS_PROVE_STAGES)
	$(UBS_GNAT_PROVE) -P$(UBS_GPR_PROJECT) --mode=all $(UBS_PROVE_FLAGS)
	$(UBS_CAT) $(UBS_PATH_OBJ)/gnatprove/gnatprove.out

examine: $(UBS_PROVE_STAGES)
	$(UBS_GNAT_PROVE) -P$(UBS_GPR_PROJECT) --mode=flow $(UBS_PROVE_FLAGS)
	$(UBS_CAT) $(UBS_PATH_OBJ)/gnatprove/gnatprove.out

check: $(UBS_PROVE_STAGES)
	$(UBS_GNAT_PROVE) -P$(UBS_GPR_PROJECT) --mode=check_all $(UBS_PROVE_FLAGS)
	$(UBS_CAT) $(UBS_PATH_OBJ)/gnatprove/gnatprove.out

.PHONY: prove $(UBS_PROVE_STAGES)
.SILENT: $(UBS_PROVE_STAGES)
.NOTPARALLEL: prove $(UBS_PROVE_STAGES)

