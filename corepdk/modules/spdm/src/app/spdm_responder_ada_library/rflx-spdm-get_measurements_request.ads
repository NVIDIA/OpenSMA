       and Ctx.Buffer_First = Ctx.Buffer_First'Old
       and Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and Ctx.First = Ctx.First'Old
       and Ctx.Last = Ctx.Last'Old
       and Predecessor (Ctx, F_Measurement_Operation) = Predecessor (Ctx, F_Measurement_Operation)'Old
       and Valid_Next (Ctx, F_Measurement_Operation) = Valid_Next (Ctx, F_Measurement_Operation)'Old
       and Get_Generate_Signature (Ctx) = Get_Generate_Signature (Ctx)'Old
       and Field_First (Ctx, F_Measurement_Operation) = Field_First (Ctx, F_Measurement_Operation)'Old
       and Field_Last (Ctx, F_Measurement_Operation) = Field_Last (Ctx, Predecessor (Ctx, F_Measurement_Operation)) + Field_Size (Ctx, F_Measurement_Operation)
       and (for all F in Field range F_Reserved_1 .. F_Generate_Signature =>
               Context_Cursors_Index (Context_Cursors (Ctx), F) = Context_Cursors_Index (Context_Cursors (Ctx)'Old, F));

   procedure Set_Reserved_2 (Ctx : in out Context; Val : RFLX.SPDM.Reserved_4) with
     Inline_Always,
     Pre =>
       not Ctx'Constrained
       and then RFLX.SPDM.Get_Measurements_Request.Has_Buffer (Ctx)
       and then RFLX.SPDM.Get_Measurements_Request.Valid_Next (Ctx, RFLX.SPDM.Get_Measurements_Request.F_Reserved_2)
       and then RFLX.SPDM.Valid_Reserved_4 (RFLX.SPDM.To_Base_Integer (Val))
       and then RFLX.SPDM.Get_Measurements_Request.Available_Space (Ctx, RFLX.SPDM.Get_Measurements_Request.F_Reserved_2) >= RFLX.SPDM.Get_Measurements_Request.Field_Size (Ctx, RFLX.SPDM.Get_Measurements_Request.F_Reserved_2)
       and then RFLX.SPDM.Get_Measurements_Request.Field_Condition (Ctx, RFLX.SPDM.Get_Measurements_Request.F_Reserved_2, RFLX.SPDM.To_Base_Integer (Val)),
     Post =>
       Has_Buffer (Ctx)
       and Valid (Ctx, F_Reserved_2)
       and Invalid (Ctx, F_Slot_ID_Param)
       and (Predecessor (Ctx, F_Slot_ID_Param) = F_Reserved_2
            and Valid_Next (Ctx, F_Slot_ID_Param))
       and Ctx.Buffer_First = Ctx.Buffer_First'Old
       and Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and Ctx.First = Ctx.First'Old
       and Ctx.Last = Ctx.Last'Old
       and Predecessor (Ctx, F_Reserved_2) = Predecessor (Ctx, F_Reserved_2)'Old
       and Valid_Next (Ctx, F_Reserved_2) = Valid_Next (Ctx, F_Reserved_2)'Old
       and Get_Generate_Signature (Ctx) = Get_Generate_Signature (Ctx)'Old
       and Get_Measurement_Operation (Ctx) = Get_Measurement_Operation (Ctx)'Old
       and Field_First (Ctx, F_Reserved_2) = Field_First (Ctx, F_Reserved_2)'Old
       and Field_Last (Ctx, F_Reserved_2) = Field_Last (Ctx, Predecessor (Ctx, F_Reserved_2)) + Field_Size (Ctx, F_Reserved_2)
       and (for all F in Field range F_Reserved_1 .. F_Nonce_Data =>
               Context_Cursors_Index (Context_Cursors (Ctx), F) = Context_Cursors_Index (Context_Cursors (Ctx)'Old, F));

   procedure Set_Slot_ID_Param (Ctx : in out Context; Val : RFLX.SPDM.Narrow_Slot) with
     Inline_Always,
     Pre =>
       not Ctx'Constrained
       and then RFLX.SPDM.Get_Measurements_Request.Has_Buffer (Ctx)
       and then RFLX.SPDM.Get_Measurements_Request.Valid_Next (Ctx, RFLX.SPDM.Get_Measurements_Request.F_Slot_ID_Param)
       and then RFLX.SPDM.Valid_Narrow_Slot (RFLX.SPDM.To_Base_Integer (Val))
       and then RFLX.SPDM.Get_Measurements_Request.Available_Space (Ctx, RFLX.SPDM.Get_Measurements_Request.F_Slot_ID_Param) >= RFLX.SPDM.Get_Measurements_Request.Field_Size (Ctx, RFLX.SPDM.Get_Measurements_Request.F_Slot_ID_Param)
       and then RFLX.SPDM.Get_Measurements_Request.Field_Condition (Ctx, RFLX.SPDM.Get_Measurements_Request.F_Slot_ID_Param, RFLX.SPDM.To_Base_Integer (Val)),
     Post =>
       Has_Buffer (Ctx)
       and Valid (Ctx, F_Slot_ID_Param)
       and Get_Slot_ID_Param (Ctx) = Val
       and (if Structural_Valid_Message (Ctx) then Message_Last (Ctx) = Field_Last (Ctx, F_Slot_ID_Param))
       and Ctx.Buffer_First = Ctx.Buffer_First'Old
       and Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and Ctx.First = Ctx.First'Old
       and Ctx.Last = Ctx.Last'Old
       and Predecessor (Ctx, F_Slot_ID_Param) = Predecessor (Ctx, F_Slot_ID_Param)'Old
       and Valid_Next (Ctx, F_Slot_ID_Param) = Valid_Next (Ctx, F_Slot_ID_Param)'Old
       and Get_Generate_Signature (Ctx) = Get_Generate_Signature (Ctx)'Old
       and Get_Measurement_Operation (Ctx) = Get_Measurement_Operation (Ctx)'Old
       and Field_First (Ctx, F_Slot_ID_Param) = Field_First (Ctx, F_Slot_ID_Param)'Old
       and Field_Last (Ctx, F_Slot_ID_Param) = Field_Last (Ctx, Predecessor (Ctx, F_Slot_ID_Param)) + Field_Size (Ctx, F_Slot_ID_Param)
       and (for all F in Field range F_Reserved_1 .. F_Reserved_2 =>
               Context_Cursors_Index (Context_Cursors (Ctx), F) = Context_Cursors_Index (Context_Cursors (Ctx)'Old, F));

   pragma Warnings (On, "aspect ""*"" not enforced on inlined subprogram ""*""");

   procedure Initialize_Nonce_Data (Ctx : in out Context) with
     Pre =>
       not Ctx'Constrained
       and then RFLX.SPDM.Get_Measurements_Request.Has_Buffer (Ctx)
       and then RFLX.SPDM.Get_Measurements_Request.Valid_Next (Ctx, RFLX.SPDM.Get_Measurements_Request.F_Nonce_Data)
       and then RFLX.SPDM.Get_Measurements_Request.Available_Space (Ctx, RFLX.SPDM.Get_Measurements_Request.F_Nonce_Data) >= RFLX.SPDM.Get_Measurements_Request.Field_Size (Ctx, RFLX.SPDM.Get_Measurements_Request.F_Nonce_Data),
     Post =>
       Has_Buffer (Ctx)
       and Structural_Valid (Ctx, F_Nonce_Data)
       and Invalid (Ctx, F_Reserved_2)
       and Invalid (Ctx, F_Slot_ID_Param)
       and (Predecessor (Ctx, F_Reserved_2) = F_Nonce_Data
            and Valid_Next (Ctx, F_Reserved_2))
       and Ctx.Buffer_First = Ctx.Buffer_First'Old
       and Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and Ctx.First = Ctx.First'Old
       and Ctx.Last = Ctx.Last'Old
       and Predecessor (Ctx, F_Nonce_Data) = Predecessor (Ctx, F_Nonce_Data)'Old
       and Valid_Next (Ctx, F_Nonce_Data) = Valid_Next (Ctx, F_Nonce_Data)'Old
       and Get_Generate_Signature (Ctx) = Get_Generate_Signature (Ctx)'Old
       and Get_Measurement_Operation (Ctx) = Get_Measurement_Operation (Ctx)'Old
       and Field_First (Ctx, F_Nonce_Data) = Field_First (Ctx, F_Nonce_Data)'Old
       and Field_Last (Ctx, F_Nonce_Data) = Field_Last (Ctx, Predecessor (Ctx, F_Nonce_Data)) + Field_Size (Ctx, F_Nonce_Data);

   procedure Set_Nonce_Data (Ctx : in out Context; Data : RFLX_Types.Bytes) with
     Pre =>
       not Ctx'Constrained
       and then RFLX.SPDM.Get_Measurements_Request.Has_Buffer (Ctx)
       and then RFLX.SPDM.Get_Measurements_Request.Valid_Next (Ctx, RFLX.SPDM.Get_Measurements_Request.F_Nonce_Data)
       and then RFLX.SPDM.Get_Measurements_Request.Available_Space (Ctx, RFLX.SPDM.Get_Measurements_Request.F_Nonce_Data) >= RFLX.SPDM.Get_Measurements_Request.Field_Size (Ctx, RFLX.SPDM.Get_Measurements_Request.F_Nonce_Data)
       and then RFLX.SPDM.Get_Measurements_Request.Valid_Length (Ctx, RFLX.SPDM.Get_Measurements_Request.F_Nonce_Data, Data'Length)
       and then RFLX.SPDM.Get_Measurements_Request.Available_Space (Ctx, RFLX.SPDM.Get_Measurements_Request.F_Nonce_Data) >= Data'Length * RFLX_Types.Byte'Size
       and then RFLX.SPDM.Get_Measurements_Request.Field_Condition (Ctx, RFLX.SPDM.Get_Measurements_Request.F_Nonce_Data, 0),
     Post =>
       Has_Buffer (Ctx)
       and Structural_Valid (Ctx, F_Nonce_Data)
       and Invalid (Ctx, F_Reserved_2)
       and Invalid (Ctx, F_Slot_ID_Param)
       and (Predecessor (Ctx, F_Reserved_2) = F_Nonce_Data
            and Valid_Next (Ctx, F_Reserved_2))
       and Ctx.Buffer_First = Ctx.Buffer_First'Old
       and Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and Ctx.First = Ctx.First'Old
       and Ctx.Last = Ctx.Last'Old
       and Predecessor (Ctx, F_Nonce_Data) = Predecessor (Ctx, F_Nonce_Data)'Old
       and Valid_Next (Ctx, F_Nonce_Data) = Valid_Next (Ctx, F_Nonce_Data)'Old
       and Get_Generate_Signature (Ctx) = Get_Generate_Signature (Ctx)'Old
       and Get_Measurement_Operation (Ctx) = Get_Measurement_Operation (Ctx)'Old
       and Field_First (Ctx, F_Nonce_Data) = Field_First (Ctx, F_Nonce_Data)'Old
       and Field_Last (Ctx, F_Nonce_Data) = Field_Last (Ctx, Predecessor (Ctx, F_Nonce_Data)) + Field_Size (Ctx, F_Nonce_Data)
       and Equal (Ctx, F_Nonce_Data, Data);

   generic
      with procedure Process_Nonce_Data (Nonce_Data : out RFLX_Types.Bytes);
      with function Process_Data_Pre (Length : RFLX_Types.Length) return Boolean;
   procedure Generic_Set_Nonce_Data (Ctx : in out Context; Length : RFLX_Types.Length) with
     Pre =>
       not Ctx'Constrained
       and then RFLX.SPDM.Get_Measurements_Request.Has_Buffer (Ctx)
       and then RFLX.SPDM.Get_Measurements_Request.Valid_Next (Ctx, RFLX.SPDM.Get_Measurements_Request.F_Nonce_Data)
       and then RFLX.SPDM.Get_Measurements_Request.Available_Space (Ctx, RFLX.SPDM.Get_Measurements_Request.F_Nonce_Data) >= RFLX.SPDM.Get_Measurements_Request.Field_Size (Ctx, RFLX.SPDM.Get_Measurements_Request.F_Nonce_Data)
       and then RFLX.SPDM.Get_Measurements_Request.Valid_Length (Ctx, RFLX.SPDM.Get_Measurements_Request.F_Nonce_Data, Length)
       and then RFLX_Types.To_Length (RFLX.SPDM.Get_Measurements_Request.Available_Space (Ctx, RFLX.SPDM.Get_Measurements_Request.F_Nonce_Data)) >= Length
       and then Process_Data_Pre (Length),
     Post =>
       Has_Buffer (Ctx)
       and Structural_Valid (Ctx, F_Nonce_Data)
       and Invalid (Ctx, F_Reserved_2)
       and Invalid (Ctx, F_Slot_ID_Param)
       and (Predecessor (Ctx, F_Reserved_2) = F_Nonce_Data
            and Valid_Next (Ctx, F_Reserved_2))
       and Ctx.Buffer_First = Ctx.Buffer_First'Old
       and Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and Ctx.First = Ctx.First'Old
       and Ctx.Last = Ctx.Last'Old
       and Predecessor (Ctx, F_Nonce_Data) = Predecessor (Ctx, F_Nonce_Data)'Old
       and Valid_Next (Ctx, F_Nonce_Data) = Valid_Next (Ctx, F_Nonce_Data)'Old
       and Get_Generate_Signature (Ctx) = Get_Generate_Signature (Ctx)'Old
       and Get_Measurement_Operation (Ctx) = Get_Measurement_Operation (Ctx)'Old
       and Field_First (Ctx, F_Nonce_Data) = Field_First (Ctx, F_Nonce_Data)'Old
       and Field_Last (Ctx, F_Nonce_Data) = Field_Last (Ctx, Predecessor (Ctx, F_Nonce_Data)) + Field_Size (Ctx, F_Nonce_Data);

   function Context_Cursor (Ctx : Context; Fld : Field) return Field_Cursor with
     Annotate =>
       (GNATprove, Inline_For_Proof),
     Ghost;

   function Context_Cursors (Ctx : Context) return Field_Cursors with
     Annotate =>
       (GNATprove, Inline_For_Proof),
     Ghost;

   function Context_Cursors_Index (Cursors : Field_Cursors; Fld : Field) return Field_Cursor with
     Annotate =>
       (GNATprove, Inline_For_Proof),
     Ghost;

private

   type Cursor_State is (S_Valid, S_Structural_Valid, S_Invalid, S_Incomplete);

   type Field_Cursor (State : Cursor_State := S_Invalid) is
      record
         Predecessor : Virtual_Field := F_Final;
         case State is
            when S_Valid | S_Structural_Valid =>
               First : RFLX_Types.Bit_Index := RFLX_Types.Bit_Index'First;
               Last : RFLX_Types.Bit_Length := RFLX_Types.Bit_Length'First;
               Value : RFLX_Types.Base_Integer := 0;
            when S_Invalid | S_Incomplete =>
               null;
         end case;
      end record;

   type Field_Cursors is array (Virtual_Field) of Field_Cursor;

   function Structural_Valid (Cursor : Field_Cursor) return Boolean is
     (Cursor.State = S_Valid
      or Cursor.State = S_Structural_Valid);

   function Valid (Cursor : Field_Cursor) return Boolean is
     (Cursor.State = S_Valid);

   function Invalid (Cursor : Field_Cursor) return Boolean is
     (Cursor.State = S_Invalid
      or Cursor.State = S_Incomplete);

   pragma Warnings (Off, """Buffer"" is not modified, could be of access constant type");

   pragma Warnings (Off, "postcondition does not mention function result");

   function Valid_Context (Buffer_First, Buffer_Last : RFLX_Types.Index; First : RFLX_Types.Bit_Index; Last : RFLX_Types.Bit_Length; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length; Buffer : RFLX_Types.Bytes_Ptr; Cursors : Field_Cursors) return Boolean is
     ((if Buffer /= null then Buffer'First = Buffer_First and Buffer'Last = Buffer_Last)
      and then (RFLX_Types.To_Index (First) >= Buffer_First
                and RFLX_Types.To_Index (Last) <= Buffer_Last
                and Buffer_Last < RFLX_Types.Index'Last
                and First <= Last + 1
                and Last < RFLX_Types.Bit_Index'Last
                and First rem RFLX_Types.Byte'Size = 1
                and Last rem RFLX_Types.Byte'Size = 0)
      and then First - 1 <= Verified_Last
      and then First - 1 <= Written_Last
      and then Verified_Last <= Written_Last
      and then Written_Last <= Last
      and then First rem RFLX_Types.Byte'Size = 1
      and then Last rem RFLX_Types.Byte'Size = 0
      and then Verified_Last rem RFLX_Types.Byte'Size = 0
      and then Written_Last rem RFLX_Types.Byte'Size = 0
      and then (for all F in Field =>
                   (if
                       Structural_Valid (Cursors (F))
                    then
                       Cursors (F).First >= First
                       and Cursors (F).Last <= Verified_Last
                       and Cursors (F).First <= Cursors (F).Last + 1
                       and Valid_Value (F, Cursors (F).Value)))
      and then ((if
                    Structural_Valid (Cursors (F_Generate_Signature))
                 then
                    (Valid (Cursors (F_Reserved_1))
                     and then Cursors (F_Generate_Signature).Predecessor = F_Reserved_1))
                and then (if
                             Structural_Valid (Cursors (F_Measurement_Operation))
                          then
                             (Valid (Cursors (F_Generate_Signature))
                              and then Cursors (F_Measurement_Operation).Predecessor = F_Generate_Signature))
                and then (if
                             Structural_Valid (Cursors (F_Nonce_Data))
                          then
                             (Valid (Cursors (F_Measurement_Operation))
                              and then Cursors (F_Nonce_Data).Predecessor = F_Measurement_Operation
                              and then RFLX_Types.Base_Integer (Cursors (F_Generate_Signature).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))))
                and then (if
                             Structural_Valid (Cursors (F_Reserved_2))
                          then
                             (Structural_Valid (Cursors (F_Nonce_Data))
                              and then Cursors (F_Reserved_2).Predecessor = F_Nonce_Data))
                and then (if
                             Structural_Valid (Cursors (F_Slot_ID_Param))
                          then
                             (Valid (Cursors (F_Reserved_2))
                              and then Cursors (F_Slot_ID_Param).Predecessor = F_Reserved_2)))
      and then ((if Invalid (Cursors (F_Reserved_1)) then Invalid (Cursors (F_Generate_Signature)))
                and then (if Invalid (Cursors (F_Generate_Signature)) then Invalid (Cursors (F_Measurement_Operation)))
                and then (if Invalid (Cursors (F_Measurement_Operation)) then Invalid (Cursors (F_Nonce_Data)))
                and then (if Invalid (Cursors (F_Nonce_Data)) then Invalid (Cursors (F_Reserved_2)))
                and then (if Invalid (Cursors (F_Reserved_2)) then Invalid (Cursors (F_Slot_ID_Param))))
      and then (if
                   Structural_Valid (Cursors (F_Reserved_1))
                then
                   Cursors (F_Reserved_1).Last - Cursors (F_Reserved_1).First + 1 = 7
                   and then Cursors (F_Reserved_1).Predecessor = F_Initial
                   and then Cursors (F_Reserved_1).First = First
                   and then (if
                                Structural_Valid (Cursors (F_Generate_Signature))
                             then
                                Cursors (F_Generate_Signature).Last - Cursors (F_Generate_Signature).First + 1 = 1
                                and then Cursors (F_Generate_Signature).Predecessor = F_Reserved_1
                                and then Cursors (F_Generate_Signature).First = Cursors (F_Reserved_1).Last + 1
                                and then (if
                                             Structural_Valid (Cursors (F_Measurement_Operation))
                                          then
                                             Cursors (F_Measurement_Operation).Last - Cursors (F_Measurement_Operation).First + 1 = 8
                                             and then Cursors (F_Measurement_Operation).Predecessor = F_Generate_Signature
                                             and then Cursors (F_Measurement_Operation).First = Cursors (F_Generate_Signature).Last + 1
                                             and then (if
                                                          Structural_Valid (Cursors (F_Nonce_Data))
                                                          and then RFLX_Types.Base_Integer (Cursors (F_Generate_Signature).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))
                                                       then
                                                          Cursors (F_Nonce_Data).Last - Cursors (F_Nonce_Data).First + 1 = 256
                                                          and then Cursors (F_Nonce_Data).Predecessor = F_Measurement_Operation
                                                          and then Cursors (F_Nonce_Data).First = Cursors (F_Measurement_Operation).Last + 1
                                                          and then (if
                                                                       Structural_Valid (Cursors (F_Reserved_2))
                                                                    then
                                                                       Cursors (F_Reserved_2).Last - Cursors (F_Reserved_2).First + 1 = 4
                                                                       and then Cursors (F_Reserved_2).Predecessor = F_Nonce_Data
                                                                       and then Cursors (F_Reserved_2).First = Cursors (F_Nonce_Data).Last + 1
                                                                       and then (if
                                                                                    Structural_Valid (Cursors (F_Slot_ID_Param))
                                                                                 then
                                                                                    Cursors (F_Slot_ID_Param).Last - Cursors (F_Slot_ID_Param).First + 1 = 4
                                                                                    and then Cursors (F_Slot_ID_Param).Predecessor = F_Reserved_2
                                                                                    and then Cursors (F_Slot_ID_Param).First = Cursors (F_Reserved_2).Last + 1)))))));

   pragma Warnings (On, """Buffer"" is not modified, could be of access constant type");

   pragma Warnings (On, "postcondition does not mention function result");

   type Context (Buffer_First, Buffer_Last : RFLX_Types.Index := RFLX_Types.Index'First; First : RFLX_Types.Bit_Index := RFLX_Types.Bit_Index'First; Last : RFLX_Types.Bit_Length := RFLX_Types.Bit_Length'First) is
      record
         Verified_Last : RFLX_Types.Bit_Length := First - 1;
         Written_Last : RFLX_Types.Bit_Length := First - 1;
         Buffer : RFLX_Types.Bytes_Ptr := null;
         Cursors : Field_Cursors := [others => (State => S_Invalid, Predecessor => F_Final)];
      end record with
     Dynamic_Predicate =>
       Valid_Context (Context.Buffer_First, Context.Buffer_Last, Context.First, Context.Last, Context.Verified_Last, Context.Written_Last, Context.Buffer, Context.Cursors);

   function Initialized (Ctx : Context) return Boolean is
     (Ctx.Verified_Last = Ctx.First - 1
      and then Valid_Next (Ctx, F_Reserved_1)
      and then RFLX.SPDM.Get_Measurements_Request.Field_First (Ctx, RFLX.SPDM.Get_Measurements_Request.F_Reserved_1) rem RFLX_Types.Byte'Size = 1
      and then Available_Space (Ctx, F_Reserved_1) = Ctx.Last - Ctx.First + 1
      and then (for all F in Field =>
                   Invalid (Ctx, F)));

   function Has_Buffer (Ctx : Context) return Boolean is
     (Ctx.Buffer /= null);

   function Buffer_Length (Ctx : Context) return RFLX_Types.Length is
     (Ctx.Buffer'Length);

   function Size (Ctx : Context) return RFLX_Types.Bit_Length is
     (Ctx.Verified_Last - Ctx.First + 1);

   function Byte_Size (Ctx : Context) return RFLX_Types.Length is
     (RFLX_Types.To_Length (Size (Ctx)));

   function Message_Last (Ctx : Context) return RFLX_Types.Bit_Length is
     (Ctx.Verified_Last);

   function Written_Last (Ctx : Context) return RFLX_Types.Bit_Length is
     (Ctx.Written_Last);

   function Valid_Value (Fld : Field; Val : RFLX_Types.Base_Integer) return Boolean is
     ((case Fld is
          when F_Reserved_1 =>
             RFLX.SPDM.Valid_Reserved_7 (Val),
          when F_Generate_Signature =>
             Valid_Boolean (Val),
          when F_Measurement_Operation =>
             RFLX.SPDM.Valid_Index (Val),
          when F_Nonce_Data =>
             True,
          when F_Reserved_2 =>
             RFLX.SPDM.Valid_Reserved_4 (Val),
          when F_Slot_ID_Param =>
             RFLX.SPDM.Valid_Narrow_Slot (Val)));

   function Path_Condition (Ctx : Context; Fld : Field) return Boolean is
     ((case Ctx.Cursors (Fld).Predecessor is
          when F_Initial | F_Reserved_1 | F_Generate_Signature | F_Nonce_Data | F_Reserved_2 | F_Slot_ID_Param | F_Final =>
             True,
          when F_Measurement_Operation =>
             RFLX_Types.Base_Integer (Ctx.Cursors (F_Generate_Signature).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))));

   function Field_Condition (Ctx : Context; Fld : Field; Val : RFLX_Types.Base_Integer) return Boolean is
     ((case Fld is
          when F_Reserved_1 | F_Generate_Signature =>
             True,
          when F_Measurement_Operation =>
             RFLX_Types.Base_Integer (Ctx.Cursors (F_Generate_Signature).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
             or RFLX_Types.Base_Integer (Ctx.Cursors (F_Generate_Signature).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True)),
          when F_Nonce_Data | F_Reserved_2 | F_Slot_ID_Param =>
             True));

   function Field_Size (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Length is
     ((case Fld is
          when F_Reserved_1 =>
             7,
          when F_Generate_Signature =>
             1,
          when F_Measurement_Operation =>
             8,
          when F_Nonce_Data =>
             256,
          when F_Reserved_2 | F_Slot_ID_Param =>
             4));

   function Field_First (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Index is
     ((if Fld = F_Reserved_1 then Ctx.First else Ctx.Cursors (Ctx.Cursors (Fld).Predecessor).Last + 1));

   function Field_Last (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Length is
     (Field_First (Ctx, Fld) + Field_Size (Ctx, Fld) - 1);

   function Predecessor (Ctx : Context; Fld : Virtual_Field) return Virtual_Field is
     ((case Fld is
          when F_Initial =>
             F_Initial,
          when others =>
             Ctx.Cursors (Fld).Predecessor));

   function Valid_Predecessor (Ctx : Context; Fld : Virtual_Field) return Boolean is
     ((case Fld is
          when F_Initial =>
             True,
          when F_Reserved_1 =>
             Ctx.Cursors (Fld).Predecessor = F_Initial,
          when F_Generate_Signature =>
             (Valid (Ctx.Cursors (F_Reserved_1))
              and Ctx.Cursors (Fld).Predecessor = F_Reserved_1),
          when F_Measurement_Operation =>
             (Valid (Ctx.Cursors (F_Generate_Signature))
              and Ctx.Cursors (Fld).Predecessor = F_Generate_Signature),
          when F_Nonce_Data =>
             (Valid (Ctx.Cursors (F_Measurement_Operation))
              and Ctx.Cursors (Fld).Predecessor = F_Measurement_Operation),
          when F_Reserved_2 =>
             (Structural_Valid (Ctx.Cursors (F_Nonce_Data))
              and Ctx.Cursors (Fld).Predecessor = F_Nonce_Data),
          when F_Slot_ID_Param =>
             (Valid (Ctx.Cursors (F_Reserved_2))
              and Ctx.Cursors (Fld).Predecessor = F_Reserved_2),
          when F_Final =>
             (Valid (Ctx.Cursors (F_Measurement_Operation))
              and Ctx.Cursors (Fld).Predecessor = F_Measurement_Operation)
             or (Valid (Ctx.Cursors (F_Slot_ID_Param))
                 and Ctx.Cursors (Fld).Predecessor = F_Slot_ID_Param)));

   function Valid_Next (Ctx : Context; Fld : Field) return Boolean is
     (Valid_Predecessor (Ctx, Fld)
      and then Path_Condition (Ctx, Fld));

   function Available_Space (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Length is
     (Ctx.Last - Field_First (Ctx, Fld) + 1);

   function Sufficient_Space (Ctx : Context; Fld : Field) return Boolean is
     (Available_Space (Ctx, Fld) >= Field_Size (Ctx, Fld));

   function Present (Ctx : Context; Fld : Field) return Boolean is
     (Structural_Valid (Ctx.Cursors (Fld))
      and then Ctx.Cursors (Fld).First < Ctx.Cursors (Fld).Last + 1);

   function Structural_Valid (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Valid
      or Ctx.Cursors (Fld).State = S_Structural_Valid);

   function Valid (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Valid
      and then Ctx.Cursors (Fld).First < Ctx.Cursors (Fld).Last + 1);

   function Incomplete (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Incomplete);

   function Invalid (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Invalid
      or Ctx.Cursors (Fld).State = S_Incomplete);

   function Structural_Valid_Message (Ctx : Context) return Boolean is
     ((Valid (Ctx, F_Measurement_Operation)
       and then RFLX_Types.Base_Integer (Ctx.Cursors (F_Generate_Signature).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False)))
      or Valid (Ctx, F_Slot_ID_Param));

   function Valid_Message (Ctx : Context) return Boolean is
     ((Valid (Ctx, F_Measurement_Operation)
       and then RFLX_Types.Base_Integer (Ctx.Cursors (F_Generate_Signature).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False)))
      or Valid (Ctx, F_Slot_ID_Param));

   function Incomplete_Message (Ctx : Context) return Boolean is
     ((for some F in Field =>
          Incomplete (Ctx, F)));

   function Get_Reserved_1 (Ctx : Context) return RFLX.SPDM.Reserved_7 is
     (To_Actual (Ctx.Cursors (F_Reserved_1).Value));

   function Get_Generate_Signature (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_Generate_Signature).Value));

   function Get_Measurement_Operation (Ctx : Context) return RFLX.SPDM.Index is
     (To_Actual (Ctx.Cursors (F_Measurement_Operation).Value));

   function Get_Reserved_2 (Ctx : Context) return RFLX.SPDM.Reserved_4 is
     (To_Actual (Ctx.Cursors (F_Reserved_2).Value));

   function Get_Slot_ID_Param (Ctx : Context) return RFLX.SPDM.Narrow_Slot is
     (To_Actual (Ctx.Cursors (F_Slot_ID_Param).Value));

   function Valid_Size (Ctx : Context; Fld : Field; Size : RFLX_Types.Bit_Length) return Boolean is
     (Size = Field_Size (Ctx, Fld))
    with
     Pre =>
       RFLX.SPDM.Get_Measurements_Request.Valid_Next (Ctx, Fld);

   function Valid_Length (Ctx : Context; Fld : Field; Length : RFLX_Types.Length) return Boolean is
     (Valid_Size (Ctx, Fld, RFLX_Types.To_Bit_Length (Length)));

   function Context_Cursor (Ctx : Context; Fld : Field) return Field_Cursor is
     (Ctx.Cursors (Fld));

   function Context_Cursors (Ctx : Context) return Field_Cursors is
     (Ctx.Cursors);

   function Context_Cursors_Index (Cursors : Field_Cursors; Fld : Field) return Field_Cursor is
     (Cursors (Fld));

end RFLX.SPDM.Get_Measurements_Request;
