                                                                       and then Cursors (F_Reserved_2).First = Cursors (F_CT_Exponent).Last + 1
                                                                       and then (if
                                                                                    Structural_Valid (Cursors (F_MAC_Cap))
                                                                                 then
                                                                                    Cursors (F_MAC_Cap).Last - Cursors (F_MAC_Cap).First + 1 = 1
                                                                                    and then Cursors (F_MAC_Cap).Predecessor = F_Reserved_2
                                                                                    and then Cursors (F_MAC_Cap).First = Cursors (F_Reserved_2).Last + 1
                                                                                    and then (if
                                                                                                 Structural_Valid (Cursors (F_Encrypt_Cap))
                                                                                              then
                                                                                                 Cursors (F_Encrypt_Cap).Last - Cursors (F_Encrypt_Cap).First + 1 = 1
                                                                                                 and then Cursors (F_Encrypt_Cap).Predecessor = F_MAC_Cap
