                                                                                                                           and then Cursors (F_Meas_Cap).Predecessor = F_Meas_Fresh_Cap
                                                                                                                           and then Cursors (F_Meas_Cap).First = Cursors (F_Meas_Fresh_Cap).Last + 1
                                                                                                                           and then (if
