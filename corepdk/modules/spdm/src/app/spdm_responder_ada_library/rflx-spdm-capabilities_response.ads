                                                                                                                                                                               and then Cursors (F_Handshake_In_The_Clear_Cap).Predecessor = F_Cache_Cap
                                                                                                                                                                               and then Cursors (F_Handshake_In_The_Clear_Cap).First = Cursors (F_Cache_Cap).Last + 1
                                                                                                                                                                               and then (if
                                                                                                                                                                                            Structural_Valid (Cursors (F_Key_Upd_Cap))
                                                                                                                                                                                         then
                                                                                                                                                                                            Cursors (F_Key_Upd_Cap).Last - Cursors (F_Key_Upd_Cap).First + 1 = 1
                                                                                                                                                                                            and then Cursors (F_Key_Upd_Cap).Predecessor = F_Handshake_In_The_Clear_Cap
                                                                                                                                                                                            and then Cursors (F_Key_Upd_Cap).First = Cursors (F_Handshake_In_The_Clear_Cap).Last + 1
                                                                                                                                                                                            and then (if
                                                                                                                                                                                                         Structural_Valid (Cursors (F_Hbeat_Cap))
                                                                                                                                                                                                      then
                                                                                                                                                                                                         Cursors (F_Hbeat_Cap).Last - Cursors (F_Hbeat_Cap).First + 1 = 1
                                                                                                                                                                                                         and then Cursors (F_Hbeat_Cap).Predecessor = F_Key_Upd_Cap
                                                                                                                                                                                                         and then Cursors (F_Hbeat_Cap).First = Cursors (F_Key_Upd_Cap).Last + 1
                                                                                                                                                                                                         and then (if
                                                                                                                                                                                                                      Structural_Valid (Cursors (F_Encap_Cap))
                                                                                                                                                                                                                   then
                                                                                                                                                                                                                      Cursors (F_Encap_Cap).Last - Cursors (F_Encap_Cap).First + 1 = 1
                                                                                                                                                                                                                      and then Cursors (F_Encap_Cap).Predecessor = F_Hbeat_Cap
                                                                                                                                                                                                                      and then Cursors (F_Encap_Cap).First = Cursors (F_Hbeat_Cap).Last + 1
                                                                                                                                                                                                                      and then (if
                                                                                                                                                                                                                                   Structural_Valid (Cursors (F_PSK_Cap))
                                                                                                                                                                                                                                then
                                                                                                                                                                                                                                   Cursors (F_PSK_Cap).Last - Cursors (F_PSK_Cap).First + 1 = 2
                                                                                                                                                                                                                                   and then Cursors (F_PSK_Cap).Predecessor = F_Encap_Cap
                                                                                                                                                                                                                                   and then Cursors (F_PSK_Cap).First = Cursors (F_Encap_Cap).Last + 1
                                                                                                                                                                                                                                   and then (if
                                                                                                                                                                                                                                                Structural_Valid (Cursors (F_Key_Ex_Cap))
                                                                                                                                                                                                                                             then
                                                                                                                                                                                                                                                Cursors (F_Key_Ex_Cap).Last - Cursors (F_Key_Ex_Cap).First + 1 = 1
                                                                                                                                                                                                                                                and then Cursors (F_Key_Ex_Cap).Predecessor = F_PSK_Cap
                                                                                                                                                                                                                                                and then Cursors (F_Key_Ex_Cap).First = Cursors (F_PSK_Cap).Last + 1
                                                                                                                                                                                                                                                and then (if
                                                                                                                                                                                                                                                             Structural_Valid (Cursors (F_Mut_Auth_Cap))
                                                                                                                                                                                                                                                          then
                                                                                                                                                                                                                                                             Cursors (F_Mut_Auth_Cap).Last - Cursors (F_Mut_Auth_Cap).First + 1 = 1
                                                                                                                                                                                                                                                             and then Cursors (F_Mut_Auth_Cap).Predecessor = F_Key_Ex_Cap
                                                                                                                                                                                                                                                             and then Cursors (F_Mut_Auth_Cap).First = Cursors (F_Key_Ex_Cap).Last + 1
                                                                                                                                                                                                                                                             and then (if
                                                                                                                                                                                                                                                                          Structural_Valid (Cursors (F_Reserved_4))
                                                                                                                                                                                                                                                                       then
                                                                                                                                                                                                                                                                          Cursors (F_Reserved_4).Last - Cursors (F_Reserved_4).First + 1 = 15
                                                                                                                                                                                                                                                                          and then Cursors (F_Reserved_4).Predecessor = F_Mut_Auth_Cap
                                                                                                                                                                                                                                                                          and then Cursors (F_Reserved_4).First = Cursors (F_Mut_Auth_Cap).Last + 1
                                                                                                                                                                                                                                                                          and then (if
                                                                                                                                                                                                                                                                                       Structural_Valid (Cursors (F_Pub_Key_ID_Cap))
                                                                                                                                                                                                                                                                                    then
                                                                                                                                                                                                                                                                                       Cursors (F_Pub_Key_ID_Cap).Last - Cursors (F_Pub_Key_ID_Cap).First + 1 = 1
                                                                                                                                                                                                                                                                                       and then Cursors (F_Pub_Key_ID_Cap).Predecessor = F_Reserved_4
                                                                                                                                                                                                                                                                                       and then Cursors (F_Pub_Key_ID_Cap).First = Cursors (F_Reserved_4).Last + 1))))))))))))))))))))));

   pragma Warnings (On, """Buffer"" is not modified, could be of access constant type");

   pragma Warnings (On, "postcondition does not mention function result");

   type Context (Buffer_First, Buffer_Last : RFLX_Types.Index := RFLX_Types.Index'First; First : RFLX_Types.Bit_Index := RFLX_Types.Bit_Index'First; Last : RFLX_Types.Bit_Length := RFLX_Types.Bit_Length'First) is
      record
         Verified_Last : RFLX_Types.Bit_Length := First - 1;
         Written_Last : RFLX_Types.Bit_Length := First - 1;
         Buffer : RFLX_Types.Bytes_Ptr := null;
         Cursors : Field_Cursors := [others => (State => S_Invalid, Predecessor => F_Final)];
      end record with
     Dynamic_Predicate =>
       Valid_Context (Context.Buffer_First, Context.Buffer_Last, Context.First, Context.Last, Context.Verified_Last, Context.Written_Last, Context.Buffer, Context.Cursors);

   function Initialized (Ctx : Context) return Boolean is
     (Ctx.Verified_Last = Ctx.First - 1
      and then Valid_Next (Ctx, F_Param_1)
      and then RFLX.SPDM.Capabilities_Response.Field_First (Ctx, RFLX.SPDM.Capabilities_Response.F_Param_1) rem RFLX_Types.Byte'Size = 1
      and then Available_Space (Ctx, F_Param_1) = Ctx.Last - Ctx.First + 1
      and then (for all F in Field =>
                   Invalid (Ctx, F)));

   function Has_Buffer (Ctx : Context) return Boolean is
     (Ctx.Buffer /= null);

   function Buffer_Length (Ctx : Context) return RFLX_Types.Length is
     (Ctx.Buffer'Length);

   function Size (Ctx : Context) return RFLX_Types.Bit_Length is
     (Ctx.Verified_Last - Ctx.First + 1);

   function Byte_Size (Ctx : Context) return RFLX_Types.Length is
     (RFLX_Types.To_Length (Size (Ctx)));

   function Message_Last (Ctx : Context) return RFLX_Types.Bit_Length is
     (Ctx.Verified_Last);

   function Written_Last (Ctx : Context) return RFLX_Types.Bit_Length is
     (Ctx.Written_Last);

   function Valid_Value (Fld : Field; Val : RFLX_Types.Base_Integer) return Boolean is
     ((case Fld is
          when F_Param_1 | F_Param_2 | F_Reserved_1 =>
             RFLX.SPDM.Valid_Reserved_8 (Val),
          when F_CT_Exponent =>
             RFLX.SPDM.Valid_CT_Exponent (Val),
          when F_Reserved_2 =>
             RFLX.SPDM.Valid_Reserved_16 (Val),
          when F_MAC_Cap | F_Encrypt_Cap | F_Meas_Fresh_Cap =>
             Valid_Boolean (Val),
          when F_Meas_Cap =>
             RFLX.SPDM.Valid_Meas_Cap (Val),
          when F_Chal_Cap | F_Cert_Cap | F_Cache_Cap | F_Handshake_In_The_Clear_Cap | F_Key_Upd_Cap | F_Hbeat_Cap | F_Encap_Cap =>
             Valid_Boolean (Val),
          when F_PSK_Cap =>
             RFLX.SPDM.Valid_PSK_Resp_Cap (Val),
          when F_Key_Ex_Cap | F_Mut_Auth_Cap =>
             Valid_Boolean (Val),
          when F_Reserved_4 =>
             RFLX.SPDM.Valid_Reserved_15 (Val),
          when F_Pub_Key_ID_Cap =>
             Valid_Boolean (Val)));

   function Path_Condition (Ctx : Context; Fld : Field) return Boolean is
     ((case Ctx.Cursors (Fld).Predecessor is
          when F_Initial | F_Param_1 | F_Param_2 | F_Reserved_1 | F_CT_Exponent | F_Reserved_2 | F_MAC_Cap | F_Encrypt_Cap | F_Meas_Fresh_Cap | F_Meas_Cap | F_Chal_Cap | F_Cert_Cap | F_Cache_Cap | F_Handshake_In_The_Clear_Cap | F_Key_Upd_Cap | F_Hbeat_Cap | F_Encap_Cap | F_PSK_Cap | F_Key_Ex_Cap | F_Mut_Auth_Cap | F_Reserved_4 | F_Pub_Key_ID_Cap | F_Final =>
             True));

   function Field_Condition (Ctx : Context; Fld : Field; Val : RFLX_Types.Base_Integer) return Boolean is
     ((case Fld is
          when F_Param_1 | F_Param_2 | F_Reserved_1 | F_CT_Exponent | F_Reserved_2 | F_MAC_Cap | F_Encrypt_Cap | F_Meas_Fresh_Cap | F_Meas_Cap | F_Chal_Cap | F_Cert_Cap | F_Cache_Cap | F_Handshake_In_The_Clear_Cap | F_Key_Upd_Cap | F_Hbeat_Cap | F_Encap_Cap | F_PSK_Cap | F_Key_Ex_Cap | F_Mut_Auth_Cap | F_Reserved_4 =>
             True,
          when F_Pub_Key_ID_Cap =>
             (Val = RFLX_Types.Base_Integer (To_Base_Integer (False))
              or RFLX_Types.Base_Integer (Ctx.Cursors (F_Cert_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False)))
             and ((RFLX_Types.Base_Integer (Ctx.Cursors (F_Encrypt_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))
                   and RFLX_Types.Base_Integer (Ctx.Cursors (F_MAC_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
                  or RFLX_Types.Base_Integer (Ctx.Cursors (F_Handshake_In_The_Clear_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False)))
             and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Handshake_In_The_Clear_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
                  or RFLX_Types.Base_Integer (Ctx.Cursors (F_Key_Ex_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
             and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Mut_Auth_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
                  or RFLX_Types.Base_Integer (Ctx.Cursors (F_Encap_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
             and (RFLX_Types.Base_Integer (Ctx.Cursors (F_PSK_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.PSK_Resp_Unsupported))
                  or RFLX_Types.Base_Integer (Ctx.Cursors (F_Encrypt_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))
                  or RFLX_Types.Base_Integer (Ctx.Cursors (F_MAC_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
             and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Key_Ex_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
                  or RFLX_Types.Base_Integer (Ctx.Cursors (F_Encrypt_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))
                  or RFLX_Types.Base_Integer (Ctx.Cursors (F_MAC_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
             and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Key_Ex_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))
                  or RFLX_Types.Base_Integer (Ctx.Cursors (F_Encrypt_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
                  or RFLX_Types.Base_Integer (Ctx.Cursors (F_PSK_Cap).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.PSK_Resp_Unsupported)))
             and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Key_Ex_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))
                  or RFLX_Types.Base_Integer (Ctx.Cursors (F_MAC_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
                  or RFLX_Types.Base_Integer (Ctx.Cursors (F_PSK_Cap).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.PSK_Resp_Unsupported)))));

   function Field_Size (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Length is
     ((case Fld is
          when F_Param_1 | F_Param_2 | F_Reserved_1 | F_CT_Exponent =>
             8,
          when F_Reserved_2 =>
             16,
          when F_MAC_Cap | F_Encrypt_Cap | F_Meas_Fresh_Cap =>
             1,
          when F_Meas_Cap =>
             2,
          when F_Chal_Cap | F_Cert_Cap | F_Cache_Cap | F_Handshake_In_The_Clear_Cap | F_Key_Upd_Cap | F_Hbeat_Cap | F_Encap_Cap =>
             1,
          when F_PSK_Cap =>
             2,
          when F_Key_Ex_Cap | F_Mut_Auth_Cap =>
             1,
          when F_Reserved_4 =>
             15,
          when F_Pub_Key_ID_Cap =>
             1));

   function Field_First (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Index is
     ((if Fld = F_Param_1 then Ctx.First else Ctx.Cursors (Ctx.Cursors (Fld).Predecessor).Last + 1));

   function Field_Last (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Length is
     (Field_First (Ctx, Fld) + Field_Size (Ctx, Fld) - 1);

   function Predecessor (Ctx : Context; Fld : Virtual_Field) return Virtual_Field is
     ((case Fld is
          when F_Initial =>
             F_Initial,
          when others =>
             Ctx.Cursors (Fld).Predecessor));

   function Valid_Predecessor (Ctx : Context; Fld : Virtual_Field) return Boolean is
     ((case Fld is
          when F_Initial =>
             True,
          when F_Param_1 =>
             Ctx.Cursors (Fld).Predecessor = F_Initial,
          when F_Param_2 =>
             (Valid (Ctx.Cursors (F_Param_1))
              and Ctx.Cursors (Fld).Predecessor = F_Param_1),
          when F_Reserved_1 =>
             (Valid (Ctx.Cursors (F_Param_2))
              and Ctx.Cursors (Fld).Predecessor = F_Param_2),
          when F_CT_Exponent =>
             (Valid (Ctx.Cursors (F_Reserved_1))
              and Ctx.Cursors (Fld).Predecessor = F_Reserved_1),
          when F_Reserved_2 =>
             (Valid (Ctx.Cursors (F_CT_Exponent))
              and Ctx.Cursors (Fld).Predecessor = F_CT_Exponent),
          when F_MAC_Cap =>
             (Valid (Ctx.Cursors (F_Reserved_2))
              and Ctx.Cursors (Fld).Predecessor = F_Reserved_2),
          when F_Encrypt_Cap =>
             (Valid (Ctx.Cursors (F_MAC_Cap))
              and Ctx.Cursors (Fld).Predecessor = F_MAC_Cap),
          when F_Meas_Fresh_Cap =>
             (Valid (Ctx.Cursors (F_Encrypt_Cap))
              and Ctx.Cursors (Fld).Predecessor = F_Encrypt_Cap),
          when F_Meas_Cap =>
             (Valid (Ctx.Cursors (F_Meas_Fresh_Cap))
              and Ctx.Cursors (Fld).Predecessor = F_Meas_Fresh_Cap),
          when F_Chal_Cap =>
             (Valid (Ctx.Cursors (F_Meas_Cap))
              and Ctx.Cursors (Fld).Predecessor = F_Meas_Cap),
          when F_Cert_Cap =>
             (Valid (Ctx.Cursors (F_Chal_Cap))
              and Ctx.Cursors (Fld).Predecessor = F_Chal_Cap),
          when F_Cache_Cap =>
             (Valid (Ctx.Cursors (F_Cert_Cap))
              and Ctx.Cursors (Fld).Predecessor = F_Cert_Cap),
          when F_Handshake_In_The_Clear_Cap =>
             (Valid (Ctx.Cursors (F_Cache_Cap))
              and Ctx.Cursors (Fld).Predecessor = F_Cache_Cap),
          when F_Key_Upd_Cap =>
             (Valid (Ctx.Cursors (F_Handshake_In_The_Clear_Cap))
              and Ctx.Cursors (Fld).Predecessor = F_Handshake_In_The_Clear_Cap),
          when F_Hbeat_Cap =>
             (Valid (Ctx.Cursors (F_Key_Upd_Cap))
              and Ctx.Cursors (Fld).Predecessor = F_Key_Upd_Cap),
          when F_Encap_Cap =>
             (Valid (Ctx.Cursors (F_Hbeat_Cap))
              and Ctx.Cursors (Fld).Predecessor = F_Hbeat_Cap),
          when F_PSK_Cap =>
             (Valid (Ctx.Cursors (F_Encap_Cap))
              and Ctx.Cursors (Fld).Predecessor = F_Encap_Cap),
          when F_Key_Ex_Cap =>
             (Valid (Ctx.Cursors (F_PSK_Cap))
              and Ctx.Cursors (Fld).Predecessor = F_PSK_Cap),
          when F_Mut_Auth_Cap =>
             (Valid (Ctx.Cursors (F_Key_Ex_Cap))
              and Ctx.Cursors (Fld).Predecessor = F_Key_Ex_Cap),
          when F_Reserved_4 =>
             (Valid (Ctx.Cursors (F_Mut_Auth_Cap))
              and Ctx.Cursors (Fld).Predecessor = F_Mut_Auth_Cap),
          when F_Pub_Key_ID_Cap =>
             (Valid (Ctx.Cursors (F_Reserved_4))
              and Ctx.Cursors (Fld).Predecessor = F_Reserved_4),
          when F_Final =>
             (Valid (Ctx.Cursors (F_Pub_Key_ID_Cap))
              and Ctx.Cursors (Fld).Predecessor = F_Pub_Key_ID_Cap)));

   function Valid_Next (Ctx : Context; Fld : Field) return Boolean is
     (Valid_Predecessor (Ctx, Fld)
      and then Path_Condition (Ctx, Fld));

   function Available_Space (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Length is
     (Ctx.Last - Field_First (Ctx, Fld) + 1);

   function Sufficient_Space (Ctx : Context; Fld : Field) return Boolean is
     (Available_Space (Ctx, Fld) >= Field_Size (Ctx, Fld));

   function Present (Ctx : Context; Fld : Field) return Boolean is
     (Structural_Valid (Ctx.Cursors (Fld))
      and then Ctx.Cursors (Fld).First < Ctx.Cursors (Fld).Last + 1);

   function Structural_Valid (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Valid
      or Ctx.Cursors (Fld).State = S_Structural_Valid);

   function Valid (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Valid
      and then Ctx.Cursors (Fld).First < Ctx.Cursors (Fld).Last + 1);

   function Incomplete (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Incomplete);

   function Invalid (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Invalid
      or Ctx.Cursors (Fld).State = S_Incomplete);

   function Structural_Valid_Message (Ctx : Context) return Boolean is
     (Valid (Ctx, F_Pub_Key_ID_Cap)
      and then ((RFLX_Types.Base_Integer (Ctx.Cursors (F_Pub_Key_ID_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
                 or RFLX_Types.Base_Integer (Ctx.Cursors (F_Cert_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False)))
                and ((RFLX_Types.Base_Integer (Ctx.Cursors (F_Encrypt_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))
                      and RFLX_Types.Base_Integer (Ctx.Cursors (F_MAC_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
                     or RFLX_Types.Base_Integer (Ctx.Cursors (F_Handshake_In_The_Clear_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False)))
                and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Handshake_In_The_Clear_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
                     or RFLX_Types.Base_Integer (Ctx.Cursors (F_Key_Ex_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
                and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Mut_Auth_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
                     or RFLX_Types.Base_Integer (Ctx.Cursors (F_Encap_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
                and (RFLX_Types.Base_Integer (Ctx.Cursors (F_PSK_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.PSK_Resp_Unsupported))
                     or RFLX_Types.Base_Integer (Ctx.Cursors (F_Encrypt_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))
                     or RFLX_Types.Base_Integer (Ctx.Cursors (F_MAC_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
                and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Key_Ex_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
                     or RFLX_Types.Base_Integer (Ctx.Cursors (F_Encrypt_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))
                     or RFLX_Types.Base_Integer (Ctx.Cursors (F_MAC_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
                and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Key_Ex_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))
                     or RFLX_Types.Base_Integer (Ctx.Cursors (F_Encrypt_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
                     or RFLX_Types.Base_Integer (Ctx.Cursors (F_PSK_Cap).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.PSK_Resp_Unsupported)))
                and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Key_Ex_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))
