private

   type Cursor_State is (S_Valid, S_Structural_Valid, S_Invalid, S_Incomplete);

   type Field_Cursor (State : Cursor_State := S_Invalid) is
      record
         Predecessor : Virtual_Field := F_Final;
         case State is
            when S_Valid | S_Structural_Valid =>
               First : RFLX_Types.Bit_Index := RFLX_Types.Bit_Index'First;
               Last : RFLX_Types.Bit_Length := RFLX_Types.Bit_Length'First;
               Value : RFLX_Types.Base_Integer := 0;
            when S_Invalid | S_Incomplete =>
               null;
         end case;
      end record;

   type Field_Cursors is array (Virtual_Field) of Field_Cursor;

   function Structural_Valid (Cursor : Field_Cursor) return Boolean is
     (Cursor.State = S_Valid
      or Cursor.State = S_Structural_Valid);

   function Valid (Cursor : Field_Cursor) return Boolean is
     (Cursor.State = S_Valid);

   function Invalid (Cursor : Field_Cursor) return Boolean is
     (Cursor.State = S_Invalid
      or Cursor.State = S_Incomplete);

   pragma Warnings (Off, """Buffer"" is not modified, could be of access constant type");

   pragma Warnings (Off, "postcondition does not mention function result");

   function Valid_Context (Buffer_First, Buffer_Last : RFLX_Types.Index; First : RFLX_Types.Bit_Index; Last : RFLX_Types.Bit_Length; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length; Buffer : RFLX_Types.Bytes_Ptr; Cursors : Field_Cursors) return Boolean is
     ((if Buffer /= null then Buffer'First = Buffer_First and Buffer'Last = Buffer_Last)
      and then (RFLX_Types.To_Index (First) >= Buffer_First
                and RFLX_Types.To_Index (Last) <= Buffer_Last
                and Buffer_Last < RFLX_Types.Index'Last
                and First <= Last + 1
                and Last < RFLX_Types.Bit_Index'Last
                and First rem RFLX_Types.Byte'Size = 1
                and Last rem RFLX_Types.Byte'Size = 0)
      and then First - 1 <= Verified_Last
      and then First - 1 <= Written_Last
      and then Verified_Last <= Written_Last
      and then Written_Last <= Last
      and then First rem RFLX_Types.Byte'Size = 1
      and then Last rem RFLX_Types.Byte'Size = 0
      and then Verified_Last rem RFLX_Types.Byte'Size = 0
      and then Written_Last rem RFLX_Types.Byte'Size = 0
      and then (for all F in Field =>
                   (if
                       Structural_Valid (Cursors (F))
                    then
                       Cursors (F).First >= First
                       and Cursors (F).Last <= Verified_Last
                       and Cursors (F).First <= Cursors (F).Last + 1
                       and Valid_Value (F, Cursors (F).Value)))
      and then ((if
                    Structural_Valid (Cursors (F_Param_2))
                 then
                    (Valid (Cursors (F_Param_1))
                     and then Cursors (F_Param_2).Predecessor = F_Param_1))
                and then (if
                             Structural_Valid (Cursors (F_Reserved_1))
                          then
                             (Valid (Cursors (F_Param_2))
                              and then Cursors (F_Reserved_1).Predecessor = F_Param_2))
                and then (if
                             Structural_Valid (Cursors (F_CT_Exponent))
                          then
                             (Valid (Cursors (F_Reserved_1))
                              and then Cursors (F_CT_Exponent).Predecessor = F_Reserved_1))
                and then (if
                             Structural_Valid (Cursors (F_Reserved_2))
                          then
                             (Valid (Cursors (F_CT_Exponent))
                              and then Cursors (F_Reserved_2).Predecessor = F_CT_Exponent))
                and then (if
                             Structural_Valid (Cursors (F_MAC_Cap))
                          then
                             (Valid (Cursors (F_Reserved_2))
                              and then Cursors (F_MAC_Cap).Predecessor = F_Reserved_2))
                and then (if
                             Structural_Valid (Cursors (F_Encrypt_Cap))
                          then
                             (Valid (Cursors (F_MAC_Cap))
                              and then Cursors (F_Encrypt_Cap).Predecessor = F_MAC_Cap))
                and then (if
                             Structural_Valid (Cursors (F_Meas_Fresh_Cap))
                          then
                             (Valid (Cursors (F_Encrypt_Cap))
                              and then Cursors (F_Meas_Fresh_Cap).Predecessor = F_Encrypt_Cap))
                and then (if
                             Structural_Valid (Cursors (F_Meas_Cap))
                          then
                             (Valid (Cursors (F_Meas_Fresh_Cap))
                              and then Cursors (F_Meas_Cap).Predecessor = F_Meas_Fresh_Cap))
                and then (if
                             Structural_Valid (Cursors (F_Chal_Cap))
                          then
                             (Valid (Cursors (F_Meas_Cap))
                              and then Cursors (F_Chal_Cap).Predecessor = F_Meas_Cap))
                and then (if
                             Structural_Valid (Cursors (F_Cert_Cap))
                          then
                             (Valid (Cursors (F_Chal_Cap))
                              and then Cursors (F_Cert_Cap).Predecessor = F_Chal_Cap))
                and then (if
                             Structural_Valid (Cursors (F_Cache_Cap))
                          then
                             (Valid (Cursors (F_Cert_Cap))
                              and then Cursors (F_Cache_Cap).Predecessor = F_Cert_Cap))
                and then (if
                             Structural_Valid (Cursors (F_Handshake_In_The_Clear_Cap))
                          then
                             (Valid (Cursors (F_Cache_Cap))
                              and then Cursors (F_Handshake_In_The_Clear_Cap).Predecessor = F_Cache_Cap))
                and then (if
                             Structural_Valid (Cursors (F_Key_Upd_Cap))
                          then
                             (Valid (Cursors (F_Handshake_In_The_Clear_Cap))
                              and then Cursors (F_Key_Upd_Cap).Predecessor = F_Handshake_In_The_Clear_Cap))
                and then (if
                             Structural_Valid (Cursors (F_Hbeat_Cap))
                          then
                             (Valid (Cursors (F_Key_Upd_Cap))
                              and then Cursors (F_Hbeat_Cap).Predecessor = F_Key_Upd_Cap))
                and then (if
                             Structural_Valid (Cursors (F_Encap_Cap))
                          then
                             (Valid (Cursors (F_Hbeat_Cap))
                              and then Cursors (F_Encap_Cap).Predecessor = F_Hbeat_Cap))
                and then (if
                             Structural_Valid (Cursors (F_PSK_Cap))
                          then
                             (Valid (Cursors (F_Encap_Cap))
                              and then Cursors (F_PSK_Cap).Predecessor = F_Encap_Cap))
                and then (if
                             Structural_Valid (Cursors (F_Key_Ex_Cap))
                          then
                             (Valid (Cursors (F_PSK_Cap))
                              and then Cursors (F_Key_Ex_Cap).Predecessor = F_PSK_Cap))
                and then (if
                             Structural_Valid (Cursors (F_Mut_Auth_Cap))
                          then
                             (Valid (Cursors (F_Key_Ex_Cap))
                              and then Cursors (F_Mut_Auth_Cap).Predecessor = F_Key_Ex_Cap))
                and then (if
                             Structural_Valid (Cursors (F_Reserved_4))
                          then
                             (Valid (Cursors (F_Mut_Auth_Cap))
                              and then Cursors (F_Reserved_4).Predecessor = F_Mut_Auth_Cap))
                and then (if
                             Structural_Valid (Cursors (F_Pub_Key_ID_Cap))
                          then
                             (Valid (Cursors (F_Reserved_4))
                              and then Cursors (F_Pub_Key_ID_Cap).Predecessor = F_Reserved_4)))
      and then ((if Invalid (Cursors (F_Param_1)) then Invalid (Cursors (F_Param_2)))
                and then (if Invalid (Cursors (F_Param_2)) then Invalid (Cursors (F_Reserved_1)))
                and then (if Invalid (Cursors (F_Reserved_1)) then Invalid (Cursors (F_CT_Exponent)))
                and then (if Invalid (Cursors (F_CT_Exponent)) then Invalid (Cursors (F_Reserved_2)))
                and then (if Invalid (Cursors (F_Reserved_2)) then Invalid (Cursors (F_MAC_Cap)))
                and then (if Invalid (Cursors (F_MAC_Cap)) then Invalid (Cursors (F_Encrypt_Cap)))
                and then (if Invalid (Cursors (F_Encrypt_Cap)) then Invalid (Cursors (F_Meas_Fresh_Cap)))
                and then (if Invalid (Cursors (F_Meas_Fresh_Cap)) then Invalid (Cursors (F_Meas_Cap)))
                and then (if Invalid (Cursors (F_Meas_Cap)) then Invalid (Cursors (F_Chal_Cap)))
                and then (if Invalid (Cursors (F_Chal_Cap)) then Invalid (Cursors (F_Cert_Cap)))
                and then (if Invalid (Cursors (F_Cert_Cap)) then Invalid (Cursors (F_Cache_Cap)))
                and then (if Invalid (Cursors (F_Cache_Cap)) then Invalid (Cursors (F_Handshake_In_The_Clear_Cap)))
                and then (if Invalid (Cursors (F_Handshake_In_The_Clear_Cap)) then Invalid (Cursors (F_Key_Upd_Cap)))
                and then (if Invalid (Cursors (F_Key_Upd_Cap)) then Invalid (Cursors (F_Hbeat_Cap)))
                and then (if Invalid (Cursors (F_Hbeat_Cap)) then Invalid (Cursors (F_Encap_Cap)))
                and then (if Invalid (Cursors (F_Encap_Cap)) then Invalid (Cursors (F_PSK_Cap)))
                and then (if Invalid (Cursors (F_PSK_Cap)) then Invalid (Cursors (F_Key_Ex_Cap)))
                and then (if Invalid (Cursors (F_Key_Ex_Cap)) then Invalid (Cursors (F_Mut_Auth_Cap)))
                and then (if Invalid (Cursors (F_Mut_Auth_Cap)) then Invalid (Cursors (F_Reserved_4)))
                and then (if Invalid (Cursors (F_Reserved_4)) then Invalid (Cursors (F_Pub_Key_ID_Cap))))
      and then (if
                   Structural_Valid (Cursors (F_Param_1))
                then
