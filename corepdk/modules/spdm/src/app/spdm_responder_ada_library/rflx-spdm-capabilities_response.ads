   function Valid_Structure (Struct : Structure) return Boolean is
     (((To_Base_Integer (Struct.Pub_Key_ID_Cap) = RFLX_Types.Base_Integer (To_Base_Integer (False))
        or To_Base_Integer (Struct.Cert_Cap) = RFLX_Types.Base_Integer (To_Base_Integer (False)))
       and ((To_Base_Integer (Struct.Encrypt_Cap) = RFLX_Types.Base_Integer (To_Base_Integer (True))
             and To_Base_Integer (Struct.MAC_Cap) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
            or To_Base_Integer (Struct.Handshake_In_The_Clear_Cap) = RFLX_Types.Base_Integer (To_Base_Integer (False)))
       and (To_Base_Integer (Struct.Handshake_In_The_Clear_Cap) = RFLX_Types.Base_Integer (To_Base_Integer (False))
            or To_Base_Integer (Struct.Key_Ex_Cap) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
       and (To_Base_Integer (Struct.Mut_Auth_Cap) = RFLX_Types.Base_Integer (To_Base_Integer (False))
            or To_Base_Integer (Struct.Encap_Cap) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
       and (To_Base_Integer (Struct.PSK_Cap) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.PSK_Resp_Unsupported))
            or To_Base_Integer (Struct.Encrypt_Cap) = RFLX_Types.Base_Integer (To_Base_Integer (True))
            or To_Base_Integer (Struct.MAC_Cap) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
       and (To_Base_Integer (Struct.Key_Ex_Cap) = RFLX_Types.Base_Integer (To_Base_Integer (False))
            or To_Base_Integer (Struct.Encrypt_Cap) = RFLX_Types.Base_Integer (To_Base_Integer (True))
            or To_Base_Integer (Struct.MAC_Cap) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
       and (To_Base_Integer (Struct.Key_Ex_Cap) = RFLX_Types.Base_Integer (To_Base_Integer (True))
            or To_Base_Integer (Struct.Encrypt_Cap) = RFLX_Types.Base_Integer (To_Base_Integer (False))
            or To_Base_Integer (Struct.PSK_Cap) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.PSK_Resp_Unsupported)))
       and (To_Base_Integer (Struct.Key_Ex_Cap) = RFLX_Types.Base_Integer (To_Base_Integer (True))
            or To_Base_Integer (Struct.MAC_Cap) = RFLX_Types.Base_Integer (To_Base_Integer (False))
