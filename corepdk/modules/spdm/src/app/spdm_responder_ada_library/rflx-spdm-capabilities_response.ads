                 or RFLX_Types.Base_Integer (Ctx.Cursors (F_Cert_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False)))
                and ((RFLX_Types.Base_Integer (Ctx.Cursors (F_Encrypt_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))
                      and RFLX_Types.Base_Integer (Ctx.Cursors (F_MAC_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
                     or RFLX_Types.Base_Integer (Ctx.Cursors (F_Handshake_In_The_Clear_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False)))
                and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Handshake_In_The_Clear_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
                     or RFLX_Types.Base_Integer (Ctx.Cursors (F_Key_Ex_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
                and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Mut_Auth_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
                     or RFLX_Types.Base_Integer (Ctx.Cursors (F_Encap_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
                and (RFLX_Types.Base_Integer (Ctx.Cursors (F_PSK_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.PSK_Resp_Unsupported))
                     or RFLX_Types.Base_Integer (Ctx.Cursors (F_Encrypt_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))
                     or RFLX_Types.Base_Integer (Ctx.Cursors (F_MAC_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
                and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Key_Ex_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
                     or RFLX_Types.Base_Integer (Ctx.Cursors (F_Encrypt_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))
                     or RFLX_Types.Base_Integer (Ctx.Cursors (F_MAC_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
                and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Key_Ex_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))
                     or RFLX_Types.Base_Integer (Ctx.Cursors (F_Encrypt_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
                     or RFLX_Types.Base_Integer (Ctx.Cursors (F_PSK_Cap).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.PSK_Resp_Unsupported)))
                and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Key_Ex_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))
                     or RFLX_Types.Base_Integer (Ctx.Cursors (F_MAC_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
                     or RFLX_Types.Base_Integer (Ctx.Cursors (F_PSK_Cap).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.PSK_Resp_Unsupported)))));

