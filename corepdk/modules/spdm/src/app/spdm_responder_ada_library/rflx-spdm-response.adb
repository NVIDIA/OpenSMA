                            8,
                         when F_Measurements_Response_Slot_ID =>
                            4,
                         when F_Version_Response_Reserved | F_Algorithms_Response_Measurement_Specification_Sel | F_Capabilities_Response_CT_Exponent =>
                            8,
                         when F_Certificate_Response_Remainder_Length =>
                            16,
                         when F_Digests_Response_Slot_Mask_Slot_5_Present =>
                            1,
                         when F_Error_Response_Vendor_ID_Double =>
                            16,
                         when F_Error_Response_Vendor_ID_Quad =>
                            32,
                         when F_Error_Response_Response_Not_Ready_Data_Request_Code | F_Measurements_Response_Number_Of_Blocks | F_Version_Response_Version_Number_Entry_Count | F_Algorithms_Response_Reserved_1 =>
                            8,
                         when F_Capabilities_Response_Reserved_2 =>
                            16,
                         when F_Certificate_Response_Cert_Chain =>
                            RFLX_Types.Bit_Length (Ctx.Cursors (F_Certificate_Response_Portion_Length).Value) * 8,
                         when F_Digests_Response_Slot_Mask_Slot_4_Present =>
                            1,
                         when F_Error_Response_Opaque_Error_Data =>
                            (if
                                Ctx.Cursors (Fld).Predecessor = F_Error_Response_Vendor_ID_Double
                             then
                                RFLX_Types.Bit_Length (Ctx.Written_Last) - RFLX_Types.Bit_Length (Ctx.Cursors (F_Error_Response_Vendor_ID_Double).Last)
                             elsif
                                Ctx.Cursors (Fld).Predecessor = F_Error_Response_Vendor_ID_Len
                                and then (Ctx.Cursors (F_Error_Response_Vendor_ID_Len).Value = 0
                                          and RFLX_Types.Bit_Length (Ctx.Cursors (F_Error_Response_Registry_ID).Value) = RFLX_Types.Bit_Length (To_Base_Integer (RFLX.SPDM.Reg_DMTF)))
                             then
                                RFLX_Types.Bit_Length (Ctx.Written_Last) - RFLX_Types.Bit_Length (Ctx.Cursors (F_Error_Response_Vendor_ID_Len).Last)
                             elsif
                                Ctx.Cursors (Fld).Predecessor = F_Error_Response_Vendor_ID_Quad
                             then
                                RFLX_Types.Bit_Length (Ctx.Written_Last) - RFLX_Types.Bit_Length (Ctx.Cursors (F_Error_Response_Vendor_ID_Quad).Last)
                             else
                                RFLX_Types.Unreachable),
                         when F_Error_Response_Response_Not_Ready_Data_Token =>
                            8,
                         when F_Measurements_Response_Measurement_Record_Length =>
                            24,
                         when F_Version_Response_Version_Number_Entries =>
                            RFLX_Types.Bit_Length (Ctx.Cursors (F_Version_Response_Version_Number_Entry_Count).Value) * 16,
                         when F_Algorithms_Response_Measurement_Hash_Algo =>
                            32,
                         when F_Capabilities_Response_MAC_Cap | F_Digests_Response_Slot_Mask_Slot_3_Present =>
                            1,
                         when F_Error_Response_Response_Not_Ready_Data_RDTM =>
                            8,
                         when F_Measurements_Response_Measurement_Record =>
                            RFLX_Types.Bit_Length (Ctx.Cursors (F_Measurements_Response_Measurement_Record_Length).Value) * 8,
                         when F_Algorithms_Response_Base_Asym_Sel =>
                            32,
                         when F_Capabilities_Response_Encrypt_Cap | F_Digests_Response_Slot_Mask_Slot_2_Present =>
                            1,
                         when F_Measurements_Response_Nonce_Data =>
                            256,
                         when F_Algorithms_Response_Base_Hash_Sel =>
                            32,
                         when F_Capabilities_Response_Meas_Fresh_Cap | F_Digests_Response_Slot_Mask_Slot_1_Present =>
                            1,
                         when F_Measurements_Response_Opaque_Length =>
                            16,
                         when F_Algorithms_Response_Reserved_2 =>
                            32,
                         when F_Capabilities_Response_Meas_Cap =>
                            2,
                         when F_Digests_Response_Slot_Mask_Slot_0_Present =>
                            1,
                         when F_Measurements_Response_Opaque_Data =>
                            RFLX_Types.Bit_Length (Ctx.Cursors (F_Measurements_Response_Opaque_Length).Value) * 8,
                         when F_Algorithms_Response_Reserved_3 =>
                            32,
                         when F_Capabilities_Response_Chal_Cap =>
                            1,
                         when F_Digests_Response_Digests_Data =>
                            (RFLX_Types.Bit_Length (Ctx.Cursors (F_Digests_Response_Slot_Mask_Slot_7_Present).Value) + RFLX_Types.Bit_Length (Ctx.Cursors (F_Digests_Response_Slot_Mask_Slot_6_Present).Value) + RFLX_Types.Bit_Length (Ctx.Cursors (F_Digests_Response_Slot_Mask_Slot_5_Present).Value) + RFLX_Types.Bit_Length (Ctx.Cursors (F_Digests_Response_Slot_Mask_Slot_4_Present).Value) + RFLX_Types.Bit_Length (Ctx.Cursors (F_Digests_Response_Slot_Mask_Slot_3_Present).Value) + RFLX_Types.Bit_Length (Ctx.Cursors (F_Digests_Response_Slot_Mask_Slot_2_Present).Value) + RFLX_Types.Bit_Length (Ctx.Cursors (F_Digests_Response_Slot_Mask_Slot_0_Present).Value) + RFLX_Types.Bit_Length (Ctx.Cursors (F_Digests_Response_Slot_Mask_Slot_1_Present).Value)) * RFLX_Types.Bit_Length (Ctx.Hash_Length) * 8,
                         when F_Measurements_Response_Signature =>
                            RFLX_Types.Bit_Length (Ctx.Signature_Length) * 8,
                         when F_Algorithms_Response_Reserved_4 =>
                            32,
                         when F_Capabilities_Response_Cert_Cap =>
                            1,
                         when F_Algorithms_Response_Ext_Asym_Sel_Count =>
                            8,
                         when F_Capabilities_Response_Cache_Cap =>
                            1,
                         when F_Algorithms_Response_Ext_Hash_Sel_Count =>
                            8,
                         when F_Capabilities_Response_Handshake_In_The_Clear_Cap =>
                            1,
                         when F_Algorithms_Response_Reserved_5 =>
                            16,
                         when F_Capabilities_Response_Key_Upd_Cap =>
                            1,
                         when F_Algorithms_Response_Ext_Asym =>
                            RFLX_Types.Bit_Length (Ctx.Cursors (F_Algorithms_Response_Ext_Asym_Sel_Count).Value) * 32,
                         when F_Capabilities_Response_Hbeat_Cap =>
                            1,
                         when F_Algorithms_Response_Ext_Hash =>
                            RFLX_Types.Bit_Length (Ctx.Cursors (F_Algorithms_Response_Ext_Hash_Sel_Count).Value) * 32,
                         when F_Capabilities_Response_Encap_Cap =>
                            1,
                         when F_Algorithms_Response_Resp_Alg_Structs =>
                            RFLX_Types.Bit_Length (Ctx.Cursors (F_Algorithms_Response_Length).Value) * 8 - RFLX_Types.Bit_Length (Ctx.Cursors (F_Algorithms_Response_Ext_Hash).Last) + RFLX_Types.Bit_Length (Ctx.Cursors (F_Algorithms_Response_Resp_Alg_Struct_Count).First) - 17,
                         when F_Capabilities_Response_PSK_Cap =>
                            2,
                         when F_Capabilities_Response_Key_Ex_Cap | F_Capabilities_Response_Mut_Auth_Cap =>
                            1,
                         when F_Capabilities_Response_Reserved_4 =>
                            15,
                         when F_Capabilities_Response_Pub_Key_ID_Cap =>
                            1));
      if State_Valid then
         Ctx.Cursors (Fld) := (State => S_Valid, First => First, Last => Last, Value => Val, Predecessor => Ctx.Cursors (Fld).Predecessor);
      else
         Ctx.Cursors (Fld) := (State => S_Structural_Valid, First => First, Last => Last, Value => Val, Predecessor => Ctx.Cursors (Fld).Predecessor);
      end if;
      Ctx.Cursors (Successor (Ctx, Fld)) := (State => S_Invalid, Predecessor => Fld);
      pragma Assert (Last = (Field_First (Ctx, Fld) + Size) - 1);
   end Set;

   procedure Set_Scalar (Ctx : in out Context; Fld : Field; Val : RFLX_Types.Base_Integer) with
     Pre =>
       not Ctx'Constrained
       and then RFLX.SPDM.Response.Has_Buffer (Ctx)
       and then RFLX.SPDM.Response.Valid_Next (Ctx, Fld)
       and then Fld in F_Major_Version | F_Minor_Version | F_Code | F_Algorithms_Response_Resp_Alg_Struct_Count | F_Capabilities_Response_Param_1 | F_Certificate_Response_Slot | F_Digests_Response_Param_1 | F_Error_Response_Error_Code | F_Measurements_Response_Number_Of_Indices | F_Version_Response_Param_1 | F_Algorithms_Response_Param_2 | F_Capabilities_Response_Param_2 | F_Certificate_Response_Param_2 | F_Digests_Response_Slot_Mask_Slot_7_Present | F_Error_Response_Invalid_Session_ID | F_Error_Response_Registry_ID | F_Error_Response_Request_Response_Code | F_Error_Response_Reserved_Error_Data | F_Error_Response_Zero_Error_Data | F_Measurements_Response_Reserved_1 | F_Version_Response_Param_2 | F_Algorithms_Response_Length | F_Capabilities_Response_Reserved_1 | F_Certificate_Response_Portion_Length | F_Digests_Response_Slot_Mask_Slot_6_Present | F_Error_Response_Vendor_ID_Len | F_Error_Response_Response_Not_Ready_Data_RDT_Exponent | F_Measurements_Response_Slot_ID | F_Version_Response_Reserved | F_Algorithms_Response_Measurement_Specification_Sel | F_Capabilities_Response_CT_Exponent | F_Certificate_Response_Remainder_Length | F_Digests_Response_Slot_Mask_Slot_5_Present | F_Error_Response_Vendor_ID_Double | F_Error_Response_Vendor_ID_Quad | F_Error_Response_Response_Not_Ready_Data_Request_Code | F_Measurements_Response_Number_Of_Blocks | F_Version_Response_Version_Number_Entry_Count | F_Algorithms_Response_Reserved_1 | F_Capabilities_Response_Reserved_2 | F_Digests_Response_Slot_Mask_Slot_4_Present | F_Error_Response_Response_Not_Ready_Data_Token | F_Measurements_Response_Measurement_Record_Length | F_Algorithms_Response_Measurement_Hash_Algo | F_Capabilities_Response_MAC_Cap | F_Digests_Response_Slot_Mask_Slot_3_Present | F_Error_Response_Response_Not_Ready_Data_RDTM | F_Algorithms_Response_Base_Asym_Sel | F_Capabilities_Response_Encrypt_Cap | F_Digests_Response_Slot_Mask_Slot_2_Present | F_Algorithms_Response_Base_Hash_Sel | F_Capabilities_Response_Meas_Fresh_Cap | F_Digests_Response_Slot_Mask_Slot_1_Present | F_Measurements_Response_Opaque_Length | F_Algorithms_Response_Reserved_2 | F_Capabilities_Response_Meas_Cap | F_Digests_Response_Slot_Mask_Slot_0_Present | F_Algorithms_Response_Reserved_3 | F_Capabilities_Response_Chal_Cap | F_Algorithms_Response_Reserved_4 | F_Capabilities_Response_Cert_Cap | F_Algorithms_Response_Ext_Asym_Sel_Count | F_Capabilities_Response_Cache_Cap | F_Algorithms_Response_Ext_Hash_Sel_Count | F_Capabilities_Response_Handshake_In_The_Clear_Cap | F_Algorithms_Response_Reserved_5 | F_Capabilities_Response_Key_Upd_Cap | F_Capabilities_Response_Hbeat_Cap | F_Capabilities_Response_Encap_Cap | F_Capabilities_Response_PSK_Cap | F_Capabilities_Response_Key_Ex_Cap | F_Capabilities_Response_Mut_Auth_Cap | F_Capabilities_Response_Reserved_4 | F_Capabilities_Response_Pub_Key_ID_Cap
       and then RFLX.SPDM.Response.Valid_Value (Fld, Val)
       and then RFLX.SPDM.Response.Valid_Size (Ctx, Fld, RFLX.SPDM.Response.Field_Size (Ctx, Fld))
       and then RFLX.SPDM.Response.Available_Space (Ctx, Fld) >= RFLX.SPDM.Response.Field_Size (Ctx, Fld)
       and then RFLX.SPDM.Response.Field_Size (Ctx, Fld) in 1 .. RFLX_Types.Base_Integer'Size
       and then RFLX_Types.Fits_Into (Val, Natural (RFLX.SPDM.Response.Field_Size (Ctx, Fld))),
     Post =>
       Has_Buffer (Ctx)
       and Valid (Ctx, Fld)
       and Invalid_Successor (Ctx, Fld)
       and (case Fld is
               when F_Major_Version =>
                  Get_Major_Version (Ctx) = To_Actual (Val)
                  and (if
                          Get_Major_Version (Ctx) = 1
                       then
                          Predecessor (Ctx, F_Minor_Version) = F_Major_Version
                          and Valid_Next (Ctx, F_Minor_Version)),
               when F_Minor_Version =>
                  Get_Minor_Version (Ctx) = To_Actual (Val)
                  and (if
                          Get_Minor_Version (Ctx) <= 1
                       then
                          Predecessor (Ctx, F_Code) = F_Minor_Version
                          and Valid_Next (Ctx, F_Code)),
               when F_Code =>
                  Get_Code (Ctx) = To_Actual (Val)
                  and (if
                          RFLX_Types.Base_Integer (To_Base_Integer (Get_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Algorithms))
                       then
                          Predecessor (Ctx, F_Algorithms_Response_Resp_Alg_Struct_Count) = F_Code
                          and Valid_Next (Ctx, F_Algorithms_Response_Resp_Alg_Struct_Count))
                  and (if
                          RFLX_Types.Base_Integer (To_Base_Integer (Get_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Capabilities))
                          and Get_Minor_Version (Ctx) = 1
                       then
                          Predecessor (Ctx, F_Capabilities_Response_Param_1) = F_Code
                          and Valid_Next (Ctx, F_Capabilities_Response_Param_1))
                  and (if
                          RFLX_Types.Base_Integer (To_Base_Integer (Get_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Certificate))
                          and Get_Minor_Version (Ctx) = 1
                       then
                          Predecessor (Ctx, F_Certificate_Response_Slot) = F_Code
                          and Valid_Next (Ctx, F_Certificate_Response_Slot))
                  and (if
                          RFLX_Types.Base_Integer (To_Base_Integer (Get_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Digests))
                       then
                          Predecessor (Ctx, F_Digests_Response_Param_1) = F_Code
                          and Valid_Next (Ctx, F_Digests_Response_Param_1))
                  and (if
                          RFLX_Types.Base_Integer (To_Base_Integer (Get_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Error))
                          and Get_Minor_Version (Ctx) = 1
                       then
                          Predecessor (Ctx, F_Error_Response_Error_Code) = F_Code
                          and Valid_Next (Ctx, F_Error_Response_Error_Code))
                  and (if
                          RFLX_Types.Base_Integer (To_Base_Integer (Get_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Measurements))
                          and Get_Minor_Version (Ctx) = 1
                       then
                          Predecessor (Ctx, F_Measurements_Response_Number_Of_Indices) = F_Code
                          and Valid_Next (Ctx, F_Measurements_Response_Number_Of_Indices))
                  and (if
                          RFLX_Types.Base_Integer (To_Base_Integer (Get_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Version))
                          and Get_Minor_Version (Ctx) = 0
                       then
                          Predecessor (Ctx, F_Version_Response_Param_1) = F_Code
                          and Valid_Next (Ctx, F_Version_Response_Param_1)),
               when F_Algorithms_Response_Resp_Alg_Struct_Count =>
                  Get_Algorithms_Response_Resp_Alg_Struct_Count (Ctx) = To_Actual (Val)
                  and (Predecessor (Ctx, F_Algorithms_Response_Param_2) = F_Algorithms_Response_Resp_Alg_Struct_Count
                       and Valid_Next (Ctx, F_Algorithms_Response_Param_2)),
               when F_Capabilities_Response_Param_1 =>
                  (Predecessor (Ctx, F_Capabilities_Response_Param_2) = F_Capabilities_Response_Param_1
                   and Valid_Next (Ctx, F_Capabilities_Response_Param_2)),
               when F_Certificate_Response_Slot =>
                  Get_Certificate_Response_Slot (Ctx) = To_Actual (Val)
                  and (Predecessor (Ctx, F_Certificate_Response_Param_2) = F_Certificate_Response_Slot
                       and Valid_Next (Ctx, F_Certificate_Response_Param_2)),
               when F_Digests_Response_Param_1 =>
                  (Predecessor (Ctx, F_Digests_Response_Slot_Mask_Slot_7_Present) = F_Digests_Response_Param_1
                   and Valid_Next (Ctx, F_Digests_Response_Slot_Mask_Slot_7_Present)),
               when F_Error_Response_Error_Code =>
                  Get_Error_Response_Error_Code (Ctx) = To_Actual (Val)
                  and (if
                          RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Response_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Invalid_Session))
                       then
                          Predecessor (Ctx, F_Error_Response_Invalid_Session_ID) = F_Error_Response_Error_Code
                          and Valid_Next (Ctx, F_Error_Response_Invalid_Session_ID))
                  and (if
                          RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Response_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Vendor))
                       then
                          Predecessor (Ctx, F_Error_Response_Registry_ID) = F_Error_Response_Error_Code
                          and Valid_Next (Ctx, F_Error_Response_Registry_ID))
                  and (if
                          RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Response_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Unsupported_Request))
                       then
                          Predecessor (Ctx, F_Error_Response_Request_Response_Code) = F_Error_Response_Error_Code
                          and Valid_Next (Ctx, F_Error_Response_Request_Response_Code))
                  and (if
                          RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Response_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Session_Limit_Exceeded))
                          or RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Response_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Invalid_Response_Code))
                          or RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Response_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Decrypt_Error))
                          or RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Response_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Request_In_Flight))
                       then
                          Predecessor (Ctx, F_Error_Response_Reserved_Error_Data) = F_Error_Response_Error_Code
                          and Valid_Next (Ctx, F_Error_Response_Reserved_Error_Data))
                  and (if
                          RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Response_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Request_Resynch))
                          or RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Response_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Response_Not_Ready))
                          or RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Response_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Major_Version_Mismatch))
                          or RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Response_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Unspecified))
                          or RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Response_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Unexpected_Request))
                          or RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Response_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Invalid_Request))
                          or RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Response_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Busy))
                       then
                          Predecessor (Ctx, F_Error_Response_Zero_Error_Data) = F_Error_Response_Error_Code
                          and Valid_Next (Ctx, F_Error_Response_Zero_Error_Data)),
               when F_Measurements_Response_Number_Of_Indices =>
                  Get_Measurements_Response_Number_Of_Indices (Ctx) = To_Actual (Val)
                  and (Predecessor (Ctx, F_Measurements_Response_Reserved_1) = F_Measurements_Response_Number_Of_Indices
                       and Valid_Next (Ctx, F_Measurements_Response_Reserved_1)),
               when F_Version_Response_Param_1 =>
                  (Predecessor (Ctx, F_Version_Response_Param_2) = F_Version_Response_Param_1
                   and Valid_Next (Ctx, F_Version_Response_Param_2)),
               when F_Algorithms_Response_Param_2 =>
                  (Predecessor (Ctx, F_Algorithms_Response_Length) = F_Algorithms_Response_Param_2
                   and Valid_Next (Ctx, F_Algorithms_Response_Length)),
               when F_Capabilities_Response_Param_2 =>
                  (Predecessor (Ctx, F_Capabilities_Response_Reserved_1) = F_Capabilities_Response_Param_2
                   and Valid_Next (Ctx, F_Capabilities_Response_Reserved_1)),
               when F_Certificate_Response_Param_2 =>
                  (Predecessor (Ctx, F_Certificate_Response_Portion_Length) = F_Certificate_Response_Param_2
                   and Valid_Next (Ctx, F_Certificate_Response_Portion_Length)),
               when F_Digests_Response_Slot_Mask_Slot_7_Present =>
                  Get_Digests_Response_Slot_Mask_Slot_7_Present (Ctx) = To_Actual (Val)
                  and (Predecessor (Ctx, F_Digests_Response_Slot_Mask_Slot_6_Present) = F_Digests_Response_Slot_Mask_Slot_7_Present
                       and Valid_Next (Ctx, F_Digests_Response_Slot_Mask_Slot_6_Present)),
               when F_Error_Response_Invalid_Session_ID =>
                  Get_Error_Response_Invalid_Session_ID (Ctx) = To_Actual (Val)
                  and (if Structural_Valid_Message (Ctx) then Message_Last (Ctx) = Field_Last (Ctx, Fld)),
               when F_Error_Response_Registry_ID =>
                  Get_Error_Response_Registry_ID (Ctx) = To_Actual (Val)
                  and (Predecessor (Ctx, F_Error_Response_Vendor_ID_Len) = F_Error_Response_Registry_ID
                       and Valid_Next (Ctx, F_Error_Response_Vendor_ID_Len)),
               when F_Error_Response_Request_Response_Code =>
                  Get_Error_Response_Request_Response_Code (Ctx) = To_Actual (Val)
                  and (if Structural_Valid_Message (Ctx) then Message_Last (Ctx) = Field_Last (Ctx, Fld)),
               when F_Error_Response_Reserved_Error_Data =>
                  (if Structural_Valid_Message (Ctx) then Message_Last (Ctx) = Field_Last (Ctx, Fld)),
               when F_Error_Response_Zero_Error_Data =>
                  (if
                      RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Response_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Response_Not_Ready))
                   then
                      Predecessor (Ctx, F_Error_Response_Response_Not_Ready_Data_RDT_Exponent) = F_Error_Response_Zero_Error_Data
                      and Valid_Next (Ctx, F_Error_Response_Response_Not_Ready_Data_RDT_Exponent))
                  and (if Structural_Valid_Message (Ctx) then Message_Last (Ctx) = Field_Last (Ctx, Fld)),
               when F_Measurements_Response_Reserved_1 =>
                  (Predecessor (Ctx, F_Measurements_Response_Slot_ID) = F_Measurements_Response_Reserved_1
                   and Valid_Next (Ctx, F_Measurements_Response_Slot_ID)),
               when F_Version_Response_Param_2 =>
                  (Predecessor (Ctx, F_Version_Response_Reserved) = F_Version_Response_Param_2
                   and Valid_Next (Ctx, F_Version_Response_Reserved)),
               when F_Algorithms_Response_Length =>
                  Get_Algorithms_Response_Length (Ctx) = To_Actual (Val)
                  and (Predecessor (Ctx, F_Algorithms_Response_Measurement_Specification_Sel) = F_Algorithms_Response_Length
                       and Valid_Next (Ctx, F_Algorithms_Response_Measurement_Specification_Sel)),
               when F_Capabilities_Response_Reserved_1 =>
                  (Predecessor (Ctx, F_Capabilities_Response_CT_Exponent) = F_Capabilities_Response_Reserved_1
                   and Valid_Next (Ctx, F_Capabilities_Response_CT_Exponent)),
               when F_Certificate_Response_Portion_Length =>
                  Get_Certificate_Response_Portion_Length (Ctx) = To_Actual (Val)
                  and (Predecessor (Ctx, F_Certificate_Response_Remainder_Length) = F_Certificate_Response_Portion_Length
                       and Valid_Next (Ctx, F_Certificate_Response_Remainder_Length)),
               when F_Digests_Response_Slot_Mask_Slot_6_Present =>
                  Get_Digests_Response_Slot_Mask_Slot_6_Present (Ctx) = To_Actual (Val)
                  and (Predecessor (Ctx, F_Digests_Response_Slot_Mask_Slot_5_Present) = F_Digests_Response_Slot_Mask_Slot_6_Present
                       and Valid_Next (Ctx, F_Digests_Response_Slot_Mask_Slot_5_Present)),
               when F_Error_Response_Vendor_ID_Len =>
                  Get_Error_Response_Vendor_ID_Len (Ctx) = To_Actual (Val)
                  and (if
                          Get_Error_Response_Vendor_ID_Len (Ctx) = 0
