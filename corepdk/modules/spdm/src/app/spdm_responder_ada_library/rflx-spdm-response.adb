                      or RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_PSK_Cap).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.PSK_Resp_Unsupported)))
              then
                 F_Final
              else
                 F_Initial)))
    with
     Pre =>
       RFLX.SPDM.Response.Has_Buffer (Ctx)
       and RFLX.SPDM.Response.Structural_Valid (Ctx, Fld)
       and RFLX.SPDM.Response.Valid_Predecessor (Ctx, Fld);

   pragma Warnings (On, "precondition is always False");

   function Invalid_Successor (Ctx : Context; Fld : Field) return Boolean is
     ((case Fld is
          when F_Major_Version =>
             Invalid (Ctx.Cursors (F_Minor_Version)),
          when F_Minor_Version =>
             Invalid (Ctx.Cursors (F_Code)),
          when F_Code =>
             Invalid (Ctx.Cursors (F_Algorithms_Response_Resp_Alg_Struct_Count))
             and Invalid (Ctx.Cursors (F_Capabilities_Response_Param_1))
             and Invalid (Ctx.Cursors (F_Certificate_Response_Slot))
             and Invalid (Ctx.Cursors (F_Digests_Response_Param_1))
             and Invalid (Ctx.Cursors (F_Error_Response_Error_Code))
             and Invalid (Ctx.Cursors (F_Measurements_Response_Number_Of_Indices))
             and Invalid (Ctx.Cursors (F_Version_Response_Param_1)),
          when F_Algorithms_Response_Resp_Alg_Struct_Count =>
             Invalid (Ctx.Cursors (F_Algorithms_Response_Param_2)),
          when F_Capabilities_Response_Param_1 =>
             Invalid (Ctx.Cursors (F_Capabilities_Response_Param_2)),
          when F_Certificate_Response_Slot =>
             Invalid (Ctx.Cursors (F_Certificate_Response_Param_2)),
          when F_Digests_Response_Param_1 =>
             Invalid (Ctx.Cursors (F_Digests_Response_Slot_Mask_Slot_7_Present)),
          when F_Error_Response_Error_Code =>
             Invalid (Ctx.Cursors (F_Error_Response_Invalid_Session_ID))
             and Invalid (Ctx.Cursors (F_Error_Response_Registry_ID))
             and Invalid (Ctx.Cursors (F_Error_Response_Request_Response_Code))
             and Invalid (Ctx.Cursors (F_Error_Response_Reserved_Error_Data))
             and Invalid (Ctx.Cursors (F_Error_Response_Zero_Error_Data)),
          when F_Measurements_Response_Number_Of_Indices =>
             Invalid (Ctx.Cursors (F_Measurements_Response_Reserved_1)),
          when F_Version_Response_Param_1 =>
             Invalid (Ctx.Cursors (F_Version_Response_Param_2)),
          when F_Algorithms_Response_Param_2 =>
             Invalid (Ctx.Cursors (F_Algorithms_Response_Length)),
          when F_Capabilities_Response_Param_2 =>
             Invalid (Ctx.Cursors (F_Capabilities_Response_Reserved_1)),
          when F_Certificate_Response_Param_2 =>
             Invalid (Ctx.Cursors (F_Certificate_Response_Portion_Length)),
          when F_Digests_Response_Slot_Mask_Slot_7_Present =>
             Invalid (Ctx.Cursors (F_Digests_Response_Slot_Mask_Slot_6_Present)),
          when F_Error_Response_Invalid_Session_ID =>
             True,
          when F_Error_Response_Registry_ID =>
             Invalid (Ctx.Cursors (F_Error_Response_Vendor_ID_Len)),
          when F_Error_Response_Request_Response_Code | F_Error_Response_Reserved_Error_Data =>
             True,
          when F_Error_Response_Zero_Error_Data =>
             Invalid (Ctx.Cursors (F_Error_Response_Response_Not_Ready_Data_RDT_Exponent)),
          when F_Measurements_Response_Reserved_1 =>
             Invalid (Ctx.Cursors (F_Measurements_Response_Slot_ID)),
          when F_Version_Response_Param_2 =>
             Invalid (Ctx.Cursors (F_Version_Response_Reserved)),
          when F_Algorithms_Response_Length =>
             Invalid (Ctx.Cursors (F_Algorithms_Response_Measurement_Specification_Sel)),
          when F_Capabilities_Response_Reserved_1 =>
             Invalid (Ctx.Cursors (F_Capabilities_Response_CT_Exponent)),
          when F_Certificate_Response_Portion_Length =>
             Invalid (Ctx.Cursors (F_Certificate_Response_Remainder_Length)),
          when F_Digests_Response_Slot_Mask_Slot_6_Present =>
             Invalid (Ctx.Cursors (F_Digests_Response_Slot_Mask_Slot_5_Present)),
          when F_Error_Response_Vendor_ID_Len =>
             Invalid (Ctx.Cursors (F_Error_Response_Opaque_Error_Data))
             and Invalid (Ctx.Cursors (F_Error_Response_Vendor_ID_Double))
             and Invalid (Ctx.Cursors (F_Error_Response_Vendor_ID_Quad)),
          when F_Error_Response_Response_Not_Ready_Data_RDT_Exponent =>
             Invalid (Ctx.Cursors (F_Error_Response_Response_Not_Ready_Data_Request_Code)),
          when F_Measurements_Response_Slot_ID =>
             Invalid (Ctx.Cursors (F_Measurements_Response_Number_Of_Blocks)),
          when F_Version_Response_Reserved =>
             Invalid (Ctx.Cursors (F_Version_Response_Version_Number_Entry_Count)),
          when F_Algorithms_Response_Measurement_Specification_Sel =>
             Invalid (Ctx.Cursors (F_Algorithms_Response_Reserved_1)),
          when F_Capabilities_Response_CT_Exponent =>
             Invalid (Ctx.Cursors (F_Capabilities_Response_Reserved_2)),
          when F_Certificate_Response_Remainder_Length =>
             Invalid (Ctx.Cursors (F_Certificate_Response_Cert_Chain)),
          when F_Digests_Response_Slot_Mask_Slot_5_Present =>
             Invalid (Ctx.Cursors (F_Digests_Response_Slot_Mask_Slot_4_Present)),
          when F_Error_Response_Vendor_ID_Double | F_Error_Response_Vendor_ID_Quad =>
             Invalid (Ctx.Cursors (F_Error_Response_Opaque_Error_Data)),
          when F_Error_Response_Response_Not_Ready_Data_Request_Code =>
             Invalid (Ctx.Cursors (F_Error_Response_Response_Not_Ready_Data_Token)),
          when F_Measurements_Response_Number_Of_Blocks =>
             Invalid (Ctx.Cursors (F_Measurements_Response_Measurement_Record_Length)),
          when F_Version_Response_Version_Number_Entry_Count =>
             Invalid (Ctx.Cursors (F_Version_Response_Version_Number_Entries)),
          when F_Algorithms_Response_Reserved_1 =>
             Invalid (Ctx.Cursors (F_Algorithms_Response_Measurement_Hash_Algo)),
          when F_Capabilities_Response_Reserved_2 =>
             Invalid (Ctx.Cursors (F_Capabilities_Response_MAC_Cap)),
          when F_Certificate_Response_Cert_Chain =>
             True,
          when F_Digests_Response_Slot_Mask_Slot_4_Present =>
             Invalid (Ctx.Cursors (F_Digests_Response_Slot_Mask_Slot_3_Present)),
          when F_Error_Response_Opaque_Error_Data =>
             True,
          when F_Error_Response_Response_Not_Ready_Data_Token =>
             Invalid (Ctx.Cursors (F_Error_Response_Response_Not_Ready_Data_RDTM)),
          when F_Measurements_Response_Measurement_Record_Length =>
             Invalid (Ctx.Cursors (F_Measurements_Response_Measurement_Record)),
          when F_Version_Response_Version_Number_Entries =>
             True,
          when F_Algorithms_Response_Measurement_Hash_Algo =>
             Invalid (Ctx.Cursors (F_Algorithms_Response_Base_Asym_Sel)),
          when F_Capabilities_Response_MAC_Cap =>
             Invalid (Ctx.Cursors (F_Capabilities_Response_Encrypt_Cap)),
          when F_Digests_Response_Slot_Mask_Slot_3_Present =>
             Invalid (Ctx.Cursors (F_Digests_Response_Slot_Mask_Slot_2_Present)),
          when F_Error_Response_Response_Not_Ready_Data_RDTM =>
             True,
          when F_Measurements_Response_Measurement_Record =>
             Invalid (Ctx.Cursors (F_Measurements_Response_Nonce_Data)),
          when F_Algorithms_Response_Base_Asym_Sel =>
             Invalid (Ctx.Cursors (F_Algorithms_Response_Base_Hash_Sel)),
          when F_Capabilities_Response_Encrypt_Cap =>
             Invalid (Ctx.Cursors (F_Capabilities_Response_Meas_Fresh_Cap)),
          when F_Digests_Response_Slot_Mask_Slot_2_Present =>
             Invalid (Ctx.Cursors (F_Digests_Response_Slot_Mask_Slot_1_Present)),
          when F_Measurements_Response_Nonce_Data =>
             Invalid (Ctx.Cursors (F_Measurements_Response_Opaque_Length)),
          when F_Algorithms_Response_Base_Hash_Sel =>
             Invalid (Ctx.Cursors (F_Algorithms_Response_Reserved_2)),
          when F_Capabilities_Response_Meas_Fresh_Cap =>
             Invalid (Ctx.Cursors (F_Capabilities_Response_Meas_Cap)),
          when F_Digests_Response_Slot_Mask_Slot_1_Present =>
             Invalid (Ctx.Cursors (F_Digests_Response_Slot_Mask_Slot_0_Present)),
          when F_Measurements_Response_Opaque_Length =>
             Invalid (Ctx.Cursors (F_Measurements_Response_Opaque_Data)),
          when F_Algorithms_Response_Reserved_2 =>
             Invalid (Ctx.Cursors (F_Algorithms_Response_Reserved_3)),
          when F_Capabilities_Response_Meas_Cap =>
             Invalid (Ctx.Cursors (F_Capabilities_Response_Chal_Cap)),
          when F_Digests_Response_Slot_Mask_Slot_0_Present =>
             Invalid (Ctx.Cursors (F_Digests_Response_Digests_Data)),
          when F_Measurements_Response_Opaque_Data =>
             Invalid (Ctx.Cursors (F_Measurements_Response_Signature)),
          when F_Algorithms_Response_Reserved_3 =>
             Invalid (Ctx.Cursors (F_Algorithms_Response_Reserved_4)),
          when F_Capabilities_Response_Chal_Cap =>
             Invalid (Ctx.Cursors (F_Capabilities_Response_Cert_Cap)),
          when F_Digests_Response_Digests_Data | F_Measurements_Response_Signature =>
             True,
          when F_Algorithms_Response_Reserved_4 =>
             Invalid (Ctx.Cursors (F_Algorithms_Response_Ext_Asym_Sel_Count)),
          when F_Capabilities_Response_Cert_Cap =>
             Invalid (Ctx.Cursors (F_Capabilities_Response_Cache_Cap)),
          when F_Algorithms_Response_Ext_Asym_Sel_Count =>
             Invalid (Ctx.Cursors (F_Algorithms_Response_Ext_Hash_Sel_Count)),
          when F_Capabilities_Response_Cache_Cap =>
             Invalid (Ctx.Cursors (F_Capabilities_Response_Handshake_In_The_Clear_Cap)),
          when F_Algorithms_Response_Ext_Hash_Sel_Count =>
             Invalid (Ctx.Cursors (F_Algorithms_Response_Reserved_5)),
          when F_Capabilities_Response_Handshake_In_The_Clear_Cap =>
             Invalid (Ctx.Cursors (F_Capabilities_Response_Key_Upd_Cap)),
          when F_Algorithms_Response_Reserved_5 =>
             Invalid (Ctx.Cursors (F_Algorithms_Response_Ext_Asym)),
          when F_Capabilities_Response_Key_Upd_Cap =>
             Invalid (Ctx.Cursors (F_Capabilities_Response_Hbeat_Cap)),
          when F_Algorithms_Response_Ext_Asym =>
             Invalid (Ctx.Cursors (F_Algorithms_Response_Ext_Hash)),
          when F_Capabilities_Response_Hbeat_Cap =>
             Invalid (Ctx.Cursors (F_Capabilities_Response_Encap_Cap)),
          when F_Algorithms_Response_Ext_Hash =>
             Invalid (Ctx.Cursors (F_Algorithms_Response_Resp_Alg_Structs)),
          when F_Capabilities_Response_Encap_Cap =>
             Invalid (Ctx.Cursors (F_Capabilities_Response_PSK_Cap)),
          when F_Algorithms_Response_Resp_Alg_Structs =>
             True,
          when F_Capabilities_Response_PSK_Cap =>
             Invalid (Ctx.Cursors (F_Capabilities_Response_Key_Ex_Cap)),
          when F_Capabilities_Response_Key_Ex_Cap =>
             Invalid (Ctx.Cursors (F_Capabilities_Response_Mut_Auth_Cap)),
          when F_Capabilities_Response_Mut_Auth_Cap =>
             Invalid (Ctx.Cursors (F_Capabilities_Response_Reserved_4)),
          when F_Capabilities_Response_Reserved_4 =>
             Invalid (Ctx.Cursors (F_Capabilities_Response_Pub_Key_ID_Cap)),
          when F_Capabilities_Response_Pub_Key_ID_Cap =>
             True));

   function Sufficient_Buffer_Length (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Buffer /= null
      and Field_First (Ctx, Fld) + Field_Size (Ctx, Fld) < RFLX_Types.Bit_Length'Last
      and Ctx.First <= Field_First (Ctx, Fld)
      and Field_First (Ctx, Fld) + Field_Size (Ctx, Fld) - 1 <= Ctx.Written_Last)
    with
     Pre =>
       RFLX.SPDM.Response.Has_Buffer (Ctx)
       and RFLX.SPDM.Response.Valid_Next (Ctx, Fld);

   function Equal (Ctx : Context; Fld : Field; Data : RFLX_Types.Bytes) return Boolean is
     (Sufficient_Buffer_Length (Ctx, Fld)
      and then (case Fld is
                   when F_Certificate_Response_Cert_Chain | F_Error_Response_Opaque_Error_Data | F_Version_Response_Version_Number_Entries | F_Measurements_Response_Measurement_Record | F_Measurements_Response_Nonce_Data | F_Measurements_Response_Opaque_Data | F_Digests_Response_Digests_Data | F_Measurements_Response_Signature | F_Algorithms_Response_Ext_Asym | F_Algorithms_Response_Ext_Hash | F_Algorithms_Response_Resp_Alg_Structs =>
                      Data'Length = RFLX_Types.To_Index (Field_Last (Ctx, Fld)) - RFLX_Types.To_Index (Field_First (Ctx, Fld)) + 1
                      and then (for all I in RFLX_Types.Index range RFLX_Types.To_Index (Field_First (Ctx, Fld)) .. RFLX_Types.To_Index (Field_Last (Ctx, Fld)) =>
                                   Ctx.Buffer.all (I) = Data (Data'First + (I - RFLX_Types.To_Index (Field_First (Ctx, Fld))))),
                   when others =>
                      False));

   procedure Reset_Dependent_Fields (Ctx : in out Context; Fld : Field) with
     Pre =>
       RFLX.SPDM.Response.Valid_Next (Ctx, Fld),
     Post =>
       Valid_Next (Ctx, Fld)
       and Invalid (Ctx.Cursors (Fld))
       and Invalid_Successor (Ctx, Fld)
       and Ctx.Buffer_First = Ctx.Buffer_First'Old
       and Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and Ctx.First = Ctx.First'Old
       and Ctx.Last = Ctx.Last'Old
       and Ctx.Hash_Length = Ctx.Hash_Length'Old
       and Ctx.Signature_Length = Ctx.Signature_Length'Old
       and Ctx.Has_Signature = Ctx.Has_Signature'Old
       and Ctx.Cursors (Fld).Predecessor = Ctx.Cursors (Fld).Predecessor'Old
       and Has_Buffer (Ctx) = Has_Buffer (Ctx)'Old
       and Field_First (Ctx, Fld) = Field_First (Ctx, Fld)'Old
       and Field_Size (Ctx, Fld) = Field_Size (Ctx, Fld)'Old
       and (for all F in Field =>
               (if F < Fld then Ctx.Cursors (F) = Ctx.Cursors'Old (F) else Invalid (Ctx, F)))
   is
      First : constant RFLX_Types.Bit_Length := Field_First (Ctx, Fld) with
        Ghost;
      Size : constant RFLX_Types.Bit_Length := Field_Size (Ctx, Fld) with
        Ghost;
   begin
      pragma Assert (Field_First (Ctx, Fld) = First
                     and Field_Size (Ctx, Fld) = Size);
      for Fld_Loop in reverse Field'Succ (Fld) .. Field'Last loop
         Ctx.Cursors (Fld_Loop) := (S_Invalid, F_Final);
         pragma Loop_Invariant (Field_First (Ctx, Fld) = First
                                and Field_Size (Ctx, Fld) = Size);
         pragma Loop_Invariant ((for all F in Field =>
                                    (if F < Fld_Loop then Ctx.Cursors (F) = Ctx.Cursors'Loop_Entry (F) else Invalid (Ctx, F))));
      end loop;
      pragma Assert (Field_First (Ctx, Fld) = First
                     and Field_Size (Ctx, Fld) = Size);
      Ctx.Cursors (Fld) := (S_Invalid, Ctx.Cursors (Fld).Predecessor);
      pragma Assert (Field_First (Ctx, Fld) = First
                     and Field_Size (Ctx, Fld) = Size);
   end Reset_Dependent_Fields;

   function Composite_Field (Fld : Field) return Boolean is
     (Fld in F_Certificate_Response_Cert_Chain | F_Error_Response_Opaque_Error_Data | F_Version_Response_Version_Number_Entries | F_Measurements_Response_Measurement_Record | F_Measurements_Response_Nonce_Data | F_Measurements_Response_Opaque_Data | F_Digests_Response_Digests_Data | F_Measurements_Response_Signature | F_Algorithms_Response_Ext_Asym | F_Algorithms_Response_Ext_Hash | F_Algorithms_Response_Resp_Alg_Structs);

   function Get (Ctx : Context; Fld : Field) return RFLX_Types.Base_Integer with
     Pre =>
       RFLX.SPDM.Response.Has_Buffer (Ctx)
       and then RFLX.SPDM.Response.Valid_Next (Ctx, Fld)
       and then RFLX.SPDM.Response.Sufficient_Buffer_Length (Ctx, Fld)
       and then not RFLX.SPDM.Response.Composite_Field (Fld)
   is
      First : constant RFLX_Types.Bit_Index := Field_First (Ctx, Fld);
      Last : constant RFLX_Types.Bit_Index := Field_Last (Ctx, Fld);
      Buffer_First : constant RFLX_Types.Index := RFLX_Types.To_Index (First);
      Buffer_Last : constant RFLX_Types.Index := RFLX_Types.To_Index (Last);
      Offset : constant RFLX_Types.Offset := RFLX_Types.Offset ((RFLX_Types.Byte'Size - Last mod RFLX_Types.Byte'Size) mod RFLX_Types.Byte'Size);
      Size : constant Positive := (case Fld is
          when F_Major_Version | F_Minor_Version =>
             4,
          when F_Code | F_Algorithms_Response_Resp_Alg_Struct_Count | F_Capabilities_Response_Param_1 | F_Certificate_Response_Slot | F_Digests_Response_Param_1 | F_Error_Response_Error_Code | F_Measurements_Response_Number_Of_Indices | F_Version_Response_Param_1 | F_Algorithms_Response_Param_2 | F_Capabilities_Response_Param_2 | F_Certificate_Response_Param_2 =>
             8,
          when F_Digests_Response_Slot_Mask_Slot_7_Present =>
             1,
          when F_Error_Response_Invalid_Session_ID | F_Error_Response_Registry_ID | F_Error_Response_Request_Response_Code | F_Error_Response_Reserved_Error_Data | F_Error_Response_Zero_Error_Data =>
             8,
          when F_Measurements_Response_Reserved_1 =>
             4,
          when F_Version_Response_Param_2 =>
             8,
          when F_Algorithms_Response_Length =>
             16,
          when F_Capabilities_Response_Reserved_1 =>
             8,
          when F_Certificate_Response_Portion_Length =>
             16,
          when F_Digests_Response_Slot_Mask_Slot_6_Present =>
             1,
          when F_Error_Response_Vendor_ID_Len | F_Error_Response_Response_Not_Ready_Data_RDT_Exponent =>
             8,
          when F_Measurements_Response_Slot_ID =>
             4,
          when F_Version_Response_Reserved | F_Algorithms_Response_Measurement_Specification_Sel | F_Capabilities_Response_CT_Exponent =>
             8,
          when F_Certificate_Response_Remainder_Length =>
             16,
          when F_Digests_Response_Slot_Mask_Slot_5_Present =>
             1,
          when F_Error_Response_Vendor_ID_Double =>
             16,
          when F_Error_Response_Vendor_ID_Quad =>
             32,
          when F_Error_Response_Response_Not_Ready_Data_Request_Code | F_Measurements_Response_Number_Of_Blocks | F_Version_Response_Version_Number_Entry_Count | F_Algorithms_Response_Reserved_1 =>
             8,
          when F_Capabilities_Response_Reserved_2 =>
             16,
          when F_Digests_Response_Slot_Mask_Slot_4_Present =>
             1,
          when F_Error_Response_Response_Not_Ready_Data_Token =>
             8,
          when F_Measurements_Response_Measurement_Record_Length =>
             24,
          when F_Algorithms_Response_Measurement_Hash_Algo =>
             32,
          when F_Capabilities_Response_MAC_Cap | F_Digests_Response_Slot_Mask_Slot_3_Present =>
             1,
          when F_Error_Response_Response_Not_Ready_Data_RDTM =>
             8,
          when F_Algorithms_Response_Base_Asym_Sel =>
             32,
          when F_Capabilities_Response_Encrypt_Cap | F_Digests_Response_Slot_Mask_Slot_2_Present =>
             1,
          when F_Algorithms_Response_Base_Hash_Sel =>
             32,
          when F_Capabilities_Response_Meas_Fresh_Cap | F_Digests_Response_Slot_Mask_Slot_1_Present =>
             1,
          when F_Measurements_Response_Opaque_Length =>
             16,
          when F_Algorithms_Response_Reserved_2 =>
             32,
          when F_Capabilities_Response_Meas_Cap =>
             2,
          when F_Digests_Response_Slot_Mask_Slot_0_Present =>
             1,
          when F_Algorithms_Response_Reserved_3 =>
             32,
          when F_Capabilities_Response_Chal_Cap =>
             1,
          when F_Algorithms_Response_Reserved_4 =>
             32,
          when F_Capabilities_Response_Cert_Cap =>
             1,
          when F_Algorithms_Response_Ext_Asym_Sel_Count =>
             8,
          when F_Capabilities_Response_Cache_Cap =>
             1,
          when F_Algorithms_Response_Ext_Hash_Sel_Count =>
             8,
          when F_Capabilities_Response_Handshake_In_The_Clear_Cap =>
             1,
          when F_Algorithms_Response_Reserved_5 =>
             16,
          when F_Capabilities_Response_Key_Upd_Cap | F_Capabilities_Response_Hbeat_Cap | F_Capabilities_Response_Encap_Cap =>
             1,
          when F_Capabilities_Response_PSK_Cap =>
             2,
          when F_Capabilities_Response_Key_Ex_Cap | F_Capabilities_Response_Mut_Auth_Cap =>
             1,
          when F_Capabilities_Response_Reserved_4 =>
             15,
          when F_Capabilities_Response_Pub_Key_ID_Cap =>
             1,
          when others =>
             Positive'Last);
      Byte_Order : constant RFLX_Types.Byte_Order := (if
          Fld in F_Capabilities_Response_Param_1 | F_Digests_Response_Param_1 | F_Version_Response_Param_1 | F_Capabilities_Response_Param_2 | F_Digests_Response_Slot_Mask_Slot_7_Present | F_Version_Response_Param_2 | F_Capabilities_Response_Reserved_1 | F_Digests_Response_Slot_Mask_Slot_6_Present | F_Error_Response_Response_Not_Ready_Data_RDT_Exponent | F_Version_Response_Reserved | F_Capabilities_Response_CT_Exponent | F_Digests_Response_Slot_Mask_Slot_5_Present | F_Error_Response_Response_Not_Ready_Data_Request_Code | F_Version_Response_Version_Number_Entry_Count | F_Capabilities_Response_Reserved_2 | F_Digests_Response_Slot_Mask_Slot_4_Present | F_Error_Response_Response_Not_Ready_Data_Token | F_Capabilities_Response_MAC_Cap | F_Digests_Response_Slot_Mask_Slot_3_Present | F_Error_Response_Response_Not_Ready_Data_RDTM | F_Capabilities_Response_Encrypt_Cap | F_Digests_Response_Slot_Mask_Slot_2_Present | F_Capabilities_Response_Meas_Fresh_Cap | F_Digests_Response_Slot_Mask_Slot_1_Present | F_Capabilities_Response_Meas_Cap | F_Digests_Response_Slot_Mask_Slot_0_Present | F_Capabilities_Response_Chal_Cap | F_Capabilities_Response_Cert_Cap | F_Capabilities_Response_Cache_Cap | F_Capabilities_Response_Handshake_In_The_Clear_Cap | F_Capabilities_Response_Key_Upd_Cap | F_Capabilities_Response_Hbeat_Cap | F_Capabilities_Response_Encap_Cap | F_Capabilities_Response_PSK_Cap | F_Capabilities_Response_Key_Ex_Cap | F_Capabilities_Response_Mut_Auth_Cap | F_Capabilities_Response_Reserved_4 | F_Capabilities_Response_Pub_Key_ID_Cap
       then
          RFLX_Types.High_Order_First
       else
          RFLX_Types.Low_Order_First);
   begin
      return RFLX_Types.Extract (Ctx.Buffer, Buffer_First, Buffer_Last, Offset, Size, Byte_Order);
   end Get;

   procedure Verify (Ctx : in out Context; Fld : Field) is
      Value : RFLX_Types.Base_Integer;
   begin
      if
         Invalid (Ctx.Cursors (Fld))
         and then Valid_Predecessor (Ctx, Fld)
         and then Path_Condition (Ctx, Fld)
      then
         if Sufficient_Buffer_Length (Ctx, Fld) then
            Value := (if Composite_Field (Fld) then 0 else Get (Ctx, Fld));
            if
               Valid_Value (Fld, Value)
               and then Field_Condition (Ctx, Fld, Value)
            then
               pragma Assert ((if
                                  Fld = F_Algorithms_Response_Resp_Alg_Structs
                                  or Fld = F_Capabilities_Response_Pub_Key_ID_Cap
                                  or Fld = F_Certificate_Response_Cert_Chain
                                  or Fld = F_Digests_Response_Digests_Data
                                  or Fld = F_Error_Response_Invalid_Session_ID
                                  or Fld = F_Error_Response_Opaque_Error_Data
                                  or Fld = F_Error_Response_Request_Response_Code
                                  or Fld = F_Error_Response_Reserved_Error_Data
                                  or Fld = F_Error_Response_Response_Not_Ready_Data_RDTM
                                  or Fld = F_Error_Response_Zero_Error_Data
                                  or Fld = F_Measurements_Response_Opaque_Data
                                  or Fld = F_Measurements_Response_Signature
                                  or Fld = F_Version_Response_Version_Number_Entries
                               then
                                  Field_Last (Ctx, Fld) mod RFLX_Types.Byte'Size = 0));
               pragma Assert ((((Field_Last (Ctx, Fld) + RFLX_Types.Byte'Size - 1) / RFLX_Types.Byte'Size) * RFLX_Types.Byte'Size) mod RFLX_Types.Byte'Size = 0);
               Ctx.Verified_Last := ((Field_Last (Ctx, Fld) + RFLX_Types.Byte'Size - 1) / RFLX_Types.Byte'Size) * RFLX_Types.Byte'Size;
               pragma Assert (Field_Last (Ctx, Fld) <= Ctx.Verified_Last);
               if Composite_Field (Fld) then
                  Ctx.Cursors (Fld) := (State => S_Structural_Valid, First => Field_First (Ctx, Fld), Last => Field_Last (Ctx, Fld), Value => Value, Predecessor => Ctx.Cursors (Fld).Predecessor);
               else
                  Ctx.Cursors (Fld) := (State => S_Valid, First => Field_First (Ctx, Fld), Last => Field_Last (Ctx, Fld), Value => Value, Predecessor => Ctx.Cursors (Fld).Predecessor);
               end if;
               Ctx.Cursors (Successor (Ctx, Fld)) := (State => S_Invalid, Predecessor => Fld);
            else
               Ctx.Cursors (Fld) := (State => S_Invalid, Predecessor => F_Final);
            end if;
         else
            Ctx.Cursors (Fld) := (State => S_Incomplete, Predecessor => F_Final);
         end if;
      end if;
   end Verify;

   procedure Verify_Message (Ctx : in out Context) is
   begin
      for F in Field loop
         pragma Loop_Invariant (Has_Buffer (Ctx)
                                and Ctx.Buffer_First = Ctx.Buffer_First'Loop_Entry
                                and Ctx.Buffer_Last = Ctx.Buffer_Last'Loop_Entry
                                and Ctx.First = Ctx.First'Loop_Entry
                                and Ctx.Last = Ctx.Last'Loop_Entry
                                and Ctx.Hash_Length = Ctx.Hash_Length'Loop_Entry
                                and Ctx.Signature_Length = Ctx.Signature_Length'Loop_Entry
                                and Ctx.Has_Signature = Ctx.Has_Signature'Loop_Entry);
         Verify (Ctx, F);
      end loop;
   end Verify_Message;

