                      or RFLX_Types.Base_Integer (Ctx.Cursors (F_Get_Capabilities_Request_Handshake_In_The_Clear_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False)))
                 and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Get_Capabilities_Request_Handshake_In_The_Clear_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
                      or RFLX_Types.Base_Integer (Ctx.Cursors (F_Get_Capabilities_Request_Key_Ex_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
                 and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Get_Capabilities_Request_Mut_Auth_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
                      or RFLX_Types.Base_Integer (Ctx.Cursors (F_Get_Capabilities_Request_Encap_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
                 and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Get_Capabilities_Request_PSK_Cap).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.PSK_Req_Supported))
                      or RFLX_Types.Base_Integer (Ctx.Cursors (F_Get_Capabilities_Request_Encrypt_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))
                      or RFLX_Types.Base_Integer (Ctx.Cursors (F_Get_Capabilities_Request_MAC_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
                 and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Get_Capabilities_Request_Key_Ex_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
                      or RFLX_Types.Base_Integer (Ctx.Cursors (F_Get_Capabilities_Request_Encrypt_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))
                      or RFLX_Types.Base_Integer (Ctx.Cursors (F_Get_Capabilities_Request_MAC_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
                 and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Get_Capabilities_Request_Key_Ex_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))
                      or RFLX_Types.Base_Integer (Ctx.Cursors (F_Get_Capabilities_Request_Encrypt_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
                      or RFLX_Types.Base_Integer (Ctx.Cursors (F_Get_Capabilities_Request_PSK_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.PSK_Req_Supported)))
                 and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Get_Capabilities_Request_Key_Ex_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))
                      or RFLX_Types.Base_Integer (Ctx.Cursors (F_Get_Capabilities_Request_MAC_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
                      or RFLX_Types.Base_Integer (Ctx.Cursors (F_Get_Capabilities_Request_PSK_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.PSK_Req_Supported)))))
      or Valid (Ctx, F_Get_Certificate_Request_Length)
      or Valid (Ctx, F_Get_Digests_Request_Param_2)
      or (Valid (Ctx, F_Get_Measurements_Request_Measurement_Operation)
          and then RFLX_Types.Base_Integer (Ctx.Cursors (F_Get_Measurements_Request_Generate_Signature).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False)))
      or Valid (Ctx, F_Get_Measurements_Request_Slot_ID_Param)
      or Valid (Ctx, F_Get_Version_Request_Param_2)
