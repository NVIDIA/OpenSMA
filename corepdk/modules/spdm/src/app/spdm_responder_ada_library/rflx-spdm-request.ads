                  or RFLX_Types.Base_Integer (Ctx.Cursors (F_Get_Capabilities_Request_Encrypt_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))
                  or RFLX_Types.Base_Integer (Ctx.Cursors (F_Get_Capabilities_Request_MAC_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
             and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Get_Capabilities_Request_Key_Ex_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
                  or RFLX_Types.Base_Integer (Ctx.Cursors (F_Get_Capabilities_Request_Encrypt_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))
                  or RFLX_Types.Base_Integer (Ctx.Cursors (F_Get_Capabilities_Request_MAC_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
