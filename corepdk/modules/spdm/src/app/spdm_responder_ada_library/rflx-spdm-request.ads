                  or RFLX_Types.Base_Integer (Ctx.Cursors (F_Get_Capabilities_Request_PSK_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.PSK_Req_Supported))),
