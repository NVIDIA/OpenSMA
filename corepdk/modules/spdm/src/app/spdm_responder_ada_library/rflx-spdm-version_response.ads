       and then RFLX.SPDM.Version_Response.Valid_Next (Ctx, RFLX.SPDM.Version_Response.F_Version_Number_Entries)
       and then RFLX.SPDM.Version_Response.Available_Space (Ctx, RFLX.SPDM.Version_Response.F_Version_Number_Entries) >= RFLX.SPDM.Version_Response.Field_Size (Ctx, RFLX.SPDM.Version_Response.F_Version_Number_Entries)
       and then RFLX.SPDM.Version_Response.Field_Condition (Ctx, RFLX.SPDM.Version_Response.F_Version_Number_Entries)
       and then RFLX.SPDM.Version_Response.Valid_Length (Ctx, RFLX.SPDM.Version_Response.F_Version_Number_Entries, RFLX.SPDM.Version_Number_Entries.Byte_Size (Seq_Ctx))
       and then RFLX.SPDM.Version_Number_Entries.Has_Buffer (Seq_Ctx)
       and then RFLX.SPDM.Version_Number_Entries.Valid (Seq_Ctx),
     Post =>
       Has_Buffer (Ctx)
       and Structural_Valid (Ctx, F_Version_Number_Entries)
       and (if
               Structural_Valid_Message (Ctx)
            then
               Message_Last (Ctx) = Field_Last (Ctx, F_Version_Number_Entries))
       and Ctx.Buffer_First = Ctx.Buffer_First'Old
       and Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and Ctx.First = Ctx.First'Old
       and Ctx.Last = Ctx.Last'Old
       and Predecessor (Ctx, F_Version_Number_Entries) = Predecessor (Ctx, F_Version_Number_Entries)'Old
       and Valid_Next (Ctx, F_Version_Number_Entries) = Valid_Next (Ctx, F_Version_Number_Entries)'Old
       and Get_Version_Number_Entry_Count (Ctx) = Get_Version_Number_Entry_Count (Ctx)'Old
       and Field_First (Ctx, F_Version_Number_Entries) = Field_First (Ctx, F_Version_Number_Entries)'Old
       and Field_Last (Ctx, F_Version_Number_Entries) = Field_Last (Ctx, Predecessor (Ctx, F_Version_Number_Entries)) + Field_Size (Ctx, F_Version_Number_Entries)
       and (if Field_Size (Ctx, F_Version_Number_Entries) > 0 then Present (Ctx, F_Version_Number_Entries));

   procedure Initialize_Version_Number_Entries (Ctx : in out Context) with
     Pre =>
       not Ctx'Constrained
       and then RFLX.SPDM.Version_Response.Has_Buffer (Ctx)
       and then RFLX.SPDM.Version_Response.Valid_Next (Ctx, RFLX.SPDM.Version_Response.F_Version_Number_Entries)
       and then RFLX.SPDM.Version_Response.Available_Space (Ctx, RFLX.SPDM.Version_Response.F_Version_Number_Entries) >= RFLX.SPDM.Version_Response.Field_Size (Ctx, RFLX.SPDM.Version_Response.F_Version_Number_Entries),
     Post =>
       Has_Buffer (Ctx)
       and Structural_Valid (Ctx, F_Version_Number_Entries)
       and (if
               Structural_Valid_Message (Ctx)
            then
               Message_Last (Ctx) = Field_Last (Ctx, F_Version_Number_Entries))
       and Ctx.Buffer_First = Ctx.Buffer_First'Old
       and Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and Ctx.First = Ctx.First'Old
       and Ctx.Last = Ctx.Last'Old
       and Predecessor (Ctx, F_Version_Number_Entries) = Predecessor (Ctx, F_Version_Number_Entries)'Old
       and Valid_Next (Ctx, F_Version_Number_Entries) = Valid_Next (Ctx, F_Version_Number_Entries)'Old
       and Get_Version_Number_Entry_Count (Ctx) = Get_Version_Number_Entry_Count (Ctx)'Old
       and Field_First (Ctx, F_Version_Number_Entries) = Field_First (Ctx, F_Version_Number_Entries)'Old
       and Field_Last (Ctx, F_Version_Number_Entries) = Field_Last (Ctx, Predecessor (Ctx, F_Version_Number_Entries)) + Field_Size (Ctx, F_Version_Number_Entries);

   procedure Switch_To_Version_Number_Entries (Ctx : in out Context; Seq_Ctx : out RFLX.SPDM.Version_Number_Entries.Context) with
     Pre =>
       not Ctx'Constrained
       and then not Seq_Ctx'Constrained
       and then RFLX.SPDM.Version_Response.Has_Buffer (Ctx)
       and then RFLX.SPDM.Version_Response.Valid_Next (Ctx, RFLX.SPDM.Version_Response.F_Version_Number_Entries)
       and then RFLX.SPDM.Version_Response.Field_Size (Ctx, RFLX.SPDM.Version_Response.F_Version_Number_Entries) > 0
       and then RFLX.SPDM.Version_Response.Field_First (Ctx, RFLX.SPDM.Version_Response.F_Version_Number_Entries) rem RFLX_Types.Byte'Size = 1
       and then RFLX.SPDM.Version_Response.Available_Space (Ctx, RFLX.SPDM.Version_Response.F_Version_Number_Entries) >= RFLX.SPDM.Version_Response.Field_Size (Ctx, RFLX.SPDM.Version_Response.F_Version_Number_Entries)
       and then RFLX.SPDM.Version_Response.Field_Condition (Ctx, RFLX.SPDM.Version_Response.F_Version_Number_Entries),
     Post =>
       not RFLX.SPDM.Version_Response.Has_Buffer (Ctx)
       and RFLX.SPDM.Version_Number_Entries.Has_Buffer (Seq_Ctx)
       and Ctx.Buffer_First = Seq_Ctx.Buffer_First
       and Ctx.Buffer_Last = Seq_Ctx.Buffer_Last
       and Seq_Ctx.First = Field_First (Ctx, F_Version_Number_Entries)
       and Seq_Ctx.Last = Field_Last (Ctx, F_Version_Number_Entries)
       and RFLX.SPDM.Version_Number_Entries.Valid (Seq_Ctx)
       and RFLX.SPDM.Version_Number_Entries.Sequence_Last (Seq_Ctx) = Seq_Ctx.First - 1
       and Present (Ctx, F_Version_Number_Entries)
       and Ctx.Buffer_First = Ctx.Buffer_First'Old
       and Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and Ctx.First = Ctx.First'Old
       and Ctx.Last = Ctx.Last'Old
       and Predecessor (Ctx, F_Version_Number_Entries) = Predecessor (Ctx, F_Version_Number_Entries)'Old
       and Path_Condition (Ctx, F_Version_Number_Entries) = Path_Condition (Ctx, F_Version_Number_Entries)'Old
       and Field_Last (Ctx, F_Version_Number_Entries) = Field_Last (Ctx, F_Version_Number_Entries)'Old
       and (for all F in Field range F_Param_1 .. F_Version_Number_Entry_Count =>
               Context_Cursors_Index (Context_Cursors (Ctx), F) = Context_Cursors_Index (Context_Cursors (Ctx)'Old, F)),
     Contract_Cases =>
       (Structural_Valid (Ctx, F_Version_Number_Entries) =>
           True,
        others =>
           True);

   function Complete_Version_Number_Entries (Ctx : Context; Seq_Ctx : RFLX.SPDM.Version_Number_Entries.Context) return Boolean with
     Pre =>
       RFLX.SPDM.Version_Response.Valid_Next (Ctx, RFLX.SPDM.Version_Response.F_Version_Number_Entries);

   procedure Update_Version_Number_Entries (Ctx : in out Context; Seq_Ctx : in out RFLX.SPDM.Version_Number_Entries.Context) with
     Pre =>
       RFLX.SPDM.Version_Response.Present (Ctx, RFLX.SPDM.Version_Response.F_Version_Number_Entries)
       and then RFLX.SPDM.Version_Response.Complete_Version_Number_Entries (Ctx, Seq_Ctx)
       and then not RFLX.SPDM.Version_Response.Has_Buffer (Ctx)
       and then RFLX.SPDM.Version_Number_Entries.Has_Buffer (Seq_Ctx)
       and then Ctx.Buffer_First = Seq_Ctx.Buffer_First
       and then Ctx.Buffer_Last = Seq_Ctx.Buffer_Last
       and then Seq_Ctx.First = Field_First (Ctx, F_Version_Number_Entries)
       and then Seq_Ctx.Last = Field_Last (Ctx, F_Version_Number_Entries),
     Post =>
       Present (Ctx, F_Version_Number_Entries)
       and Has_Buffer (Ctx)
       and not RFLX.SPDM.Version_Number_Entries.Has_Buffer (Seq_Ctx)
       and Ctx.Buffer_First = Ctx.Buffer_First'Old
       and Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and Ctx.First = Ctx.First'Old
       and Ctx.Last = Ctx.Last'Old
       and Seq_Ctx.First = Seq_Ctx.First'Old
       and Seq_Ctx.Last = Seq_Ctx.Last'Old
       and Field_First (Ctx, F_Version_Number_Entries) = Field_First (Ctx, F_Version_Number_Entries)'Old
       and Field_Size (Ctx, F_Version_Number_Entries) = Field_Size (Ctx, F_Version_Number_Entries)'Old
       and Context_Cursor (Ctx, F_Param_1) = Context_Cursor (Ctx, F_Param_1)'Old
       and Context_Cursor (Ctx, F_Param_2) = Context_Cursor (Ctx, F_Param_2)'Old
       and Context_Cursor (Ctx, F_Reserved) = Context_Cursor (Ctx, F_Reserved)'Old
       and Context_Cursor (Ctx, F_Version_Number_Entry_Count) = Context_Cursor (Ctx, F_Version_Number_Entry_Count)'Old,
     Depends =>
       (Ctx => (Ctx, Seq_Ctx), Seq_Ctx => Seq_Ctx);

   function Context_Cursor (Ctx : Context; Fld : Field) return Field_Cursor with
     Annotate =>
       (GNATprove, Inline_For_Proof),
     Ghost;

   function Context_Cursors (Ctx : Context) return Field_Cursors with
     Annotate =>
       (GNATprove, Inline_For_Proof),
     Ghost;

   function Context_Cursors_Index (Cursors : Field_Cursors; Fld : Field) return Field_Cursor with
     Annotate =>
       (GNATprove, Inline_For_Proof),
     Ghost;

private

   type Cursor_State is (S_Valid, S_Structural_Valid, S_Invalid, S_Incomplete);

   type Field_Cursor (State : Cursor_State := S_Invalid) is
      record
         Predecessor : Virtual_Field := F_Final;
         case State is
            when S_Valid | S_Structural_Valid =>
               First : RFLX_Types.Bit_Index := RFLX_Types.Bit_Index'First;
               Last : RFLX_Types.Bit_Length := RFLX_Types.Bit_Length'First;
               Value : RFLX_Types.Base_Integer := 0;
            when S_Invalid | S_Incomplete =>
               null;
         end case;
      end record;

   type Field_Cursors is array (Virtual_Field) of Field_Cursor;

   function Structural_Valid (Cursor : Field_Cursor) return Boolean is
     (Cursor.State = S_Valid
      or Cursor.State = S_Structural_Valid);

   function Valid (Cursor : Field_Cursor) return Boolean is
     (Cursor.State = S_Valid);

   function Invalid (Cursor : Field_Cursor) return Boolean is
     (Cursor.State = S_Invalid
      or Cursor.State = S_Incomplete);

   pragma Warnings (Off, """Buffer"" is not modified, could be of access constant type");

   pragma Warnings (Off, "postcondition does not mention function result");

   function Valid_Context (Buffer_First, Buffer_Last : RFLX_Types.Index; First : RFLX_Types.Bit_Index; Last : RFLX_Types.Bit_Length; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length; Buffer : RFLX_Types.Bytes_Ptr; Cursors : Field_Cursors) return Boolean is
     ((if Buffer /= null then Buffer'First = Buffer_First and Buffer'Last = Buffer_Last)
      and then (RFLX_Types.To_Index (First) >= Buffer_First
                and RFLX_Types.To_Index (Last) <= Buffer_Last
                and Buffer_Last < RFLX_Types.Index'Last
                and First <= Last + 1
                and Last < RFLX_Types.Bit_Index'Last
                and First rem RFLX_Types.Byte'Size = 1
                and Last rem RFLX_Types.Byte'Size = 0)
      and then First - 1 <= Verified_Last
      and then First - 1 <= Written_Last
      and then Verified_Last <= Written_Last
      and then Written_Last <= Last
      and then First rem RFLX_Types.Byte'Size = 1
      and then Last rem RFLX_Types.Byte'Size = 0
      and then Verified_Last rem RFLX_Types.Byte'Size = 0
      and then Written_Last rem RFLX_Types.Byte'Size = 0
      and then (for all F in Field =>
                   (if
                       Structural_Valid (Cursors (F))
                    then
                       Cursors (F).First >= First
                       and Cursors (F).Last <= Verified_Last
                       and Cursors (F).First <= Cursors (F).Last + 1
                       and Valid_Value (F, Cursors (F).Value)))
      and then ((if
                    Structural_Valid (Cursors (F_Param_2))
                 then
                    (Valid (Cursors (F_Param_1))
                     and then Cursors (F_Param_2).Predecessor = F_Param_1))
                and then (if
                             Structural_Valid (Cursors (F_Reserved))
                          then
                             (Valid (Cursors (F_Param_2))
                              and then Cursors (F_Reserved).Predecessor = F_Param_2))
                and then (if
                             Structural_Valid (Cursors (F_Version_Number_Entry_Count))
                          then
                             (Valid (Cursors (F_Reserved))
                              and then Cursors (F_Version_Number_Entry_Count).Predecessor = F_Reserved))
                and then (if
                             Structural_Valid (Cursors (F_Version_Number_Entries))
                          then
                             (Valid (Cursors (F_Version_Number_Entry_Count))
                              and then Cursors (F_Version_Number_Entries).Predecessor = F_Version_Number_Entry_Count)))
      and then ((if Invalid (Cursors (F_Param_1)) then Invalid (Cursors (F_Param_2)))
                and then (if Invalid (Cursors (F_Param_2)) then Invalid (Cursors (F_Reserved)))
                and then (if Invalid (Cursors (F_Reserved)) then Invalid (Cursors (F_Version_Number_Entry_Count)))
                and then (if
                             Invalid (Cursors (F_Version_Number_Entry_Count))
                          then
                             Invalid (Cursors (F_Version_Number_Entries))))
      and then (if
                   Structural_Valid (Cursors (F_Param_1))
                then
                   Cursors (F_Param_1).Last - Cursors (F_Param_1).First + 1 = 8
                   and then Cursors (F_Param_1).Predecessor = F_Initial
                   and then Cursors (F_Param_1).First = First
                   and then (if
                                Structural_Valid (Cursors (F_Param_2))
                             then
                                Cursors (F_Param_2).Last - Cursors (F_Param_2).First + 1 = 8
                                and then Cursors (F_Param_2).Predecessor = F_Param_1
                                and then Cursors (F_Param_2).First = Cursors (F_Param_1).Last + 1
                                and then (if
                                             Structural_Valid (Cursors (F_Reserved))
                                          then
                                             Cursors (F_Reserved).Last - Cursors (F_Reserved).First + 1 = 8
                                             and then Cursors (F_Reserved).Predecessor = F_Param_2
                                             and then Cursors (F_Reserved).First = Cursors (F_Param_2).Last + 1
                                             and then (if
                                                          Structural_Valid (Cursors (F_Version_Number_Entry_Count))
                                                       then
                                                          Cursors (F_Version_Number_Entry_Count).Last - Cursors (F_Version_Number_Entry_Count).First + 1 = 8
                                                          and then Cursors (F_Version_Number_Entry_Count).Predecessor = F_Reserved
                                                          and then Cursors (F_Version_Number_Entry_Count).First = Cursors (F_Reserved).Last + 1
                                                          and then (if
                                                                       Structural_Valid (Cursors (F_Version_Number_Entries))
                                                                    then
                                                                       Cursors (F_Version_Number_Entries).Last - Cursors (F_Version_Number_Entries).First + 1 = RFLX_Types.Bit_Length (Cursors (F_Version_Number_Entry_Count).Value) * 16
                                                                       and then Cursors (F_Version_Number_Entries).Predecessor = F_Version_Number_Entry_Count
                                                                       and then Cursors (F_Version_Number_Entries).First = Cursors (F_Version_Number_Entry_Count).Last + 1))))));

   pragma Warnings (On, """Buffer"" is not modified, could be of access constant type");

   pragma Warnings (On, "postcondition does not mention function result");

   type Context (Buffer_First, Buffer_Last : RFLX_Types.Index := RFLX_Types.Index'First; First : RFLX_Types.Bit_Index := RFLX_Types.Bit_Index'First; Last : RFLX_Types.Bit_Length := RFLX_Types.Bit_Length'First) is
      record
         Verified_Last : RFLX_Types.Bit_Length := First - 1;
         Written_Last : RFLX_Types.Bit_Length := First - 1;
         Buffer : RFLX_Types.Bytes_Ptr := null;
         Cursors : Field_Cursors := [others => (State => S_Invalid, Predecessor => F_Final)];
      end record with
     Dynamic_Predicate =>
       Valid_Context (Context.Buffer_First, Context.Buffer_Last, Context.First, Context.Last, Context.Verified_Last, Context.Written_Last, Context.Buffer, Context.Cursors);

   function Initialized (Ctx : Context) return Boolean is
     (Ctx.Verified_Last = Ctx.First - 1
      and then Valid_Next (Ctx, F_Param_1)
      and then RFLX.SPDM.Version_Response.Field_First (Ctx, RFLX.SPDM.Version_Response.F_Param_1) rem RFLX_Types.Byte'Size = 1
      and then Available_Space (Ctx, F_Param_1) = Ctx.Last - Ctx.First + 1
      and then (for all F in Field =>
                   Invalid (Ctx, F)));

   function Has_Buffer (Ctx : Context) return Boolean is
     (Ctx.Buffer /= null);

   function Buffer_Length (Ctx : Context) return RFLX_Types.Length is
     (Ctx.Buffer'Length);

   function Size (Ctx : Context) return RFLX_Types.Bit_Length is
     (Ctx.Verified_Last - Ctx.First + 1);

   function Byte_Size (Ctx : Context) return RFLX_Types.Length is
     (RFLX_Types.To_Length (Size (Ctx)));

   function Message_Last (Ctx : Context) return RFLX_Types.Bit_Length is
     (Ctx.Verified_Last);

   function Written_Last (Ctx : Context) return RFLX_Types.Bit_Length is
     (Ctx.Written_Last);

   function Valid_Value (Fld : Field; Val : RFLX_Types.Base_Integer) return Boolean is
     ((case Fld is
          when F_Param_1 | F_Param_2 | F_Reserved =>
             RFLX.SPDM.Valid_Reserved_8 (Val),
          when F_Version_Number_Entry_Count =>
             RFLX.SPDM.Valid_Version_Number_Entry_Count (Val),
          when F_Version_Number_Entries =>
             True));

   function Path_Condition (Ctx : Context; Fld : Field) return Boolean is
     (True);

   function Field_Condition (Ctx : Context; Fld : Field) return Boolean is
     ((case Fld is
          when F_Param_1 | F_Param_2 | F_Reserved | F_Version_Number_Entry_Count | F_Version_Number_Entries =>
             True));

   function Field_Size (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Length is
     ((case Fld is
          when F_Param_1 | F_Param_2 | F_Reserved | F_Version_Number_Entry_Count =>
             8,
          when F_Version_Number_Entries =>
             RFLX_Types.Bit_Length (Ctx.Cursors (F_Version_Number_Entry_Count).Value) * 16));

   function Field_First (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Index is
     ((if Fld = F_Param_1 then Ctx.First else Ctx.Cursors (Ctx.Cursors (Fld).Predecessor).Last + 1));

   function Field_Last (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Length is
     (Field_First (Ctx, Fld) + Field_Size (Ctx, Fld) - 1);

   function Predecessor (Ctx : Context; Fld : Virtual_Field) return Virtual_Field is
     ((case Fld is
          when F_Initial =>
             F_Initial,
          when others =>
             Ctx.Cursors (Fld).Predecessor));

   function Valid_Predecessor (Ctx : Context; Fld : Virtual_Field) return Boolean is
     ((case Fld is
          when F_Initial =>
             True,
          when F_Param_1 =>
             Ctx.Cursors (Fld).Predecessor = F_Initial,
          when F_Param_2 =>
             (Valid (Ctx.Cursors (F_Param_1))
              and Ctx.Cursors (Fld).Predecessor = F_Param_1),
          when F_Reserved =>
             (Valid (Ctx.Cursors (F_Param_2))
              and Ctx.Cursors (Fld).Predecessor = F_Param_2),
          when F_Version_Number_Entry_Count =>
             (Valid (Ctx.Cursors (F_Reserved))
              and Ctx.Cursors (Fld).Predecessor = F_Reserved),
          when F_Version_Number_Entries =>
             (Valid (Ctx.Cursors (F_Version_Number_Entry_Count))
              and Ctx.Cursors (Fld).Predecessor = F_Version_Number_Entry_Count),
          when F_Final =>
             (Structural_Valid (Ctx.Cursors (F_Version_Number_Entries))
              and Ctx.Cursors (Fld).Predecessor = F_Version_Number_Entries)));

   function Valid_Next (Ctx : Context; Fld : Field) return Boolean is
     (Valid_Predecessor (Ctx, Fld)
      and then Path_Condition (Ctx, Fld));

   function Available_Space (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Length is
     (Ctx.Last - Field_First (Ctx, Fld) + 1);

   function Sufficient_Space (Ctx : Context; Fld : Field) return Boolean is
     (Available_Space (Ctx, Fld) >= Field_Size (Ctx, Fld));

   function Present (Ctx : Context; Fld : Field) return Boolean is
     (Structural_Valid (Ctx.Cursors (Fld))
      and then Ctx.Cursors (Fld).First < Ctx.Cursors (Fld).Last + 1);

   function Structural_Valid (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Valid
      or Ctx.Cursors (Fld).State = S_Structural_Valid);

   function Valid (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Valid
      and then Ctx.Cursors (Fld).First < Ctx.Cursors (Fld).Last + 1);

   function Incomplete (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Incomplete);

   function Invalid (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Invalid
      or Ctx.Cursors (Fld).State = S_Incomplete);

   function Structural_Valid_Message (Ctx : Context) return Boolean is
     (Structural_Valid (Ctx, F_Version_Number_Entries));

   function Valid_Message (Ctx : Context) return Boolean is
     (Valid (Ctx, F_Version_Number_Entries));

   function Incomplete_Message (Ctx : Context) return Boolean is
     ((for some F in Field =>
          Incomplete (Ctx, F)));

   function Get_Param_1 (Ctx : Context) return RFLX.SPDM.Reserved_8 is
     (To_Actual (Ctx.Cursors (F_Param_1).Value));

   function Get_Param_2 (Ctx : Context) return RFLX.SPDM.Reserved_8 is
     (To_Actual (Ctx.Cursors (F_Param_2).Value));

   function Get_Reserved (Ctx : Context) return RFLX.SPDM.Reserved_8 is
     (To_Actual (Ctx.Cursors (F_Reserved).Value));

   function Get_Version_Number_Entry_Count (Ctx : Context) return RFLX.SPDM.Version_Number_Entry_Count is
     (To_Actual (Ctx.Cursors (F_Version_Number_Entry_Count).Value));

   function Valid_Size (Ctx : Context; Fld : Field; Size : RFLX_Types.Bit_Length) return Boolean is
     (Size = Field_Size (Ctx, Fld))
    with
     Pre =>
       RFLX.SPDM.Version_Response.Valid_Next (Ctx, Fld);

   function Valid_Length (Ctx : Context; Fld : Field; Length : RFLX_Types.Length) return Boolean is
     (Valid_Size (Ctx, Fld, RFLX_Types.To_Bit_Length (Length)));

   function Complete_Version_Number_Entries (Ctx : Context; Seq_Ctx : RFLX.SPDM.Version_Number_Entries.Context) return Boolean is
     (RFLX.SPDM.Version_Number_Entries.Valid (Seq_Ctx)
      and RFLX.SPDM.Version_Number_Entries.Size (Seq_Ctx) = Field_Size (Ctx, F_Version_Number_Entries));

   function Context_Cursor (Ctx : Context; Fld : Field) return Field_Cursor is
     (Ctx.Cursors (Fld));

   function Context_Cursors (Ctx : Context) return Field_Cursors is
     (Ctx.Cursors);

   function Context_Cursors_Index (Cursors : Field_Cursors; Fld : Field) return Field_Cursor is
     (Cursors (Fld));

end RFLX.SPDM.Version_Response;
