              then
                 F_Request_Response_Code
              elsif
                 RFLX_Types.Base_Integer (Ctx.Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Session_Limit_Exceeded))
                 or RFLX_Types.Base_Integer (Ctx.Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Invalid_Response_Code))
                 or RFLX_Types.Base_Integer (Ctx.Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Decrypt_Error))
                 or RFLX_Types.Base_Integer (Ctx.Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Request_In_Flight))
              then
                 F_Reserved_Error_Data
              elsif
                 RFLX_Types.Base_Integer (Ctx.Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Request_Resynch))
                 or RFLX_Types.Base_Integer (Ctx.Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Response_Not_Ready))
                 or RFLX_Types.Base_Integer (Ctx.Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Major_Version_Mismatch))
                 or RFLX_Types.Base_Integer (Ctx.Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Unspecified))
                 or RFLX_Types.Base_Integer (Ctx.Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Unexpected_Request))
                 or RFLX_Types.Base_Integer (Ctx.Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Invalid_Request))
