   procedure Set_Opaque_Error_Data_Empty (Ctx : in out Context) is
      Unused_Buffer_First, Unused_Buffer_Last : RFLX_Types.Index;
      Unused_Offset : RFLX_Types.Offset;
   begin
      Set (Ctx, F_Opaque_Error_Data, 0, 0, True, Unused_Buffer_First, Unused_Buffer_Last, Unused_Offset);
   end Set_Opaque_Error_Data_Empty;

   procedure Initialize_Opaque_Error_Data_Private (Ctx : in out Context; Length : RFLX_Types.Length) with
     Pre =>
       not Ctx'Constrained
       and then RFLX.SPDM.Error_Response.Has_Buffer (Ctx)
       and then RFLX.SPDM.Error_Response.Valid_Next (Ctx, RFLX.SPDM.Error_Response.F_Opaque_Error_Data)
       and then RFLX.SPDM.Error_Response.Valid_Length (Ctx, RFLX.SPDM.Error_Response.F_Opaque_Error_Data, Length)
       and then RFLX_Types.To_Length (RFLX.SPDM.Error_Response.Available_Space (Ctx, RFLX.SPDM.Error_Response.F_Opaque_Error_Data)) >= Length
       and then RFLX.SPDM.Error_Response.Field_First (Ctx, RFLX.SPDM.Error_Response.F_Opaque_Error_Data) mod RFLX_Types.Byte'Size = 1,
     Post =>
       Has_Buffer (Ctx)
       and Structural_Valid (Ctx, F_Opaque_Error_Data)
       and Field_Size (Ctx, F_Opaque_Error_Data) = RFLX_Types.To_Bit_Length (Length)
       and Ctx.Verified_Last = Field_Last (Ctx, F_Opaque_Error_Data)
       and Invalid (Ctx, F_Response_Not_Ready_Data_Token)
       and Invalid (Ctx, F_Response_Not_Ready_Data_RDTM)
       and Ctx.Buffer_First = Ctx.Buffer_First'Old
       and Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and Ctx.First = Ctx.First'Old
       and Ctx.Last = Ctx.Last'Old
       and Predecessor (Ctx, F_Opaque_Error_Data) = Predecessor (Ctx, F_Opaque_Error_Data)'Old
       and Valid_Next (Ctx, F_Opaque_Error_Data) = Valid_Next (Ctx, F_Opaque_Error_Data)'Old
       and Get_Error_Code (Ctx) = Get_Error_Code (Ctx)'Old
       and Get_Registry_ID (Ctx) = Get_Registry_ID (Ctx)'Old
       and Get_Vendor_ID_Len (Ctx) = Get_Vendor_ID_Len (Ctx)'Old
       and Field_First (Ctx, F_Opaque_Error_Data) = Field_First (Ctx, F_Opaque_Error_Data)'Old
       and Field_Last (Ctx, F_Opaque_Error_Data) = Field_Last (Ctx, Predecessor (Ctx, F_Opaque_Error_Data)) + Field_Size (Ctx, F_Opaque_Error_Data)
   is
      First : constant RFLX_Types.Bit_Index := Field_First (Ctx, F_Opaque_Error_Data);
      Last : constant RFLX_Types.Bit_Index := Field_First (Ctx, F_Opaque_Error_Data) + RFLX_Types.Bit_Length (Length) * RFLX_Types.Byte'Size - 1;
   begin
      pragma Assert (Last mod RFLX_Types.Byte'Size = 0);
      Reset_Dependent_Fields (Ctx, F_Opaque_Error_Data);
      pragma Warnings (Off, "attribute Update is an obsolescent feature");
      Ctx := Ctx'Update (Verified_Last => Last, Written_Last => Last);
      pragma Warnings (On, "attribute Update is an obsolescent feature");
      Ctx.Cursors (F_Opaque_Error_Data) := (State => S_Structural_Valid, First => First, Last => Last, Value => 0, Predecessor => Ctx.Cursors (F_Opaque_Error_Data).Predecessor);
      Ctx.Cursors (Successor (Ctx, F_Opaque_Error_Data)) := (State => S_Invalid, Predecessor => F_Opaque_Error_Data);
   end Initialize_Opaque_Error_Data_Private;

   procedure Initialize_Opaque_Error_Data (Ctx : in out Context; Length : RFLX_Types.Length) is
   begin
      Initialize_Opaque_Error_Data_Private (Ctx, Length);
   end Initialize_Opaque_Error_Data;

   procedure Set_Opaque_Error_Data (Ctx : in out Context; Data : RFLX_Types.Bytes) is
      Buffer_First : constant RFLX_Types.Index := RFLX_Types.To_Index (Field_First (Ctx, F_Opaque_Error_Data));
      Buffer_Last : constant RFLX_Types.Index := Buffer_First + Data'Length - 1;
   begin
      Initialize_Opaque_Error_Data_Private (Ctx, Data'Length);
      pragma Assert (Buffer_Last = RFLX_Types.To_Index (Field_Last (Ctx, F_Opaque_Error_Data)));
      Ctx.Buffer.all (Buffer_First .. Buffer_Last) := Data;
      pragma Assert (Ctx.Buffer.all (RFLX_Types.To_Index (Field_First (Ctx, F_Opaque_Error_Data)) .. RFLX_Types.To_Index (Field_Last (Ctx, F_Opaque_Error_Data))) = Data);
   end Set_Opaque_Error_Data;

   procedure Generic_Set_Opaque_Error_Data (Ctx : in out Context; Length : RFLX_Types.Length) is
      First : constant RFLX_Types.Bit_Index := Field_First (Ctx, F_Opaque_Error_Data);
      Buffer_First : constant RFLX_Types.Index := RFLX_Types.To_Index (First);
      Buffer_Last : constant RFLX_Types.Index := RFLX_Types.To_Index (First + RFLX_Types.To_Bit_Length (Length) - 1);
   begin
      Process_Opaque_Error_Data (Ctx.Buffer.all (Buffer_First .. Buffer_Last));
      Initialize_Opaque_Error_Data_Private (Ctx, Length);
   end Generic_Set_Opaque_Error_Data;

end RFLX.SPDM.Error_Response;
