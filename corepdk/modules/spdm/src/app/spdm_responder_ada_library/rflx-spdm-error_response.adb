              elsif
                 Ctx.Cursors (F_Vendor_ID_Len).Value = 4
                 and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_IANA))
