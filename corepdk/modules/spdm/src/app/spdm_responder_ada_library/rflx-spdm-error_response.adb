                            then
                               Predecessor (Ctx, F_Registry_ID) = F_Error_Code
                               and Valid_Next (Ctx, F_Registry_ID))
                       and (if
                               RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Unsupported_Request))
                            then
                               Predecessor (Ctx, F_Request_Response_Code) = F_Error_Code
                               and Valid_Next (Ctx, F_Request_Response_Code))
                       and (if
                               RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Session_Limit_Exceeded))
                               or RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Invalid_Response_Code))
                               or RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Decrypt_Error))
                               or RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Request_In_Flight))
                            then
                               Predecessor (Ctx, F_Reserved_Error_Data) = F_Error_Code
                               and Valid_Next (Ctx, F_Reserved_Error_Data))
                       and (if
                               RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Request_Resynch))
                               or RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Response_Not_Ready))
                               or RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Major_Version_Mismatch))
                               or RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Unspecified))
                               or RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Unexpected_Request))
                               or RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Invalid_Request))
                               or RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Busy))
                            then
                               Predecessor (Ctx, F_Zero_Error_Data) = F_Error_Code
                               and Valid_Next (Ctx, F_Zero_Error_Data)),
                    when F_Invalid_Session_ID =>
                       Get_Invalid_Session_ID (Ctx) = To_Actual (Val)
                       and (if Structural_Valid_Message (Ctx) then Message_Last (Ctx) = Field_Last (Ctx, Fld)),
                    when F_Registry_ID =>
                       Get_Registry_ID (Ctx) = To_Actual (Val)
                       and (Predecessor (Ctx, F_Vendor_ID_Len) = F_Registry_ID
                            and Valid_Next (Ctx, F_Vendor_ID_Len)),
                    when F_Request_Response_Code =>
                       Get_Request_Response_Code (Ctx) = To_Actual (Val)
                       and (if Structural_Valid_Message (Ctx) then Message_Last (Ctx) = Field_Last (Ctx, Fld)),
                    when F_Reserved_Error_Data =>
                       (if Structural_Valid_Message (Ctx) then Message_Last (Ctx) = Field_Last (Ctx, Fld)),
                    when F_Zero_Error_Data =>
                       (if
                           RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Response_Not_Ready))
                        then
                           Predecessor (Ctx, F_Response_Not_Ready_Data_RDT_Exponent) = F_Zero_Error_Data
                           and Valid_Next (Ctx, F_Response_Not_Ready_Data_RDT_Exponent))
                       and (if Structural_Valid_Message (Ctx) then Message_Last (Ctx) = Field_Last (Ctx, Fld)),
                    when F_Vendor_ID_Len =>
                       Get_Vendor_ID_Len (Ctx) = To_Actual (Val)
                       and (if
                               Get_Vendor_ID_Len (Ctx) = 0
                               and RFLX_Types.Base_Integer (To_Base_Integer (Get_Registry_ID (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_DMTF))
                            then
                               Predecessor (Ctx, F_Opaque_Error_Data) = F_Vendor_ID_Len
                               and Valid_Next (Ctx, F_Opaque_Error_Data))
                       and (if
                               Get_Vendor_ID_Len (Ctx) = 2
                               and (RFLX_Types.Base_Integer (To_Base_Integer (Get_Registry_ID (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_JEDEC))
                                    or RFLX_Types.Base_Integer (To_Base_Integer (Get_Registry_ID (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_CXL))
                                    or RFLX_Types.Base_Integer (To_Base_Integer (Get_Registry_ID (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_MIPI))
                                    or RFLX_Types.Base_Integer (To_Base_Integer (Get_Registry_ID (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_PCI_SIG))
                                    or RFLX_Types.Base_Integer (To_Base_Integer (Get_Registry_ID (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_TCG))
                                    or RFLX_Types.Base_Integer (To_Base_Integer (Get_Registry_ID (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_USB)))
                            then
                               Predecessor (Ctx, F_Vendor_ID_Double) = F_Vendor_ID_Len
                               and Valid_Next (Ctx, F_Vendor_ID_Double))
                       and (if
                               Get_Vendor_ID_Len (Ctx) = 4
                               and (RFLX_Types.Base_Integer (To_Base_Integer (Get_Registry_ID (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_IANA))
                                    or RFLX_Types.Base_Integer (To_Base_Integer (Get_Registry_ID (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_HD_Base_T)))
                            then
                               Predecessor (Ctx, F_Vendor_ID_Quad) = F_Vendor_ID_Len
                               and Valid_Next (Ctx, F_Vendor_ID_Quad)),
                    when F_Response_Not_Ready_Data_RDT_Exponent =>
                       Get_Response_Not_Ready_Data_RDT_Exponent (Ctx) = To_Actual (Val)
                       and (Predecessor (Ctx, F_Response_Not_Ready_Data_Request_Code) = F_Response_Not_Ready_Data_RDT_Exponent
                            and Valid_Next (Ctx, F_Response_Not_Ready_Data_Request_Code)),
                    when F_Vendor_ID_Double =>
                       Get_Vendor_ID_Double (Ctx) = To_Actual (Val)
                       and (Predecessor (Ctx, F_Opaque_Error_Data) = F_Vendor_ID_Double
                            and Valid_Next (Ctx, F_Opaque_Error_Data)),
                    when F_Vendor_ID_Quad =>
                       Get_Vendor_ID_Quad (Ctx) = To_Actual (Val)
                       and (Predecessor (Ctx, F_Opaque_Error_Data) = F_Vendor_ID_Quad
                            and Valid_Next (Ctx, F_Opaque_Error_Data)),
                    when F_Response_Not_Ready_Data_Request_Code =>
                       Get_Response_Not_Ready_Data_Request_Code (Ctx) = To_Actual (Val)
                       and (Predecessor (Ctx, F_Response_Not_Ready_Data_Token) = F_Response_Not_Ready_Data_Request_Code
                            and Valid_Next (Ctx, F_Response_Not_Ready_Data_Token)),
                    when F_Opaque_Error_Data =>
                       (if Structural_Valid_Message (Ctx) then Message_Last (Ctx) = Field_Last (Ctx, Fld)),
                    when F_Response_Not_Ready_Data_Token =>
                       Get_Response_Not_Ready_Data_Token (Ctx) = To_Actual (Val)
                       and (Predecessor (Ctx, F_Response_Not_Ready_Data_RDTM) = F_Response_Not_Ready_Data_Token
                            and Valid_Next (Ctx, F_Response_Not_Ready_Data_RDTM)),
                    when F_Response_Not_Ready_Data_RDTM =>
                       Get_Response_Not_Ready_Data_RDTM (Ctx) = To_Actual (Val)
                       and (if Structural_Valid_Message (Ctx) then Message_Last (Ctx) = Field_Last (Ctx, Fld)))
       and then (for all F in Field =>
                    (if F < Fld then Ctx.Cursors (F) = Ctx.Cursors'Old (F)))
   is
      First : RFLX_Types.Bit_Index;
      Last : RFLX_Types.Bit_Length;
   begin
      Reset_Dependent_Fields (Ctx, Fld);
      First := Field_First (Ctx, Fld);
      Last := Field_First (Ctx, Fld) + Size - 1;
      Offset := RFLX_Types.Offset ((RFLX_Types.Byte'Size - Last mod RFLX_Types.Byte'Size) mod RFLX_Types.Byte'Size);
      Buffer_First := RFLX_Types.To_Index (First);
      Buffer_Last := RFLX_Types.To_Index (Last);
      pragma Assert ((((Last + RFLX_Types.Byte'Size - 1) / RFLX_Types.Byte'Size) * RFLX_Types.Byte'Size) mod RFLX_Types.Byte'Size = 0);
      pragma Warnings (Off, "attribute Update is an obsolescent feature");
      Ctx := Ctx'Update (Verified_Last => ((Last + RFLX_Types.Byte'Size - 1) / RFLX_Types.Byte'Size) * RFLX_Types.Byte'Size, Written_Last => ((Last + RFLX_Types.Byte'Size - 1) / RFLX_Types.Byte'Size) * RFLX_Types.Byte'Size);
      pragma Warnings (On, "attribute Update is an obsolescent feature");
      pragma Assert (Size = (case Fld is
                         when F_Error_Code | F_Invalid_Session_ID | F_Registry_ID | F_Request_Response_Code | F_Reserved_Error_Data | F_Zero_Error_Data | F_Vendor_ID_Len | F_Response_Not_Ready_Data_RDT_Exponent =>
                            8,
                         when F_Vendor_ID_Double =>
                            16,
                         when F_Vendor_ID_Quad =>
                            32,
                         when F_Response_Not_Ready_Data_Request_Code =>
                            8,
                         when F_Opaque_Error_Data =>
                            (if
                                Ctx.Cursors (Fld).Predecessor = F_Vendor_ID_Double
                             then
                                RFLX_Types.Bit_Length (Ctx.Written_Last) - RFLX_Types.Bit_Length (Ctx.Cursors (F_Vendor_ID_Double).Last)
                             elsif
                                Ctx.Cursors (Fld).Predecessor = F_Vendor_ID_Len
                                and then (Ctx.Cursors (F_Vendor_ID_Len).Value = 0
                                          and RFLX_Types.Bit_Length (Ctx.Cursors (F_Registry_ID).Value) = RFLX_Types.Bit_Length (To_Base_Integer (RFLX.SPDM.Reg_DMTF)))
                             then
                                RFLX_Types.Bit_Length (Ctx.Written_Last) - RFLX_Types.Bit_Length (Ctx.Cursors (F_Vendor_ID_Len).Last)
                             elsif
                                Ctx.Cursors (Fld).Predecessor = F_Vendor_ID_Quad
                             then
                                RFLX_Types.Bit_Length (Ctx.Written_Last) - RFLX_Types.Bit_Length (Ctx.Cursors (F_Vendor_ID_Quad).Last)
                             else
                                RFLX_Types.Unreachable),
                         when F_Response_Not_Ready_Data_Token | F_Response_Not_Ready_Data_RDTM =>
                            8));
      if State_Valid then
         Ctx.Cursors (Fld) := (State => S_Valid, First => First, Last => Last, Value => Val, Predecessor => Ctx.Cursors (Fld).Predecessor);
      else
         Ctx.Cursors (Fld) := (State => S_Structural_Valid, First => First, Last => Last, Value => Val, Predecessor => Ctx.Cursors (Fld).Predecessor);
      end if;
      Ctx.Cursors (Successor (Ctx, Fld)) := (State => S_Invalid, Predecessor => Fld);
      pragma Assert (Last = (Field_First (Ctx, Fld) + Size) - 1);
   end Set;

   procedure Set_Scalar (Ctx : in out Context; Fld : Field; Val : RFLX_Types.Base_Integer) with
     Pre =>
       not Ctx'Constrained
       and then RFLX.SPDM.Error_Response.Has_Buffer (Ctx)
       and then RFLX.SPDM.Error_Response.Valid_Next (Ctx, Fld)
       and then Fld in F_Error_Code | F_Invalid_Session_ID | F_Registry_ID | F_Request_Response_Code | F_Reserved_Error_Data | F_Zero_Error_Data | F_Vendor_ID_Len | F_Response_Not_Ready_Data_RDT_Exponent | F_Vendor_ID_Double | F_Vendor_ID_Quad | F_Response_Not_Ready_Data_Request_Code | F_Response_Not_Ready_Data_Token | F_Response_Not_Ready_Data_RDTM
       and then RFLX.SPDM.Error_Response.Valid_Value (Fld, Val)
       and then RFLX.SPDM.Error_Response.Valid_Size (Ctx, Fld, RFLX.SPDM.Error_Response.Field_Size (Ctx, Fld))
       and then RFLX.SPDM.Error_Response.Available_Space (Ctx, Fld) >= RFLX.SPDM.Error_Response.Field_Size (Ctx, Fld)
       and then RFLX.SPDM.Error_Response.Field_Size (Ctx, Fld) in 1 .. RFLX_Types.Base_Integer'Size
       and then RFLX_Types.Fits_Into (Val, Natural (RFLX.SPDM.Error_Response.Field_Size (Ctx, Fld))),
     Post =>
       Has_Buffer (Ctx)
       and Valid (Ctx, Fld)
       and Invalid_Successor (Ctx, Fld)
       and (case Fld is
               when F_Error_Code =>
                  Get_Error_Code (Ctx) = To_Actual (Val)
                  and (if
                          RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Invalid_Session))
                       then
                          Predecessor (Ctx, F_Invalid_Session_ID) = F_Error_Code
                          and Valid_Next (Ctx, F_Invalid_Session_ID))
                  and (if
                          RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Vendor))
                       then
                          Predecessor (Ctx, F_Registry_ID) = F_Error_Code
                          and Valid_Next (Ctx, F_Registry_ID))
                  and (if
                          RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Unsupported_Request))
                       then
                          Predecessor (Ctx, F_Request_Response_Code) = F_Error_Code
                          and Valid_Next (Ctx, F_Request_Response_Code))
                  and (if
                          RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Session_Limit_Exceeded))
                          or RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Invalid_Response_Code))
                          or RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Decrypt_Error))
                          or RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Request_In_Flight))
                       then
                          Predecessor (Ctx, F_Reserved_Error_Data) = F_Error_Code
                          and Valid_Next (Ctx, F_Reserved_Error_Data))
                  and (if
                          RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Request_Resynch))
                          or RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Response_Not_Ready))
                          or RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Major_Version_Mismatch))
                          or RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Unspecified))
                          or RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Unexpected_Request))
                          or RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Invalid_Request))
                          or RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Busy))
                       then
                          Predecessor (Ctx, F_Zero_Error_Data) = F_Error_Code
                          and Valid_Next (Ctx, F_Zero_Error_Data)),
               when F_Invalid_Session_ID =>
                  Get_Invalid_Session_ID (Ctx) = To_Actual (Val)
                  and (if Structural_Valid_Message (Ctx) then Message_Last (Ctx) = Field_Last (Ctx, Fld)),
               when F_Registry_ID =>
                  Get_Registry_ID (Ctx) = To_Actual (Val)
                  and (Predecessor (Ctx, F_Vendor_ID_Len) = F_Registry_ID
                       and Valid_Next (Ctx, F_Vendor_ID_Len)),
               when F_Request_Response_Code =>
                  Get_Request_Response_Code (Ctx) = To_Actual (Val)
                  and (if Structural_Valid_Message (Ctx) then Message_Last (Ctx) = Field_Last (Ctx, Fld)),
               when F_Reserved_Error_Data =>
                  (if Structural_Valid_Message (Ctx) then Message_Last (Ctx) = Field_Last (Ctx, Fld)),
               when F_Zero_Error_Data =>
                  (if
                      RFLX_Types.Base_Integer (To_Base_Integer (Get_Error_Code (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Response_Not_Ready))
                   then
                      Predecessor (Ctx, F_Response_Not_Ready_Data_RDT_Exponent) = F_Zero_Error_Data
                      and Valid_Next (Ctx, F_Response_Not_Ready_Data_RDT_Exponent))
                  and (if Structural_Valid_Message (Ctx) then Message_Last (Ctx) = Field_Last (Ctx, Fld)),
               when F_Vendor_ID_Len =>
                  Get_Vendor_ID_Len (Ctx) = To_Actual (Val)
                  and (if
                          Get_Vendor_ID_Len (Ctx) = 0
                          and RFLX_Types.Base_Integer (To_Base_Integer (Get_Registry_ID (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_DMTF))
                       then
                          Predecessor (Ctx, F_Opaque_Error_Data) = F_Vendor_ID_Len
                          and Valid_Next (Ctx, F_Opaque_Error_Data))
                  and (if
                          Get_Vendor_ID_Len (Ctx) = 2
                          and (RFLX_Types.Base_Integer (To_Base_Integer (Get_Registry_ID (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_JEDEC))
                               or RFLX_Types.Base_Integer (To_Base_Integer (Get_Registry_ID (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_CXL))
                               or RFLX_Types.Base_Integer (To_Base_Integer (Get_Registry_ID (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_MIPI))
                               or RFLX_Types.Base_Integer (To_Base_Integer (Get_Registry_ID (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_PCI_SIG))
                               or RFLX_Types.Base_Integer (To_Base_Integer (Get_Registry_ID (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_TCG))
                               or RFLX_Types.Base_Integer (To_Base_Integer (Get_Registry_ID (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_USB)))
                       then
                          Predecessor (Ctx, F_Vendor_ID_Double) = F_Vendor_ID_Len
                          and Valid_Next (Ctx, F_Vendor_ID_Double))
                  and (if
                          Get_Vendor_ID_Len (Ctx) = 4
                          and (RFLX_Types.Base_Integer (To_Base_Integer (Get_Registry_ID (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_IANA))
                               or RFLX_Types.Base_Integer (To_Base_Integer (Get_Registry_ID (Ctx))) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_HD_Base_T)))
                       then
                          Predecessor (Ctx, F_Vendor_ID_Quad) = F_Vendor_ID_Len
                          and Valid_Next (Ctx, F_Vendor_ID_Quad)),
               when F_Response_Not_Ready_Data_RDT_Exponent =>
                  Get_Response_Not_Ready_Data_RDT_Exponent (Ctx) = To_Actual (Val)
                  and (Predecessor (Ctx, F_Response_Not_Ready_Data_Request_Code) = F_Response_Not_Ready_Data_RDT_Exponent
                       and Valid_Next (Ctx, F_Response_Not_Ready_Data_Request_Code)),
               when F_Vendor_ID_Double =>
                  Get_Vendor_ID_Double (Ctx) = To_Actual (Val)
                  and (Predecessor (Ctx, F_Opaque_Error_Data) = F_Vendor_ID_Double
                       and Valid_Next (Ctx, F_Opaque_Error_Data)),
               when F_Vendor_ID_Quad =>
                  Get_Vendor_ID_Quad (Ctx) = To_Actual (Val)
                  and (Predecessor (Ctx, F_Opaque_Error_Data) = F_Vendor_ID_Quad
                       and Valid_Next (Ctx, F_Opaque_Error_Data)),
               when F_Response_Not_Ready_Data_Request_Code =>
                  Get_Response_Not_Ready_Data_Request_Code (Ctx) = To_Actual (Val)
                  and (Predecessor (Ctx, F_Response_Not_Ready_Data_Token) = F_Response_Not_Ready_Data_Request_Code
                       and Valid_Next (Ctx, F_Response_Not_Ready_Data_Token)),
               when F_Opaque_Error_Data =>
                  (if Structural_Valid_Message (Ctx) then Message_Last (Ctx) = Field_Last (Ctx, Fld)),
               when F_Response_Not_Ready_Data_Token =>
                  Get_Response_Not_Ready_Data_Token (Ctx) = To_Actual (Val)
                  and (Predecessor (Ctx, F_Response_Not_Ready_Data_RDTM) = F_Response_Not_Ready_Data_Token
                       and Valid_Next (Ctx, F_Response_Not_Ready_Data_RDTM)),
               when F_Response_Not_Ready_Data_RDTM =>
                  Get_Response_Not_Ready_Data_RDTM (Ctx) = To_Actual (Val)
                  and (if Structural_Valid_Message (Ctx) then Message_Last (Ctx) = Field_Last (Ctx, Fld)))
       and (for all F in Field =>
               (if F < Fld then Ctx.Cursors (F) = Ctx.Cursors'Old (F)))
       and Ctx.Buffer_First = Ctx.Buffer_First'Old
       and Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and Ctx.First = Ctx.First'Old
       and Ctx.Last = Ctx.Last'Old
       and Has_Buffer (Ctx) = Has_Buffer (Ctx)'Old
       and Predecessor (Ctx, Fld) = Predecessor (Ctx, Fld)'Old
       and Field_First (Ctx, Fld) = Field_First (Ctx, Fld)'Old
   is
      Buffer_First, Buffer_Last : RFLX_Types.Index;
      Offset : RFLX_Types.Offset;
      Size : constant RFLX_Types.Bit_Length := Field_Size (Ctx, Fld);
   begin
      Set (Ctx, Fld, Val, Size, True, Buffer_First, Buffer_Last, Offset);
      RFLX_Types.Lemma_Size (Val, Positive (Size));
      RFLX_Types.Insert (Val, Ctx.Buffer, Buffer_First, Buffer_Last, Offset, Positive (Size), (if
          Fld in F_Error_Code | F_Invalid_Session_ID | F_Registry_ID | F_Request_Response_Code | F_Reserved_Error_Data | F_Zero_Error_Data | F_Vendor_ID_Len | F_Vendor_ID_Double | F_Vendor_ID_Quad | F_Opaque_Error_Data
       then
          RFLX_Types.Low_Order_First
       else
          RFLX_Types.High_Order_First));
   end Set_Scalar;

   procedure Set_Error_Code (Ctx : in out Context; Val : RFLX.SPDM.Error_Code) is
   begin
      Set_Scalar (Ctx, F_Error_Code, RFLX.SPDM.To_Base_Integer (Val));
   end Set_Error_Code;

   procedure Set_Invalid_Session_ID (Ctx : in out Context; Val : RFLX.SPDM.Error_Session_ID) is
   begin
      Set_Scalar (Ctx, F_Invalid_Session_ID, RFLX.SPDM.To_Base_Integer (Val));
   end Set_Invalid_Session_ID;

   procedure Set_Registry_ID (Ctx : in out Context; Val : RFLX.SPDM.Registry_ID) is
   begin
      Set_Scalar (Ctx, F_Registry_ID, RFLX.SPDM.To_Base_Integer (Val));
