   procedure To_Structure (Ctx : Context; Struct : out Structure) is
   begin
      Struct.Param_1 := Get_Param_1 (Ctx);
      Struct.Param_2 := Get_Param_2 (Ctx);
      Struct.Reserved_1 := Get_Reserved_1 (Ctx);
      Struct.CT_Exponent := Get_CT_Exponent (Ctx);
      Struct.Reserved_2 := Get_Reserved_2 (Ctx);
      Struct.MAC_Cap := Get_MAC_Cap (Ctx);
      Struct.Encrypt_Cap := Get_Encrypt_Cap (Ctx);
      Struct.Meas_Fresh_Cap := Get_Meas_Fresh_Cap (Ctx);
      Struct.Meas_Cap := Get_Meas_Cap (Ctx);
      Struct.Chal_Cap := Get_Chal_Cap (Ctx);
      Struct.Cert_Cap := Get_Cert_Cap (Ctx);
      Struct.Cache_Cap := Get_Cache_Cap (Ctx);
