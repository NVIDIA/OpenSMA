      Last : RFLX_Types.Bit_Length;
   begin
      Reset_Dependent_Fields (Ctx, Fld);
      First := Field_First (Ctx, Fld);
      Last := Field_First (Ctx, Fld) + Size - 1;
      Offset := RFLX_Types.Offset ((RFLX_Types.Byte'Size - Last mod RFLX_Types.Byte'Size) mod RFLX_Types.Byte'Size);
      Buffer_First := RFLX_Types.To_Index (First);
      Buffer_Last := RFLX_Types.To_Index (Last);
      pragma Assert ((((Last + RFLX_Types.Byte'Size - 1) / RFLX_Types.Byte'Size) * RFLX_Types.Byte'Size) mod RFLX_Types.Byte'Size = 0);
      pragma Warnings (Off, "attribute Update is an obsolescent feature");
      Ctx := Ctx'Update (Verified_Last => ((Last + RFLX_Types.Byte'Size - 1) / RFLX_Types.Byte'Size) * RFLX_Types.Byte'Size, Written_Last => ((Last + RFLX_Types.Byte'Size - 1) / RFLX_Types.Byte'Size) * RFLX_Types.Byte'Size);
      pragma Warnings (On, "attribute Update is an obsolescent feature");
      pragma Assert (Size = (case Fld is
                         when F_Param_1 | F_Param_2 | F_Reserved_1 | F_CT_Exponent =>
                            8,
                         when F_Reserved_2 =>
                            16,
                         when F_MAC_Cap | F_Encrypt_Cap | F_Meas_Fresh_Cap =>
                            1,
                         when F_Meas_Cap =>
                            2,
                         when F_Chal_Cap | F_Cert_Cap | F_Cache_Cap | F_Handshake_In_The_Clear_Cap | F_Key_Upd_Cap | F_Hbeat_Cap | F_Encap_Cap =>
                            1,
                         when F_PSK_Cap =>
                            2,
                         when F_Key_Ex_Cap | F_Mut_Auth_Cap =>
                            1,
                         when F_Reserved_4 =>
                            15,
                         when F_Pub_Key_ID_Cap =>
                            1));
      if State_Valid then
         Ctx.Cursors (Fld) := (State => S_Valid, First => First, Last => Last, Value => Val, Predecessor => Ctx.Cursors (Fld).Predecessor);
      else
         Ctx.Cursors (Fld) := (State => S_Structural_Valid, First => First, Last => Last, Value => Val, Predecessor => Ctx.Cursors (Fld).Predecessor);
      end if;
      Ctx.Cursors (Successor (Ctx, Fld)) := (State => S_Invalid, Predecessor => Fld);
      pragma Assert (Last = (Field_First (Ctx, Fld) + Size) - 1);
   end Set;

   procedure Set_Scalar (Ctx : in out Context; Fld : Field; Val : RFLX_Types.Base_Integer) with
     Pre =>
       not Ctx'Constrained
       and then RFLX.SPDM.Capabilities_Response.Has_Buffer (Ctx)
       and then RFLX.SPDM.Capabilities_Response.Valid_Next (Ctx, Fld)
       and then Fld in F_Param_1 | F_Param_2 | F_Reserved_1 | F_CT_Exponent | F_Reserved_2 | F_MAC_Cap | F_Encrypt_Cap | F_Meas_Fresh_Cap | F_Meas_Cap | F_Chal_Cap | F_Cert_Cap | F_Cache_Cap | F_Handshake_In_The_Clear_Cap | F_Key_Upd_Cap | F_Hbeat_Cap | F_Encap_Cap | F_PSK_Cap | F_Key_Ex_Cap | F_Mut_Auth_Cap | F_Reserved_4 | F_Pub_Key_ID_Cap
       and then RFLX.SPDM.Capabilities_Response.Valid_Value (Fld, Val)
       and then RFLX.SPDM.Capabilities_Response.Valid_Size (Ctx, Fld, RFLX.SPDM.Capabilities_Response.Field_Size (Ctx, Fld))
       and then RFLX.SPDM.Capabilities_Response.Available_Space (Ctx, Fld) >= RFLX.SPDM.Capabilities_Response.Field_Size (Ctx, Fld)
       and then RFLX.SPDM.Capabilities_Response.Field_Size (Ctx, Fld) in 1 .. RFLX_Types.Base_Integer'Size
       and then RFLX_Types.Fits_Into (Val, Natural (RFLX.SPDM.Capabilities_Response.Field_Size (Ctx, Fld))),
     Post =>
       Has_Buffer (Ctx)
       and Valid (Ctx, Fld)
       and Invalid_Successor (Ctx, Fld)
       and (case Fld is
               when F_Param_1 =>
                  (Predecessor (Ctx, F_Param_2) = F_Param_1
                   and Valid_Next (Ctx, F_Param_2)),
               when F_Param_2 =>
                  (Predecessor (Ctx, F_Reserved_1) = F_Param_2
                   and Valid_Next (Ctx, F_Reserved_1)),
               when F_Reserved_1 =>
                  (Predecessor (Ctx, F_CT_Exponent) = F_Reserved_1
                   and Valid_Next (Ctx, F_CT_Exponent)),
               when F_CT_Exponent =>
                  Get_CT_Exponent (Ctx) = To_Actual (Val)
                  and (Predecessor (Ctx, F_Reserved_2) = F_CT_Exponent
                       and Valid_Next (Ctx, F_Reserved_2)),
               when F_Reserved_2 =>
                  (Predecessor (Ctx, F_MAC_Cap) = F_Reserved_2
                   and Valid_Next (Ctx, F_MAC_Cap)),
               when F_MAC_Cap =>
                  Get_MAC_Cap (Ctx) = To_Actual (Val)
                  and (Predecessor (Ctx, F_Encrypt_Cap) = F_MAC_Cap
                       and Valid_Next (Ctx, F_Encrypt_Cap)),
               when F_Encrypt_Cap =>
                  Get_Encrypt_Cap (Ctx) = To_Actual (Val)
                  and (Predecessor (Ctx, F_Meas_Fresh_Cap) = F_Encrypt_Cap
                       and Valid_Next (Ctx, F_Meas_Fresh_Cap)),
               when F_Meas_Fresh_Cap =>
                  Get_Meas_Fresh_Cap (Ctx) = To_Actual (Val)
                  and (Predecessor (Ctx, F_Meas_Cap) = F_Meas_Fresh_Cap
                       and Valid_Next (Ctx, F_Meas_Cap)),
               when F_Meas_Cap =>
                  Get_Meas_Cap (Ctx) = To_Actual (Val)
                  and (Predecessor (Ctx, F_Chal_Cap) = F_Meas_Cap
                       and Valid_Next (Ctx, F_Chal_Cap)),
               when F_Chal_Cap =>
                  Get_Chal_Cap (Ctx) = To_Actual (Val)
                  and (Predecessor (Ctx, F_Cert_Cap) = F_Chal_Cap
                       and Valid_Next (Ctx, F_Cert_Cap)),
               when F_Cert_Cap =>
                  Get_Cert_Cap (Ctx) = To_Actual (Val)
                  and (Predecessor (Ctx, F_Cache_Cap) = F_Cert_Cap
                       and Valid_Next (Ctx, F_Cache_Cap)),
               when F_Cache_Cap =>
                  Get_Cache_Cap (Ctx) = To_Actual (Val)
                  and (Predecessor (Ctx, F_Handshake_In_The_Clear_Cap) = F_Cache_Cap
                       and Valid_Next (Ctx, F_Handshake_In_The_Clear_Cap)),
               when F_Handshake_In_The_Clear_Cap =>
                  Get_Handshake_In_The_Clear_Cap (Ctx) = To_Actual (Val)
                  and (Predecessor (Ctx, F_Key_Upd_Cap) = F_Handshake_In_The_Clear_Cap
                       and Valid_Next (Ctx, F_Key_Upd_Cap)),
               when F_Key_Upd_Cap =>
                  Get_Key_Upd_Cap (Ctx) = To_Actual (Val)
                  and (Predecessor (Ctx, F_Hbeat_Cap) = F_Key_Upd_Cap
                       and Valid_Next (Ctx, F_Hbeat_Cap)),
               when F_Hbeat_Cap =>
                  Get_Hbeat_Cap (Ctx) = To_Actual (Val)
                  and (Predecessor (Ctx, F_Encap_Cap) = F_Hbeat_Cap
                       and Valid_Next (Ctx, F_Encap_Cap)),
               when F_Encap_Cap =>
                  Get_Encap_Cap (Ctx) = To_Actual (Val)
                  and (Predecessor (Ctx, F_PSK_Cap) = F_Encap_Cap
                       and Valid_Next (Ctx, F_PSK_Cap)),
               when F_PSK_Cap =>
                  Get_PSK_Cap (Ctx) = To_Actual (Val)
                  and (Predecessor (Ctx, F_Key_Ex_Cap) = F_PSK_Cap
                       and Valid_Next (Ctx, F_Key_Ex_Cap)),
               when F_Key_Ex_Cap =>
                  Get_Key_Ex_Cap (Ctx) = To_Actual (Val)
                  and (Predecessor (Ctx, F_Mut_Auth_Cap) = F_Key_Ex_Cap
                       and Valid_Next (Ctx, F_Mut_Auth_Cap)),
               when F_Mut_Auth_Cap =>
                  Get_Mut_Auth_Cap (Ctx) = To_Actual (Val)
                  and (Predecessor (Ctx, F_Reserved_4) = F_Mut_Auth_Cap
                       and Valid_Next (Ctx, F_Reserved_4)),
               when F_Reserved_4 =>
                  (Predecessor (Ctx, F_Pub_Key_ID_Cap) = F_Reserved_4
                   and Valid_Next (Ctx, F_Pub_Key_ID_Cap)),
               when F_Pub_Key_ID_Cap =>
                  (Get_Pub_Key_ID_Cap (Ctx) = To_Actual (Val))
                  and (if Structural_Valid_Message (Ctx) then Message_Last (Ctx) = Field_Last (Ctx, Fld)))
       and (for all F in Field =>
               (if F < Fld then Ctx.Cursors (F) = Ctx.Cursors'Old (F)))
       and Ctx.Buffer_First = Ctx.Buffer_First'Old
       and Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and Ctx.First = Ctx.First'Old
       and Ctx.Last = Ctx.Last'Old
       and Has_Buffer (Ctx) = Has_Buffer (Ctx)'Old
       and Predecessor (Ctx, Fld) = Predecessor (Ctx, Fld)'Old
       and Field_First (Ctx, Fld) = Field_First (Ctx, Fld)'Old
   is
      Buffer_First, Buffer_Last : RFLX_Types.Index;
      Offset : RFLX_Types.Offset;
      Size : constant RFLX_Types.Bit_Length := Field_Size (Ctx, Fld);
   begin
      Set (Ctx, Fld, Val, Size, True, Buffer_First, Buffer_Last, Offset);
      RFLX_Types.Lemma_Size (Val, Positive (Size));
      RFLX_Types.Insert (Val, Ctx.Buffer, Buffer_First, Buffer_Last, Offset, Positive (Size), RFLX_Types.High_Order_First);
   end Set_Scalar;

