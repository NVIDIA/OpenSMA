                and then (if Invalid (Cursors (F_AEAD_AES_128_GCM)) then Invalid (Cursors (F_AEAD_Reserved_2)))
                and then (if Invalid (Cursors (F_DHE_SecP256r1)) then Invalid (Cursors (F_DHE_FFDHE4096)))
                and then (if
