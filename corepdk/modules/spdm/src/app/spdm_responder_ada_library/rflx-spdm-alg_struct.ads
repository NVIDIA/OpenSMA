       and Ctx.Buffer_First = Seq_Ctx.Buffer_First
       and Ctx.Buffer_Last = Seq_Ctx.Buffer_Last
       and Seq_Ctx.First = Field_First (Ctx, F_Alg_External)
       and Seq_Ctx.Last = Field_Last (Ctx, F_Alg_External)
       and RFLX.SPDM.Ext_Algs.Valid (Seq_Ctx)
       and RFLX.SPDM.Ext_Algs.Sequence_Last (Seq_Ctx) = Seq_Ctx.First - 1
       and Present (Ctx, F_Alg_External)
       and Ctx.Buffer_First = Ctx.Buffer_First'Old
       and Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and Ctx.First = Ctx.First'Old
       and Ctx.Last = Ctx.Last'Old
       and Predecessor (Ctx, F_Alg_External) = Predecessor (Ctx, F_Alg_External)'Old
       and Path_Condition (Ctx, F_Alg_External) = Path_Condition (Ctx, F_Alg_External)'Old
       and Field_Last (Ctx, F_Alg_External) = Field_Last (Ctx, F_Alg_External)'Old
       and (for all F in Field range F_Alg_Type .. F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P521 =>
               Context_Cursors_Index (Context_Cursors (Ctx), F) = Context_Cursors_Index (Context_Cursors (Ctx)'Old, F)),
     Contract_Cases =>
       (Structural_Valid (Ctx, F_Alg_External) =>
           True,
        others =>
           True);

   function Complete_Alg_External (Ctx : Context; Seq_Ctx : RFLX.SPDM.Ext_Algs.Context) return Boolean with
     Pre =>
       RFLX.SPDM.Alg_Struct.Valid_Next (Ctx, RFLX.SPDM.Alg_Struct.F_Alg_External);

   procedure Update_Alg_External (Ctx : in out Context; Seq_Ctx : in out RFLX.SPDM.Ext_Algs.Context) with
     Pre =>
       RFLX.SPDM.Alg_Struct.Present (Ctx, RFLX.SPDM.Alg_Struct.F_Alg_External)
       and then RFLX.SPDM.Alg_Struct.Complete_Alg_External (Ctx, Seq_Ctx)
       and then not RFLX.SPDM.Alg_Struct.Has_Buffer (Ctx)
       and then RFLX.SPDM.Ext_Algs.Has_Buffer (Seq_Ctx)
       and then Ctx.Buffer_First = Seq_Ctx.Buffer_First
       and then Ctx.Buffer_Last = Seq_Ctx.Buffer_Last
