private

   type Cursor_State is (S_Valid, S_Structural_Valid, S_Invalid, S_Incomplete);

   type Field_Cursor (State : Cursor_State := S_Invalid) is
      record
         Predecessor : Virtual_Field := F_Final;
         case State is
            when S_Valid | S_Structural_Valid =>
               First : RFLX_Types.Bit_Index := RFLX_Types.Bit_Index'First;
               Last : RFLX_Types.Bit_Length := RFLX_Types.Bit_Length'First;
               Value : RFLX_Types.Base_Integer := 0;
            when S_Invalid | S_Incomplete =>
               null;
         end case;
      end record;

   type Field_Cursors is array (Virtual_Field) of Field_Cursor;

   function Structural_Valid (Cursor : Field_Cursor) return Boolean is
     (Cursor.State = S_Valid
      or Cursor.State = S_Structural_Valid);

   function Valid (Cursor : Field_Cursor) return Boolean is
     (Cursor.State = S_Valid);

   function Invalid (Cursor : Field_Cursor) return Boolean is
     (Cursor.State = S_Invalid
      or Cursor.State = S_Incomplete);

   pragma Warnings (Off, """Buffer"" is not modified, could be of access constant type");

   pragma Warnings (Off, "postcondition does not mention function result");

   function Valid_Context (Buffer_First, Buffer_Last : RFLX_Types.Index; First : RFLX_Types.Bit_Index; Last : RFLX_Types.Bit_Length; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length; Buffer : RFLX_Types.Bytes_Ptr; Cursors : Field_Cursors) return Boolean is
     ((if Buffer /= null then Buffer'First = Buffer_First and Buffer'Last = Buffer_Last)
      and then (RFLX_Types.To_Index (First) >= Buffer_First
                and RFLX_Types.To_Index (Last) <= Buffer_Last
                and Buffer_Last < RFLX_Types.Index'Last
                and First <= Last + 1
                and Last < RFLX_Types.Bit_Index'Last
                and First rem RFLX_Types.Byte'Size = 1
                and Last rem RFLX_Types.Byte'Size = 0)
      and then First - 1 <= Verified_Last
      and then First - 1 <= Written_Last
      and then Verified_Last <= Written_Last
      and then Written_Last <= Last
      and then First rem RFLX_Types.Byte'Size = 1
      and then Last rem RFLX_Types.Byte'Size = 0
      and then Verified_Last rem RFLX_Types.Byte'Size = 0
      and then Written_Last rem RFLX_Types.Byte'Size = 0
      and then (for all F in Field =>
                   (if
                       Structural_Valid (Cursors (F))
                    then
                       Cursors (F).First >= First
                       and Cursors (F).Last <= Verified_Last
                       and Cursors (F).First <= Cursors (F).Last + 1
                       and Valid_Value (F, Cursors (F).Value)))
      and then ((if
                    Structural_Valid (Cursors (F_Fixed_Alg_Count))
                 then
                    (Valid (Cursors (F_Alg_Type))
                     and then Cursors (F_Fixed_Alg_Count).Predecessor = F_Alg_Type))
                and then (if
                             Structural_Valid (Cursors (F_Ext_Alg_Count))
                          then
                             (Valid (Cursors (F_Fixed_Alg_Count))
                              and then Cursors (F_Ext_Alg_Count).Predecessor = F_Fixed_Alg_Count
                              and then Cursors (F_Fixed_Alg_Count).Value = 2))
                and then (if
                             Structural_Valid (Cursors (F_AEAD_Reserved_1))
                          then
                             (Valid (Cursors (F_Ext_Alg_Count))
                              and then Cursors (F_AEAD_Reserved_1).Predecessor = F_Ext_Alg_Count
                              and then RFLX_Types.Base_Integer (Cursors (F_Alg_Type).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.AEAD_Cipher_Suite))))
                and then (if
                             Structural_Valid (Cursors (F_DHE_Reserved_1))
                          then
                             (Valid (Cursors (F_Ext_Alg_Count))
                              and then Cursors (F_DHE_Reserved_1).Predecessor = F_Ext_Alg_Count
                              and then RFLX_Types.Base_Integer (Cursors (F_Alg_Type).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.DHE))))
                and then (if
                             Structural_Valid (Cursors (F_KS_Reserved_1))
                          then
                             (Valid (Cursors (F_Ext_Alg_Count))
                              and then Cursors (F_KS_Reserved_1).Predecessor = F_Ext_Alg_Count
                              and then RFLX_Types.Base_Integer (Cursors (F_Alg_Type).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Key_Schedule))))
                and then (if
                             Structural_Valid (Cursors (F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P384))
                          then
                             (Valid (Cursors (F_Ext_Alg_Count))
                              and then Cursors (F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P384).Predecessor = F_Ext_Alg_Count
                              and then RFLX_Types.Base_Integer (Cursors (F_Alg_Type).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Req_Base_Asym_Alg))))
                and then (if
                             Structural_Valid (Cursors (F_AEAD_ChaCha20_Poly1305))
                          then
                             (Valid (Cursors (F_AEAD_Reserved_1))
                              and then Cursors (F_AEAD_ChaCha20_Poly1305).Predecessor = F_AEAD_Reserved_1))
                and then (if
                             Structural_Valid (Cursors (F_DHE_SecP521r1))
                          then
                             (Valid (Cursors (F_DHE_Reserved_1))
                              and then Cursors (F_DHE_SecP521r1).Predecessor = F_DHE_Reserved_1))
                and then (if
                             Structural_Valid (Cursors (F_KS_SPDM))
                          then
                             (Valid (Cursors (F_KS_Reserved_1))
                              and then Cursors (F_KS_SPDM).Predecessor = F_KS_Reserved_1))
                and then (if
                             Structural_Valid (Cursors (F_RBAA_TPM_ALG_RSAPSS_4096))
                          then
                             (Valid (Cursors (F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P384))
                              and then Cursors (F_RBAA_TPM_ALG_RSAPSS_4096).Predecessor = F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P384))
                and then (if
                             Structural_Valid (Cursors (F_AEAD_AES_256_GCM))
                          then
                             (Valid (Cursors (F_AEAD_ChaCha20_Poly1305))
                              and then Cursors (F_AEAD_AES_256_GCM).Predecessor = F_AEAD_ChaCha20_Poly1305))
                and then (if
                             Structural_Valid (Cursors (F_DHE_SecP384r1))
                          then
                             (Valid (Cursors (F_DHE_SecP521r1))
                              and then Cursors (F_DHE_SecP384r1).Predecessor = F_DHE_SecP521r1))
                and then (if
                             Structural_Valid (Cursors (F_KS_Reserved_2))
                          then
                             (Valid (Cursors (F_KS_SPDM))
                              and then Cursors (F_KS_Reserved_2).Predecessor = F_KS_SPDM))
                and then (if
                             Structural_Valid (Cursors (F_RBAA_TPM_ALG_RSASSA_4096))
                          then
                             (Valid (Cursors (F_RBAA_TPM_ALG_RSAPSS_4096))
                              and then Cursors (F_RBAA_TPM_ALG_RSASSA_4096).Predecessor = F_RBAA_TPM_ALG_RSAPSS_4096))
                and then (if
                             Structural_Valid (Cursors (F_AEAD_AES_128_GCM))
                          then
                             (Valid (Cursors (F_AEAD_AES_256_GCM))
                              and then Cursors (F_AEAD_AES_128_GCM).Predecessor = F_AEAD_AES_256_GCM))
                and then (if
                             Structural_Valid (Cursors (F_DHE_SecP256r1))
                          then
                             (Valid (Cursors (F_DHE_SecP384r1))
                              and then Cursors (F_DHE_SecP256r1).Predecessor = F_DHE_SecP384r1))
                and then (if
                             Structural_Valid (Cursors (F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P256))
                          then
                             (Valid (Cursors (F_RBAA_TPM_ALG_RSASSA_4096))
                              and then Cursors (F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P256).Predecessor = F_RBAA_TPM_ALG_RSASSA_4096))
                and then (if
                             Structural_Valid (Cursors (F_AEAD_Reserved_2))
                          then
                             (Valid (Cursors (F_AEAD_AES_128_GCM))
                              and then Cursors (F_AEAD_Reserved_2).Predecessor = F_AEAD_AES_128_GCM))
                and then (if
