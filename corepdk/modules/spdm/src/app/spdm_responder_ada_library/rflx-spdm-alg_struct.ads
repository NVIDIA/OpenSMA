                and then (if Invalid (Cursors (F_AEAD_AES_256_GCM)) then Invalid (Cursors (F_AEAD_AES_128_GCM)))
                and then (if Invalid (Cursors (F_DHE_SecP384r1)) then Invalid (Cursors (F_DHE_SecP256r1)))
