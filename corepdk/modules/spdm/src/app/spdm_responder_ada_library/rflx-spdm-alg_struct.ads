                and then (if Invalid (Cursors (F_DHE_FFDHE3072)) then Invalid (Cursors (F_DHE_FFDHE2048)))
                and then (if
                             Invalid (Cursors (F_RBAA_TPM_ALG_RSASSA_3072))
                          then
                             Invalid (Cursors (F_RBAA_TPM_ALG_RSAPSS_2048)))
                and then (if Invalid (Cursors (F_DHE_FFDHE2048)) then Invalid (Cursors (F_DHE_Reserved_2)))
                and then (if
