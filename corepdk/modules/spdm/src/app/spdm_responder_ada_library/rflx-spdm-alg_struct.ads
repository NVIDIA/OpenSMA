       and Context_Cursor (Ctx, F_AEAD_AES_128_GCM) = Context_Cursor (Ctx, F_AEAD_AES_128_GCM)'Old
       and Context_Cursor (Ctx, F_DHE_SecP256r1) = Context_Cursor (Ctx, F_DHE_SecP256r1)'Old
