       Present (Ctx, F_Alg_External)
       and Has_Buffer (Ctx)
       and not RFLX.SPDM.Ext_Algs.Has_Buffer (Seq_Ctx)
       and Ctx.Buffer_First = Ctx.Buffer_First'Old
