                          then
                             (Valid (Cursors (F_DHE_SecP256r1))
                              and then Cursors (F_DHE_FFDHE4096).Predecessor = F_DHE_SecP256r1))
                and then (if
                             Structural_Valid (Cursors (F_RBAA_TPM_ALG_RSAPSS_3072))
                          then
                             (Valid (Cursors (F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P256))
                              and then Cursors (F_RBAA_TPM_ALG_RSAPSS_3072).Predecessor = F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P256))
                and then (if
                             Structural_Valid (Cursors (F_DHE_FFDHE3072))
                          then
                             (Valid (Cursors (F_DHE_FFDHE4096))
                              and then Cursors (F_DHE_FFDHE3072).Predecessor = F_DHE_FFDHE4096))
                and then (if
                             Structural_Valid (Cursors (F_RBAA_TPM_ALG_RSASSA_3072))
                          then
                             (Valid (Cursors (F_RBAA_TPM_ALG_RSAPSS_3072))
                              and then Cursors (F_RBAA_TPM_ALG_RSASSA_3072).Predecessor = F_RBAA_TPM_ALG_RSAPSS_3072))
                and then (if
                             Structural_Valid (Cursors (F_DHE_FFDHE2048))
                          then
                             (Valid (Cursors (F_DHE_FFDHE3072))
                              and then Cursors (F_DHE_FFDHE2048).Predecessor = F_DHE_FFDHE3072))
                and then (if
                             Structural_Valid (Cursors (F_RBAA_TPM_ALG_RSAPSS_2048))
                          then
                             (Valid (Cursors (F_RBAA_TPM_ALG_RSASSA_3072))
                              and then Cursors (F_RBAA_TPM_ALG_RSAPSS_2048).Predecessor = F_RBAA_TPM_ALG_RSASSA_3072))
                and then (if
                             Structural_Valid (Cursors (F_DHE_Reserved_2))
                          then
                             (Valid (Cursors (F_DHE_FFDHE2048))
                              and then Cursors (F_DHE_Reserved_2).Predecessor = F_DHE_FFDHE2048))
                and then (if
                             Structural_Valid (Cursors (F_RBAA_TPM_ALG_RSASSA_2048))
                          then
                             (Valid (Cursors (F_RBAA_TPM_ALG_RSAPSS_2048))
                              and then Cursors (F_RBAA_TPM_ALG_RSASSA_2048).Predecessor = F_RBAA_TPM_ALG_RSAPSS_2048))
                and then (if
                             Structural_Valid (Cursors (F_RBAA_Reserved_1))
                          then
                             (Valid (Cursors (F_RBAA_TPM_ALG_RSASSA_2048))
                              and then Cursors (F_RBAA_Reserved_1).Predecessor = F_RBAA_TPM_ALG_RSASSA_2048))
                and then (if
                             Structural_Valid (Cursors (F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P521))
                          then
                             (Valid (Cursors (F_RBAA_Reserved_1))
                              and then Cursors (F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P521).Predecessor = F_RBAA_Reserved_1))
                and then (if
                             Structural_Valid (Cursors (F_Alg_External))
                          then
                             (Valid (Cursors (F_AEAD_Reserved_2))
                              and then Cursors (F_Alg_External).Predecessor = F_AEAD_Reserved_2)
                             or (Valid (Cursors (F_DHE_Reserved_2))
                                 and then Cursors (F_Alg_External).Predecessor = F_DHE_Reserved_2)
                             or (Valid (Cursors (F_KS_Reserved_2))
                                 and then Cursors (F_Alg_External).Predecessor = F_KS_Reserved_2)
                             or (Valid (Cursors (F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P521))
                                 and then Cursors (F_Alg_External).Predecessor = F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P521)))
      and then ((if Invalid (Cursors (F_Alg_Type)) then Invalid (Cursors (F_Fixed_Alg_Count)))
