                and then (if Invalid (Cursors (F_DHE_FFDHE4096)) then Invalid (Cursors (F_DHE_FFDHE3072)))
                and then (if
                             Invalid (Cursors (F_RBAA_TPM_ALG_RSAPSS_3072))
                          then
