   function Path_Condition (Ctx : Context; Fld : Field) return Boolean is
     ((case Ctx.Cursors (Fld).Predecessor is
          when F_Initial | F_Alg_Type | F_AEAD_Reserved_1 | F_DHE_Reserved_1 | F_KS_Reserved_1 | F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P384 | F_AEAD_ChaCha20_Poly1305 | F_DHE_SecP521r1 | F_KS_SPDM | F_RBAA_TPM_ALG_RSAPSS_4096 | F_AEAD_AES_256_GCM | F_DHE_SecP384r1 | F_KS_Reserved_2 | F_RBAA_TPM_ALG_RSASSA_4096 | F_AEAD_AES_128_GCM | F_DHE_SecP256r1 | F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P256 | F_AEAD_Reserved_2 | F_DHE_FFDHE4096 | F_RBAA_TPM_ALG_RSAPSS_3072 | F_DHE_FFDHE3072 | F_RBAA_TPM_ALG_RSASSA_3072 | F_DHE_FFDHE2048 | F_RBAA_TPM_ALG_RSAPSS_2048 | F_DHE_Reserved_2 | F_RBAA_TPM_ALG_RSASSA_2048 | F_RBAA_Reserved_1 | F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P521 | F_Alg_External | F_Final =>
             True,
          when F_Fixed_Alg_Count =>
             Ctx.Cursors (F_Fixed_Alg_Count).Value = 2,
          when F_Ext_Alg_Count =>
             (case Fld is
                 when F_AEAD_Reserved_1 =>
                    RFLX_Types.Base_Integer (Ctx.Cursors (F_Alg_Type).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.AEAD_Cipher_Suite)),
                 when F_DHE_Reserved_1 =>
                    RFLX_Types.Base_Integer (Ctx.Cursors (F_Alg_Type).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.DHE)),
                 when F_KS_Reserved_1 =>
                    RFLX_Types.Base_Integer (Ctx.Cursors (F_Alg_Type).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Key_Schedule)),
                 when F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P384 =>
                    RFLX_Types.Base_Integer (Ctx.Cursors (F_Alg_Type).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Req_Base_Asym_Alg)),
                 when others =>
                    False)));

   function Field_Condition (Ctx : Context; Fld : Field; Val : RFLX_Types.Base_Integer) return Boolean is
     ((case Fld is
          when F_Alg_Type =>
             True,
          when F_Fixed_Alg_Count =>
             Val = 2,
          when F_Ext_Alg_Count =>
             RFLX_Types.Base_Integer (Ctx.Cursors (F_Alg_Type).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.AEAD_Cipher_Suite))
             or RFLX_Types.Base_Integer (Ctx.Cursors (F_Alg_Type).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.DHE))
             or RFLX_Types.Base_Integer (Ctx.Cursors (F_Alg_Type).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Key_Schedule))
             or RFLX_Types.Base_Integer (Ctx.Cursors (F_Alg_Type).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Req_Base_Asym_Alg)),
          when F_AEAD_Reserved_1 | F_DHE_Reserved_1 | F_KS_Reserved_1 | F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P384 | F_AEAD_ChaCha20_Poly1305 | F_DHE_SecP521r1 | F_KS_SPDM | F_RBAA_TPM_ALG_RSAPSS_4096 | F_AEAD_AES_256_GCM | F_DHE_SecP384r1 | F_KS_Reserved_2 | F_RBAA_TPM_ALG_RSASSA_4096 | F_AEAD_AES_128_GCM | F_DHE_SecP256r1 | F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P256 | F_AEAD_Reserved_2 | F_DHE_FFDHE4096 | F_RBAA_TPM_ALG_RSAPSS_3072 | F_DHE_FFDHE3072 | F_RBAA_TPM_ALG_RSASSA_3072 | F_DHE_FFDHE2048 | F_RBAA_TPM_ALG_RSAPSS_2048 | F_DHE_Reserved_2 | F_RBAA_TPM_ALG_RSASSA_2048 | F_RBAA_Reserved_1 | F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P521 | F_Alg_External =>
             True));

   function Field_Size (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Length is
     ((case Fld is
          when F_Alg_Type =>
             8,
          when F_Fixed_Alg_Count | F_Ext_Alg_Count =>
             4,
          when F_AEAD_Reserved_1 =>
             5,
          when F_DHE_Reserved_1 =>
             2,
          when F_KS_Reserved_1 =>
             7,
          when F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P384 | F_AEAD_ChaCha20_Poly1305 | F_DHE_SecP521r1 | F_KS_SPDM | F_RBAA_TPM_ALG_RSAPSS_4096 | F_AEAD_AES_256_GCM | F_DHE_SecP384r1 =>
             1,
          when F_KS_Reserved_2 =>
             8,
          when F_RBAA_TPM_ALG_RSASSA_4096 | F_AEAD_AES_128_GCM | F_DHE_SecP256r1 | F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P256 =>
             1,
          when F_AEAD_Reserved_2 =>
             8,
          when F_DHE_FFDHE4096 | F_RBAA_TPM_ALG_RSAPSS_3072 | F_DHE_FFDHE3072 | F_RBAA_TPM_ALG_RSASSA_3072 | F_DHE_FFDHE2048 | F_RBAA_TPM_ALG_RSAPSS_2048 =>
             1,
          when F_DHE_Reserved_2 =>
             8,
          when F_RBAA_TPM_ALG_RSASSA_2048 =>
             1,
          when F_RBAA_Reserved_1 =>
             7,
          when F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P521 =>
             1,
          when F_Alg_External =>
             (if
                 Ctx.Cursors (Fld).Predecessor = F_AEAD_Reserved_2
              then
                 RFLX_Types.Bit_Length (Ctx.Cursors (F_Ext_Alg_Count).Value) * 32
              elsif
                 Ctx.Cursors (Fld).Predecessor = F_DHE_Reserved_2
              then
                 RFLX_Types.Bit_Length (Ctx.Cursors (F_Ext_Alg_Count).Value) * 32
              elsif
                 Ctx.Cursors (Fld).Predecessor = F_KS_Reserved_2
              then
                 RFLX_Types.Bit_Length (Ctx.Cursors (F_Ext_Alg_Count).Value) * 32
              elsif
                 Ctx.Cursors (Fld).Predecessor = F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P521
              then
                 RFLX_Types.Bit_Length (Ctx.Cursors (F_Ext_Alg_Count).Value) * 32
              else
                 RFLX_Types.Unreachable)));

   function Field_First (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Index is
     ((if Fld = F_Alg_Type then Ctx.First else Ctx.Cursors (Ctx.Cursors (Fld).Predecessor).Last + 1));

   function Field_Last (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Length is
     (Field_First (Ctx, Fld) + Field_Size (Ctx, Fld) - 1);

   function Predecessor (Ctx : Context; Fld : Virtual_Field) return Virtual_Field is
     ((case Fld is
          when F_Initial =>
             F_Initial,
          when others =>
             Ctx.Cursors (Fld).Predecessor));

   function Valid_Predecessor (Ctx : Context; Fld : Virtual_Field) return Boolean is
     ((case Fld is
          when F_Initial =>
             True,
          when F_Alg_Type =>
             Ctx.Cursors (Fld).Predecessor = F_Initial,
          when F_Fixed_Alg_Count =>
             (Valid (Ctx.Cursors (F_Alg_Type))
              and Ctx.Cursors (Fld).Predecessor = F_Alg_Type),
          when F_Ext_Alg_Count =>
             (Valid (Ctx.Cursors (F_Fixed_Alg_Count))
              and Ctx.Cursors (Fld).Predecessor = F_Fixed_Alg_Count),
          when F_AEAD_Reserved_1 | F_DHE_Reserved_1 | F_KS_Reserved_1 | F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P384 =>
             (Valid (Ctx.Cursors (F_Ext_Alg_Count))
              and Ctx.Cursors (Fld).Predecessor = F_Ext_Alg_Count),
          when F_AEAD_ChaCha20_Poly1305 =>
             (Valid (Ctx.Cursors (F_AEAD_Reserved_1))
              and Ctx.Cursors (Fld).Predecessor = F_AEAD_Reserved_1),
          when F_DHE_SecP521r1 =>
             (Valid (Ctx.Cursors (F_DHE_Reserved_1))
              and Ctx.Cursors (Fld).Predecessor = F_DHE_Reserved_1),
          when F_KS_SPDM =>
             (Valid (Ctx.Cursors (F_KS_Reserved_1))
              and Ctx.Cursors (Fld).Predecessor = F_KS_Reserved_1),
          when F_RBAA_TPM_ALG_RSAPSS_4096 =>
             (Valid (Ctx.Cursors (F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P384))
              and Ctx.Cursors (Fld).Predecessor = F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P384),
          when F_AEAD_AES_256_GCM =>
             (Valid (Ctx.Cursors (F_AEAD_ChaCha20_Poly1305))
              and Ctx.Cursors (Fld).Predecessor = F_AEAD_ChaCha20_Poly1305),
          when F_DHE_SecP384r1 =>
             (Valid (Ctx.Cursors (F_DHE_SecP521r1))
              and Ctx.Cursors (Fld).Predecessor = F_DHE_SecP521r1),
          when F_KS_Reserved_2 =>
             (Valid (Ctx.Cursors (F_KS_SPDM))
              and Ctx.Cursors (Fld).Predecessor = F_KS_SPDM),
          when F_RBAA_TPM_ALG_RSASSA_4096 =>
             (Valid (Ctx.Cursors (F_RBAA_TPM_ALG_RSAPSS_4096))
              and Ctx.Cursors (Fld).Predecessor = F_RBAA_TPM_ALG_RSAPSS_4096),
          when F_AEAD_AES_128_GCM =>
             (Valid (Ctx.Cursors (F_AEAD_AES_256_GCM))
              and Ctx.Cursors (Fld).Predecessor = F_AEAD_AES_256_GCM),
          when F_DHE_SecP256r1 =>
             (Valid (Ctx.Cursors (F_DHE_SecP384r1))
              and Ctx.Cursors (Fld).Predecessor = F_DHE_SecP384r1),
          when F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P256 =>
             (Valid (Ctx.Cursors (F_RBAA_TPM_ALG_RSASSA_4096))
              and Ctx.Cursors (Fld).Predecessor = F_RBAA_TPM_ALG_RSASSA_4096),
          when F_AEAD_Reserved_2 =>
             (Valid (Ctx.Cursors (F_AEAD_AES_128_GCM))
              and Ctx.Cursors (Fld).Predecessor = F_AEAD_AES_128_GCM),
          when F_DHE_FFDHE4096 =>
             (Valid (Ctx.Cursors (F_DHE_SecP256r1))
              and Ctx.Cursors (Fld).Predecessor = F_DHE_SecP256r1),
          when F_RBAA_TPM_ALG_RSAPSS_3072 =>
             (Valid (Ctx.Cursors (F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P256))
              and Ctx.Cursors (Fld).Predecessor = F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P256),
          when F_DHE_FFDHE3072 =>
             (Valid (Ctx.Cursors (F_DHE_FFDHE4096))
              and Ctx.Cursors (Fld).Predecessor = F_DHE_FFDHE4096),
          when F_RBAA_TPM_ALG_RSASSA_3072 =>
             (Valid (Ctx.Cursors (F_RBAA_TPM_ALG_RSAPSS_3072))
              and Ctx.Cursors (Fld).Predecessor = F_RBAA_TPM_ALG_RSAPSS_3072),
          when F_DHE_FFDHE2048 =>
             (Valid (Ctx.Cursors (F_DHE_FFDHE3072))
              and Ctx.Cursors (Fld).Predecessor = F_DHE_FFDHE3072),
          when F_RBAA_TPM_ALG_RSAPSS_2048 =>
             (Valid (Ctx.Cursors (F_RBAA_TPM_ALG_RSASSA_3072))
              and Ctx.Cursors (Fld).Predecessor = F_RBAA_TPM_ALG_RSASSA_3072),
          when F_DHE_Reserved_2 =>
             (Valid (Ctx.Cursors (F_DHE_FFDHE2048))
              and Ctx.Cursors (Fld).Predecessor = F_DHE_FFDHE2048),
          when F_RBAA_TPM_ALG_RSASSA_2048 =>
             (Valid (Ctx.Cursors (F_RBAA_TPM_ALG_RSAPSS_2048))
              and Ctx.Cursors (Fld).Predecessor = F_RBAA_TPM_ALG_RSAPSS_2048),
          when F_RBAA_Reserved_1 =>
             (Valid (Ctx.Cursors (F_RBAA_TPM_ALG_RSASSA_2048))
              and Ctx.Cursors (Fld).Predecessor = F_RBAA_TPM_ALG_RSASSA_2048),
          when F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P521 =>
             (Valid (Ctx.Cursors (F_RBAA_Reserved_1))
              and Ctx.Cursors (Fld).Predecessor = F_RBAA_Reserved_1),
          when F_Alg_External =>
             (Valid (Ctx.Cursors (F_AEAD_Reserved_2))
              and Ctx.Cursors (Fld).Predecessor = F_AEAD_Reserved_2)
             or (Valid (Ctx.Cursors (F_DHE_Reserved_2))
                 and Ctx.Cursors (Fld).Predecessor = F_DHE_Reserved_2)
             or (Valid (Ctx.Cursors (F_KS_Reserved_2))
                 and Ctx.Cursors (Fld).Predecessor = F_KS_Reserved_2)
             or (Valid (Ctx.Cursors (F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P521))
                 and Ctx.Cursors (Fld).Predecessor = F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P521),
          when F_Final =>
             (Structural_Valid (Ctx.Cursors (F_Alg_External))
              and Ctx.Cursors (Fld).Predecessor = F_Alg_External)));

   function Valid_Next (Ctx : Context; Fld : Field) return Boolean is
     (Valid_Predecessor (Ctx, Fld)
      and then Path_Condition (Ctx, Fld));

   function Available_Space (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Length is
     (Ctx.Last - Field_First (Ctx, Fld) + 1);

   function Sufficient_Space (Ctx : Context; Fld : Field) return Boolean is
     (Available_Space (Ctx, Fld) >= Field_Size (Ctx, Fld));

   function Present (Ctx : Context; Fld : Field) return Boolean is
     (Structural_Valid (Ctx.Cursors (Fld))
      and then Ctx.Cursors (Fld).First < Ctx.Cursors (Fld).Last + 1);

   function Structural_Valid (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Valid
      or Ctx.Cursors (Fld).State = S_Structural_Valid);

   function Valid (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Valid
      and then Ctx.Cursors (Fld).First < Ctx.Cursors (Fld).Last + 1);

   function Incomplete (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Incomplete);

   function Invalid (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Invalid
      or Ctx.Cursors (Fld).State = S_Incomplete);

   function Structural_Valid_Message (Ctx : Context) return Boolean is
     (Structural_Valid (Ctx, F_Alg_External));

   function Valid_Message (Ctx : Context) return Boolean is
     (Valid (Ctx, F_Alg_External));

   function Incomplete_Message (Ctx : Context) return Boolean is
     ((for some F in Field =>
          Incomplete (Ctx, F)));

   function Get_Alg_Type (Ctx : Context) return RFLX.SPDM.Alg_Type is
     (To_Actual (Ctx.Cursors (F_Alg_Type).Value));

   function Get_Fixed_Alg_Count (Ctx : Context) return RFLX.SPDM.Alg_Count is
     (To_Actual (Ctx.Cursors (F_Fixed_Alg_Count).Value));

   function Get_Ext_Alg_Count (Ctx : Context) return RFLX.SPDM.Alg_Count is
     (To_Actual (Ctx.Cursors (F_Ext_Alg_Count).Value));

   function Get_AEAD_Reserved_1 (Ctx : Context) return RFLX.SPDM.Reserved_5 is
     (To_Actual (Ctx.Cursors (F_AEAD_Reserved_1).Value));

   function Get_DHE_Reserved_1 (Ctx : Context) return RFLX.SPDM.Reserved_2 is
     (To_Actual (Ctx.Cursors (F_DHE_Reserved_1).Value));

   function Get_KS_Reserved_1 (Ctx : Context) return RFLX.SPDM.Reserved_7 is
     (To_Actual (Ctx.Cursors (F_KS_Reserved_1).Value));

   function Get_RBAA_TPM_ALG_ECDSA_ECC_NIST_P384 (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P384).Value));

   function Get_AEAD_ChaCha20_Poly1305 (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_AEAD_ChaCha20_Poly1305).Value));

   function Get_DHE_SecP521r1 (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_DHE_SecP521r1).Value));

   function Get_KS_SPDM (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_KS_SPDM).Value));

   function Get_RBAA_TPM_ALG_RSAPSS_4096 (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_RBAA_TPM_ALG_RSAPSS_4096).Value));

   function Get_AEAD_AES_256_GCM (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_AEAD_AES_256_GCM).Value));

   function Get_DHE_SecP384r1 (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_DHE_SecP384r1).Value));

   function Get_KS_Reserved_2 (Ctx : Context) return RFLX.SPDM.Reserved_8 is
     (To_Actual (Ctx.Cursors (F_KS_Reserved_2).Value));

   function Get_RBAA_TPM_ALG_RSASSA_4096 (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_RBAA_TPM_ALG_RSASSA_4096).Value));

   function Get_AEAD_AES_128_GCM (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_AEAD_AES_128_GCM).Value));

   function Get_DHE_SecP256r1 (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_DHE_SecP256r1).Value));

   function Get_RBAA_TPM_ALG_ECDSA_ECC_NIST_P256 (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P256).Value));

   function Get_AEAD_Reserved_2 (Ctx : Context) return RFLX.SPDM.Reserved_8 is
     (To_Actual (Ctx.Cursors (F_AEAD_Reserved_2).Value));

   function Get_DHE_FFDHE4096 (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_DHE_FFDHE4096).Value));

   function Get_RBAA_TPM_ALG_RSAPSS_3072 (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_RBAA_TPM_ALG_RSAPSS_3072).Value));

   function Get_DHE_FFDHE3072 (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_DHE_FFDHE3072).Value));

   function Get_RBAA_TPM_ALG_RSASSA_3072 (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_RBAA_TPM_ALG_RSASSA_3072).Value));

   function Get_DHE_FFDHE2048 (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_DHE_FFDHE2048).Value));

   function Get_RBAA_TPM_ALG_RSAPSS_2048 (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_RBAA_TPM_ALG_RSAPSS_2048).Value));

   function Get_DHE_Reserved_2 (Ctx : Context) return RFLX.SPDM.Reserved_8 is
     (To_Actual (Ctx.Cursors (F_DHE_Reserved_2).Value));

   function Get_RBAA_TPM_ALG_RSASSA_2048 (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_RBAA_TPM_ALG_RSASSA_2048).Value));

   function Get_RBAA_Reserved_1 (Ctx : Context) return RFLX.SPDM.Reserved_7 is
     (To_Actual (Ctx.Cursors (F_RBAA_Reserved_1).Value));

   function Get_RBAA_TPM_ALG_ECDSA_ECC_NIST_P521 (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_RBAA_TPM_ALG_ECDSA_ECC_NIST_P521).Value));

   function Valid_Size (Ctx : Context; Fld : Field; Size : RFLX_Types.Bit_Length) return Boolean is
     (Size = Field_Size (Ctx, Fld))
    with
     Pre =>
       RFLX.SPDM.Alg_Struct.Valid_Next (Ctx, Fld);

   function Valid_Length (Ctx : Context; Fld : Field; Length : RFLX_Types.Length) return Boolean is
     (Valid_Size (Ctx, Fld, RFLX_Types.To_Bit_Length (Length)));

   function Complete_Alg_External (Ctx : Context; Seq_Ctx : RFLX.SPDM.Ext_Algs.Context) return Boolean is
     (RFLX.SPDM.Ext_Algs.Valid (Seq_Ctx)
      and RFLX.SPDM.Ext_Algs.Size (Seq_Ctx) = Field_Size (Ctx, F_Alg_External));

   function Context_Cursor (Ctx : Context; Fld : Field) return Field_Cursor is
     (Ctx.Cursors (Fld));

   function Context_Cursors (Ctx : Context) return Field_Cursors is
     (Ctx.Cursors);

   function Context_Cursors_Index (Cursors : Field_Cursors; Fld : Field) return Field_Cursor is
     (Cursors (Fld));

end RFLX.SPDM.Alg_Struct;
