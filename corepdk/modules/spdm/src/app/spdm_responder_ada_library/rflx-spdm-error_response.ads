private

   type Cursor_State is (S_Valid, S_Structural_Valid, S_Invalid, S_Incomplete);

   type Field_Cursor (State : Cursor_State := S_Invalid) is
      record
         Predecessor : Virtual_Field := F_Final;
         case State is
            when S_Valid | S_Structural_Valid =>
               First : RFLX_Types.Bit_Index := RFLX_Types.Bit_Index'First;
               Last : RFLX_Types.Bit_Length := RFLX_Types.Bit_Length'First;
               Value : RFLX_Types.Base_Integer := 0;
            when S_Invalid | S_Incomplete =>
               null;
         end case;
      end record;

   type Field_Cursors is array (Virtual_Field) of Field_Cursor;

   function Structural_Valid (Cursor : Field_Cursor) return Boolean is
     (Cursor.State = S_Valid
      or Cursor.State = S_Structural_Valid);

   function Valid (Cursor : Field_Cursor) return Boolean is
     (Cursor.State = S_Valid);

   function Invalid (Cursor : Field_Cursor) return Boolean is
     (Cursor.State = S_Invalid
      or Cursor.State = S_Incomplete);

   pragma Warnings (Off, """Buffer"" is not modified, could be of access constant type");

   pragma Warnings (Off, "postcondition does not mention function result");

   function Valid_Context (Buffer_First, Buffer_Last : RFLX_Types.Index; First : RFLX_Types.Bit_Index; Last : RFLX_Types.Bit_Length; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length; Buffer : RFLX_Types.Bytes_Ptr; Cursors : Field_Cursors) return Boolean is
     ((if Buffer /= null then Buffer'First = Buffer_First and Buffer'Last = Buffer_Last)
      and then (RFLX_Types.To_Index (First) >= Buffer_First
                and RFLX_Types.To_Index (Last) <= Buffer_Last
                and Buffer_Last < RFLX_Types.Index'Last
                and First <= Last + 1
                and Last < RFLX_Types.Bit_Index'Last
                and First rem RFLX_Types.Byte'Size = 1
                and Last rem RFLX_Types.Byte'Size = 0)
      and then First - 1 <= Verified_Last
      and then First - 1 <= Written_Last
      and then Verified_Last <= Written_Last
      and then Written_Last <= Last
      and then First rem RFLX_Types.Byte'Size = 1
      and then Last rem RFLX_Types.Byte'Size = 0
      and then Verified_Last rem RFLX_Types.Byte'Size = 0
      and then Written_Last rem RFLX_Types.Byte'Size = 0
      and then (for all F in Field =>
                   (if
                       Structural_Valid (Cursors (F))
                    then
                       Cursors (F).First >= First
                       and Cursors (F).Last <= Verified_Last
                       and Cursors (F).First <= Cursors (F).Last + 1
                       and Valid_Value (F, Cursors (F).Value)))
      and then ((if
                    Structural_Valid (Cursors (F_Invalid_Session_ID))
                 then
                    (Valid (Cursors (F_Error_Code))
                     and then Cursors (F_Invalid_Session_ID).Predecessor = F_Error_Code
                     and then RFLX_Types.Base_Integer (Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Invalid_Session))))
                and then (if
                             Structural_Valid (Cursors (F_Registry_ID))
                          then
                             (Valid (Cursors (F_Error_Code))
                              and then Cursors (F_Registry_ID).Predecessor = F_Error_Code
                              and then RFLX_Types.Base_Integer (Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Vendor))))
                and then (if
                             Structural_Valid (Cursors (F_Request_Response_Code))
                          then
                             (Valid (Cursors (F_Error_Code))
                              and then Cursors (F_Request_Response_Code).Predecessor = F_Error_Code
                              and then RFLX_Types.Base_Integer (Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Unsupported_Request))))
                and then (if
                             Structural_Valid (Cursors (F_Reserved_Error_Data))
                          then
                             (Valid (Cursors (F_Error_Code))
                              and then Cursors (F_Reserved_Error_Data).Predecessor = F_Error_Code
                              and then (RFLX_Types.Base_Integer (Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Session_Limit_Exceeded))
                                        or RFLX_Types.Base_Integer (Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Invalid_Response_Code))
                                        or RFLX_Types.Base_Integer (Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Decrypt_Error))
                                        or RFLX_Types.Base_Integer (Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Request_In_Flight)))))
                and then (if
                             Structural_Valid (Cursors (F_Zero_Error_Data))
                          then
                             (Valid (Cursors (F_Error_Code))
                              and then Cursors (F_Zero_Error_Data).Predecessor = F_Error_Code
                              and then (RFLX_Types.Base_Integer (Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Request_Resynch))
                                        or RFLX_Types.Base_Integer (Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Response_Not_Ready))
                                        or RFLX_Types.Base_Integer (Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Major_Version_Mismatch))
                                        or RFLX_Types.Base_Integer (Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Unspecified))
                                        or RFLX_Types.Base_Integer (Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Unexpected_Request))
                                        or RFLX_Types.Base_Integer (Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Invalid_Request))
                                        or RFLX_Types.Base_Integer (Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Busy)))))
                and then (if
                             Structural_Valid (Cursors (F_Vendor_ID_Len))
                          then
                             (Valid (Cursors (F_Registry_ID))
                              and then Cursors (F_Vendor_ID_Len).Predecessor = F_Registry_ID))
                and then (if
                             Structural_Valid (Cursors (F_Response_Not_Ready_Data_RDT_Exponent))
                          then
                             (Valid (Cursors (F_Zero_Error_Data))
                              and then Cursors (F_Response_Not_Ready_Data_RDT_Exponent).Predecessor = F_Zero_Error_Data
                              and then RFLX_Types.Base_Integer (Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Response_Not_Ready))))
                and then (if
                             Structural_Valid (Cursors (F_Vendor_ID_Double))
                          then
                             (Valid (Cursors (F_Vendor_ID_Len))
                              and then Cursors (F_Vendor_ID_Double).Predecessor = F_Vendor_ID_Len
                              and then (Cursors (F_Vendor_ID_Len).Value = 2
                                        and (RFLX_Types.Base_Integer (Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_JEDEC))
                                             or RFLX_Types.Base_Integer (Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_CXL))
                                             or RFLX_Types.Base_Integer (Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_MIPI))
                                             or RFLX_Types.Base_Integer (Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_PCI_SIG))
                                             or RFLX_Types.Base_Integer (Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_TCG))
                                             or RFLX_Types.Base_Integer (Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_USB))))))
                and then (if
                             Structural_Valid (Cursors (F_Vendor_ID_Quad))
                          then
                             (Valid (Cursors (F_Vendor_ID_Len))
                              and then Cursors (F_Vendor_ID_Quad).Predecessor = F_Vendor_ID_Len
                              and then (Cursors (F_Vendor_ID_Len).Value = 4
                                        and (RFLX_Types.Base_Integer (Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_IANA))
                                             or RFLX_Types.Base_Integer (Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_HD_Base_T))))))
                and then (if
                             Structural_Valid (Cursors (F_Response_Not_Ready_Data_Request_Code))
                          then
                             (Valid (Cursors (F_Response_Not_Ready_Data_RDT_Exponent))
                              and then Cursors (F_Response_Not_Ready_Data_Request_Code).Predecessor = F_Response_Not_Ready_Data_RDT_Exponent))
                and then (if
                             Structural_Valid (Cursors (F_Opaque_Error_Data))
                          then
                             (Valid (Cursors (F_Vendor_ID_Double))
                              and then Cursors (F_Opaque_Error_Data).Predecessor = F_Vendor_ID_Double)
                             or (Valid (Cursors (F_Vendor_ID_Len))
                                 and then Cursors (F_Opaque_Error_Data).Predecessor = F_Vendor_ID_Len
                                 and then (Cursors (F_Vendor_ID_Len).Value = 0
                                           and RFLX_Types.Base_Integer (Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_DMTF))))
                             or (Valid (Cursors (F_Vendor_ID_Quad))
                                 and then Cursors (F_Opaque_Error_Data).Predecessor = F_Vendor_ID_Quad))
                and then (if
                             Structural_Valid (Cursors (F_Response_Not_Ready_Data_Token))
                          then
                             (Valid (Cursors (F_Response_Not_Ready_Data_Request_Code))
                              and then Cursors (F_Response_Not_Ready_Data_Token).Predecessor = F_Response_Not_Ready_Data_Request_Code))
                and then (if
                             Structural_Valid (Cursors (F_Response_Not_Ready_Data_RDTM))
                          then
                             (Valid (Cursors (F_Response_Not_Ready_Data_Token))
                              and then Cursors (F_Response_Not_Ready_Data_RDTM).Predecessor = F_Response_Not_Ready_Data_Token)))
      and then ((if Invalid (Cursors (F_Error_Code)) then Invalid (Cursors (F_Invalid_Session_ID)))
                and then (if Invalid (Cursors (F_Error_Code)) then Invalid (Cursors (F_Registry_ID)))
                and then (if Invalid (Cursors (F_Error_Code)) then Invalid (Cursors (F_Request_Response_Code)))
                and then (if Invalid (Cursors (F_Error_Code)) then Invalid (Cursors (F_Reserved_Error_Data)))
                and then (if Invalid (Cursors (F_Error_Code)) then Invalid (Cursors (F_Zero_Error_Data)))
                and then (if Invalid (Cursors (F_Registry_ID)) then Invalid (Cursors (F_Vendor_ID_Len)))
                and then (if
                             Invalid (Cursors (F_Zero_Error_Data))
                          then
                             Invalid (Cursors (F_Response_Not_Ready_Data_RDT_Exponent)))
                and then (if Invalid (Cursors (F_Vendor_ID_Len)) then Invalid (Cursors (F_Vendor_ID_Double)))
                and then (if Invalid (Cursors (F_Vendor_ID_Len)) then Invalid (Cursors (F_Vendor_ID_Quad)))
                and then (if
                             Invalid (Cursors (F_Response_Not_Ready_Data_RDT_Exponent))
                          then
                             Invalid (Cursors (F_Response_Not_Ready_Data_Request_Code)))
                and then (if
                             Invalid (Cursors (F_Vendor_ID_Double))
                             and then Invalid (Cursors (F_Vendor_ID_Len))
                             and then Invalid (Cursors (F_Vendor_ID_Quad))
                          then
                             Invalid (Cursors (F_Opaque_Error_Data)))
                and then (if
                             Invalid (Cursors (F_Response_Not_Ready_Data_Request_Code))
                          then
                             Invalid (Cursors (F_Response_Not_Ready_Data_Token)))
                and then (if
                             Invalid (Cursors (F_Response_Not_Ready_Data_Token))
                          then
                             Invalid (Cursors (F_Response_Not_Ready_Data_RDTM))))
      and then (if
                   Structural_Valid (Cursors (F_Error_Code))
                then
                   Cursors (F_Error_Code).Last - Cursors (F_Error_Code).First + 1 = 8
                   and then Cursors (F_Error_Code).Predecessor = F_Initial
                   and then Cursors (F_Error_Code).First = First
                   and then (if
                                Structural_Valid (Cursors (F_Invalid_Session_ID))
                                and then RFLX_Types.Base_Integer (Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Invalid_Session))
                             then
                                Cursors (F_Invalid_Session_ID).Last - Cursors (F_Invalid_Session_ID).First + 1 = 8
                                and then Cursors (F_Invalid_Session_ID).Predecessor = F_Error_Code
                                and then Cursors (F_Invalid_Session_ID).First = Cursors (F_Error_Code).Last + 1)
                   and then (if
                                Structural_Valid (Cursors (F_Registry_ID))
                                and then RFLX_Types.Base_Integer (Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Vendor))
                             then
                                Cursors (F_Registry_ID).Last - Cursors (F_Registry_ID).First + 1 = 8
                                and then Cursors (F_Registry_ID).Predecessor = F_Error_Code
                                and then Cursors (F_Registry_ID).First = Cursors (F_Error_Code).Last + 1
                                and then (if
                                             Structural_Valid (Cursors (F_Vendor_ID_Len))
                                          then
                                             Cursors (F_Vendor_ID_Len).Last - Cursors (F_Vendor_ID_Len).First + 1 = 8
                                             and then Cursors (F_Vendor_ID_Len).Predecessor = F_Registry_ID
                                             and then Cursors (F_Vendor_ID_Len).First = Cursors (F_Registry_ID).Last + 1
                                             and then (if
                                                          Structural_Valid (Cursors (F_Opaque_Error_Data))
                                                          and then (Cursors (F_Vendor_ID_Len).Value = 0
                                                                    and RFLX_Types.Base_Integer (Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_DMTF)))
                                                       then
                                                          Cursors (F_Opaque_Error_Data).Last - Cursors (F_Opaque_Error_Data).First + 1 = RFLX_Types.Bit_Length (Written_Last) - RFLX_Types.Bit_Length (Cursors (F_Vendor_ID_Len).Last)
                                                          and then Cursors (F_Opaque_Error_Data).Predecessor = F_Vendor_ID_Len
                                                          and then Cursors (F_Opaque_Error_Data).First = Cursors (F_Vendor_ID_Len).Last + 1)
                                             and then (if
                                                          Structural_Valid (Cursors (F_Vendor_ID_Double))
                                                          and then (Cursors (F_Vendor_ID_Len).Value = 2
                                                                    and (RFLX_Types.Base_Integer (Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_JEDEC))
                                                                         or RFLX_Types.Base_Integer (Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_CXL))
                                                                         or RFLX_Types.Base_Integer (Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_MIPI))
                                                                         or RFLX_Types.Base_Integer (Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_PCI_SIG))
                                                                         or RFLX_Types.Base_Integer (Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_TCG))
                                                                         or RFLX_Types.Base_Integer (Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_USB))))
                                                       then
                                                          Cursors (F_Vendor_ID_Double).Last - Cursors (F_Vendor_ID_Double).First + 1 = 16
                                                          and then Cursors (F_Vendor_ID_Double).Predecessor = F_Vendor_ID_Len
                                                          and then Cursors (F_Vendor_ID_Double).First = Cursors (F_Vendor_ID_Len).Last + 1
                                                          and then (if
                                                                       Structural_Valid (Cursors (F_Opaque_Error_Data))
                                                                    then
                                                                       Cursors (F_Opaque_Error_Data).Last - Cursors (F_Opaque_Error_Data).First + 1 = RFLX_Types.Bit_Length (Written_Last) - RFLX_Types.Bit_Length (Cursors (F_Vendor_ID_Double).Last)
                                                                       and then Cursors (F_Opaque_Error_Data).Predecessor = F_Vendor_ID_Double
                                                                       and then Cursors (F_Opaque_Error_Data).First = Cursors (F_Vendor_ID_Double).Last + 1))
                                             and then (if
                                                          Structural_Valid (Cursors (F_Vendor_ID_Quad))
                                                          and then (Cursors (F_Vendor_ID_Len).Value = 4
                                                                    and (RFLX_Types.Base_Integer (Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_IANA))
                                                                         or RFLX_Types.Base_Integer (Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_HD_Base_T))))
                                                       then
                                                          Cursors (F_Vendor_ID_Quad).Last - Cursors (F_Vendor_ID_Quad).First + 1 = 32
                                                          and then Cursors (F_Vendor_ID_Quad).Predecessor = F_Vendor_ID_Len
                                                          and then Cursors (F_Vendor_ID_Quad).First = Cursors (F_Vendor_ID_Len).Last + 1
                                                          and then (if
                                                                       Structural_Valid (Cursors (F_Opaque_Error_Data))
                                                                    then
                                                                       Cursors (F_Opaque_Error_Data).Last - Cursors (F_Opaque_Error_Data).First + 1 = RFLX_Types.Bit_Length (Written_Last) - RFLX_Types.Bit_Length (Cursors (F_Vendor_ID_Quad).Last)
                                                                       and then Cursors (F_Opaque_Error_Data).Predecessor = F_Vendor_ID_Quad
                                                                       and then Cursors (F_Opaque_Error_Data).First = Cursors (F_Vendor_ID_Quad).Last + 1))))
                   and then (if
                                Structural_Valid (Cursors (F_Request_Response_Code))
                                and then RFLX_Types.Base_Integer (Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Unsupported_Request))
                             then
                                Cursors (F_Request_Response_Code).Last - Cursors (F_Request_Response_Code).First + 1 = 8
                                and then Cursors (F_Request_Response_Code).Predecessor = F_Error_Code
                                and then Cursors (F_Request_Response_Code).First = Cursors (F_Error_Code).Last + 1)
                   and then (if
                                Structural_Valid (Cursors (F_Reserved_Error_Data))
                                and then (RFLX_Types.Base_Integer (Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Session_Limit_Exceeded))
                                          or RFLX_Types.Base_Integer (Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Invalid_Response_Code))
                                          or RFLX_Types.Base_Integer (Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Decrypt_Error))
                                          or RFLX_Types.Base_Integer (Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Request_In_Flight)))
                             then
                                Cursors (F_Reserved_Error_Data).Last - Cursors (F_Reserved_Error_Data).First + 1 = 8
                                and then Cursors (F_Reserved_Error_Data).Predecessor = F_Error_Code
                                and then Cursors (F_Reserved_Error_Data).First = Cursors (F_Error_Code).Last + 1)
                   and then (if
                                Structural_Valid (Cursors (F_Zero_Error_Data))
                                and then (RFLX_Types.Base_Integer (Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Request_Resynch))
                                          or RFLX_Types.Base_Integer (Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Response_Not_Ready))
                                          or RFLX_Types.Base_Integer (Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Major_Version_Mismatch))
                                          or RFLX_Types.Base_Integer (Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Unspecified))
                                          or RFLX_Types.Base_Integer (Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Unexpected_Request))
                                          or RFLX_Types.Base_Integer (Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Invalid_Request))
                                          or RFLX_Types.Base_Integer (Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Busy)))
                             then
                                Cursors (F_Zero_Error_Data).Last - Cursors (F_Zero_Error_Data).First + 1 = 8
                                and then Cursors (F_Zero_Error_Data).Predecessor = F_Error_Code
                                and then Cursors (F_Zero_Error_Data).First = Cursors (F_Error_Code).Last + 1
                                and then (if
                                             Structural_Valid (Cursors (F_Response_Not_Ready_Data_RDT_Exponent))
                                             and then RFLX_Types.Base_Integer (Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Response_Not_Ready))
                                          then
                                             Cursors (F_Response_Not_Ready_Data_RDT_Exponent).Last - Cursors (F_Response_Not_Ready_Data_RDT_Exponent).First + 1 = 8
                                             and then Cursors (F_Response_Not_Ready_Data_RDT_Exponent).Predecessor = F_Zero_Error_Data
                                             and then Cursors (F_Response_Not_Ready_Data_RDT_Exponent).First = Cursors (F_Zero_Error_Data).Last + 1
                                             and then (if
                                                          Structural_Valid (Cursors (F_Response_Not_Ready_Data_Request_Code))
                                                       then
                                                          Cursors (F_Response_Not_Ready_Data_Request_Code).Last - Cursors (F_Response_Not_Ready_Data_Request_Code).First + 1 = 8
                                                          and then Cursors (F_Response_Not_Ready_Data_Request_Code).Predecessor = F_Response_Not_Ready_Data_RDT_Exponent
                                                          and then Cursors (F_Response_Not_Ready_Data_Request_Code).First = Cursors (F_Response_Not_Ready_Data_RDT_Exponent).Last + 1
                                                          and then (if
                                                                       Structural_Valid (Cursors (F_Response_Not_Ready_Data_Token))
                                                                    then
                                                                       Cursors (F_Response_Not_Ready_Data_Token).Last - Cursors (F_Response_Not_Ready_Data_Token).First + 1 = 8
                                                                       and then Cursors (F_Response_Not_Ready_Data_Token).Predecessor = F_Response_Not_Ready_Data_Request_Code
                                                                       and then Cursors (F_Response_Not_Ready_Data_Token).First = Cursors (F_Response_Not_Ready_Data_Request_Code).Last + 1
                                                                       and then (if
                                                                                    Structural_Valid (Cursors (F_Response_Not_Ready_Data_RDTM))
                                                                                 then
                                                                                    Cursors (F_Response_Not_Ready_Data_RDTM).Last - Cursors (F_Response_Not_Ready_Data_RDTM).First + 1 = 8
                                                                                    and then Cursors (F_Response_Not_Ready_Data_RDTM).Predecessor = F_Response_Not_Ready_Data_Token
                                                                                    and then Cursors (F_Response_Not_Ready_Data_RDTM).First = Cursors (F_Response_Not_Ready_Data_Token).Last + 1)))))));

   pragma Warnings (On, """Buffer"" is not modified, could be of access constant type");

   pragma Warnings (On, "postcondition does not mention function result");

   type Context (Buffer_First, Buffer_Last : RFLX_Types.Index := RFLX_Types.Index'First; First : RFLX_Types.Bit_Index := RFLX_Types.Bit_Index'First; Last : RFLX_Types.Bit_Length := RFLX_Types.Bit_Length'First) is
      record
         Verified_Last : RFLX_Types.Bit_Length := First - 1;
         Written_Last : RFLX_Types.Bit_Length := First - 1;
         Buffer : RFLX_Types.Bytes_Ptr := null;
         Cursors : Field_Cursors := [others => (State => S_Invalid, Predecessor => F_Final)];
      end record with
     Dynamic_Predicate =>
       Valid_Context (Context.Buffer_First, Context.Buffer_Last, Context.First, Context.Last, Context.Verified_Last, Context.Written_Last, Context.Buffer, Context.Cursors);

   function Initialized (Ctx : Context) return Boolean is
     (Ctx.Verified_Last = Ctx.First - 1
      and then Valid_Next (Ctx, F_Error_Code)
      and then RFLX.SPDM.Error_Response.Field_First (Ctx, RFLX.SPDM.Error_Response.F_Error_Code) rem RFLX_Types.Byte'Size = 1
      and then Available_Space (Ctx, F_Error_Code) = Ctx.Last - Ctx.First + 1
      and then (for all F in Field =>
                   Invalid (Ctx, F)));

   function Has_Buffer (Ctx : Context) return Boolean is
     (Ctx.Buffer /= null);

   function Buffer_Length (Ctx : Context) return RFLX_Types.Length is
     (Ctx.Buffer'Length);

   function Size (Ctx : Context) return RFLX_Types.Bit_Length is
     (Ctx.Verified_Last - Ctx.First + 1);

   function Byte_Size (Ctx : Context) return RFLX_Types.Length is
     (RFLX_Types.To_Length (Size (Ctx)));

   function Message_Last (Ctx : Context) return RFLX_Types.Bit_Length is
     (Ctx.Verified_Last);

   function Written_Last (Ctx : Context) return RFLX_Types.Bit_Length is
     (Ctx.Written_Last);

   function Valid_Value (Fld : Field; Val : RFLX_Types.Base_Integer) return Boolean is
     ((case Fld is
          when F_Error_Code =>
             RFLX.SPDM.Valid_Error_Code (Val),
          when F_Invalid_Session_ID =>
             RFLX.SPDM.Valid_Error_Session_ID (Val),
          when F_Registry_ID =>
             RFLX.SPDM.Valid_Registry_ID (Val),
          when F_Request_Response_Code =>
             RFLX.SPDM.Valid_Request_Code (Val),
          when F_Reserved_Error_Data =>
             RFLX.SPDM.Valid_Reserved_8 (Val),
          when F_Zero_Error_Data =>
             RFLX.SPDM.Valid_Zero_Error_Data (Val),
          when F_Vendor_ID_Len =>
             RFLX.SPDM.Valid_Vendor_ID_Len (Val),
          when F_Response_Not_Ready_Data_RDT_Exponent =>
             RFLX.SPDM.Valid_RDT_Exponent (Val),
          when F_Vendor_ID_Double =>
             RFLX.SPDM.Valid_Vendor_ID_Double (Val),
          when F_Vendor_ID_Quad =>
             RFLX.SPDM.Valid_Vendor_ID_Quad (Val),
          when F_Response_Not_Ready_Data_Request_Code =>
             RFLX.SPDM.Valid_Request_Code (Val),
          when F_Opaque_Error_Data =>
             True,
          when F_Response_Not_Ready_Data_Token =>
             RFLX.SPDM.Valid_Token (Val),
          when F_Response_Not_Ready_Data_RDTM =>
             RFLX.SPDM.Valid_RDTM (Val)));

   function Path_Condition (Ctx : Context; Fld : Field) return Boolean is
     ((case Ctx.Cursors (Fld).Predecessor is
          when F_Initial | F_Invalid_Session_ID | F_Registry_ID | F_Request_Response_Code | F_Reserved_Error_Data | F_Response_Not_Ready_Data_RDT_Exponent | F_Vendor_ID_Double | F_Vendor_ID_Quad | F_Response_Not_Ready_Data_Request_Code | F_Opaque_Error_Data | F_Response_Not_Ready_Data_Token | F_Response_Not_Ready_Data_RDTM | F_Final =>
             True,
          when F_Error_Code =>
             (case Fld is
                 when F_Invalid_Session_ID =>
                    RFLX_Types.Base_Integer (Ctx.Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Invalid_Session)),
                 when F_Registry_ID =>
                    RFLX_Types.Base_Integer (Ctx.Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Vendor)),
                 when F_Request_Response_Code =>
                    RFLX_Types.Base_Integer (Ctx.Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Unsupported_Request)),
                 when F_Reserved_Error_Data =>
                    RFLX_Types.Base_Integer (Ctx.Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Session_Limit_Exceeded))
                    or RFLX_Types.Base_Integer (Ctx.Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Invalid_Response_Code))
                    or RFLX_Types.Base_Integer (Ctx.Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Decrypt_Error))
                    or RFLX_Types.Base_Integer (Ctx.Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Request_In_Flight)),
                 when F_Zero_Error_Data =>
                    RFLX_Types.Base_Integer (Ctx.Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Request_Resynch))
                    or RFLX_Types.Base_Integer (Ctx.Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Response_Not_Ready))
                    or RFLX_Types.Base_Integer (Ctx.Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Major_Version_Mismatch))
                    or RFLX_Types.Base_Integer (Ctx.Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Unspecified))
                    or RFLX_Types.Base_Integer (Ctx.Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Unexpected_Request))
                    or RFLX_Types.Base_Integer (Ctx.Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Invalid_Request))
                    or RFLX_Types.Base_Integer (Ctx.Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Busy)),
                 when others =>
                    False),
          when F_Zero_Error_Data =>
             RFLX_Types.Base_Integer (Ctx.Cursors (F_Error_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Response_Not_Ready)),
          when F_Vendor_ID_Len =>
             (case Fld is
                 when F_Opaque_Error_Data =>
                    Ctx.Cursors (F_Vendor_ID_Len).Value = 0
                    and RFLX_Types.Base_Integer (Ctx.Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_DMTF)),
                 when F_Vendor_ID_Double =>
                    Ctx.Cursors (F_Vendor_ID_Len).Value = 2
                    and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_JEDEC))
                         or RFLX_Types.Base_Integer (Ctx.Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_CXL))
                         or RFLX_Types.Base_Integer (Ctx.Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_MIPI))
                         or RFLX_Types.Base_Integer (Ctx.Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_PCI_SIG))
                         or RFLX_Types.Base_Integer (Ctx.Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_TCG))
                         or RFLX_Types.Base_Integer (Ctx.Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_USB))),
                 when F_Vendor_ID_Quad =>
                    Ctx.Cursors (F_Vendor_ID_Len).Value = 4
                    and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_IANA))
                         or RFLX_Types.Base_Integer (Ctx.Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_HD_Base_T))),
                 when others =>
                    False)));

   function Field_Condition (Ctx : Context; Fld : Field; Val : RFLX_Types.Base_Integer) return Boolean is
     ((case Fld is
          when F_Error_Code =>
             Val = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Invalid_Session))
             or Val = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Vendor))
             or Val = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Unsupported_Request))
             or Val = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Session_Limit_Exceeded))
             or Val = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Invalid_Response_Code))
             or Val = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Decrypt_Error))
             or Val = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Request_In_Flight))
             or Val = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Request_Resynch))
             or Val = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Response_Not_Ready))
             or Val = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Major_Version_Mismatch))
             or Val = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Unspecified))
             or Val = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Unexpected_Request))
             or Val = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Invalid_Request))
             or Val = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Busy)),
          when F_Invalid_Session_ID | F_Registry_ID | F_Request_Response_Code | F_Reserved_Error_Data | F_Zero_Error_Data =>
             True,
          when F_Vendor_ID_Len =>
             (Val = 0
              and RFLX_Types.Base_Integer (Ctx.Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_DMTF)))
             or (Val = 2
                 and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_JEDEC))
                      or RFLX_Types.Base_Integer (Ctx.Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_CXL))
                      or RFLX_Types.Base_Integer (Ctx.Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_MIPI))
                      or RFLX_Types.Base_Integer (Ctx.Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_PCI_SIG))
                      or RFLX_Types.Base_Integer (Ctx.Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_TCG))
                      or RFLX_Types.Base_Integer (Ctx.Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_USB))))
             or (Val = 4
                 and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_IANA))
                      or RFLX_Types.Base_Integer (Ctx.Cursors (F_Registry_ID).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Reg_HD_Base_T)))),
          when F_Response_Not_Ready_Data_RDT_Exponent | F_Vendor_ID_Double | F_Vendor_ID_Quad | F_Response_Not_Ready_Data_Request_Code | F_Opaque_Error_Data | F_Response_Not_Ready_Data_Token | F_Response_Not_Ready_Data_RDTM =>
             True));

   function Field_Size (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Length is
     ((case Fld is
          when F_Error_Code | F_Invalid_Session_ID | F_Registry_ID | F_Request_Response_Code | F_Reserved_Error_Data | F_Zero_Error_Data | F_Vendor_ID_Len | F_Response_Not_Ready_Data_RDT_Exponent =>
             8,
          when F_Vendor_ID_Double =>
             16,
          when F_Vendor_ID_Quad =>
             32,
          when F_Response_Not_Ready_Data_Request_Code =>
             8,
          when F_Opaque_Error_Data =>
             (if
                 Ctx.Cursors (Fld).Predecessor = F_Vendor_ID_Double
              then
                 RFLX_Types.Bit_Length (Ctx.Written_Last) - RFLX_Types.Bit_Length (Ctx.Cursors (F_Vendor_ID_Double).Last)
              elsif
                 Ctx.Cursors (Fld).Predecessor = F_Vendor_ID_Len
                 and then (Ctx.Cursors (F_Vendor_ID_Len).Value = 0
                           and RFLX_Types.Bit_Length (Ctx.Cursors (F_Registry_ID).Value) = RFLX_Types.Bit_Length (To_Base_Integer (RFLX.SPDM.Reg_DMTF)))
              then
                 RFLX_Types.Bit_Length (Ctx.Written_Last) - RFLX_Types.Bit_Length (Ctx.Cursors (F_Vendor_ID_Len).Last)
              elsif
                 Ctx.Cursors (Fld).Predecessor = F_Vendor_ID_Quad
              then
                 RFLX_Types.Bit_Length (Ctx.Written_Last) - RFLX_Types.Bit_Length (Ctx.Cursors (F_Vendor_ID_Quad).Last)
              else
                 RFLX_Types.Unreachable),
          when F_Response_Not_Ready_Data_Token | F_Response_Not_Ready_Data_RDTM =>
             8));

   function Field_First (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Index is
     ((if Fld = F_Error_Code then Ctx.First else Ctx.Cursors (Ctx.Cursors (Fld).Predecessor).Last + 1));

   function Field_Last (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Length is
     (Field_First (Ctx, Fld) + Field_Size (Ctx, Fld) - 1);

   function Predecessor (Ctx : Context; Fld : Virtual_Field) return Virtual_Field is
     ((case Fld is
          when F_Initial =>
             F_Initial,
          when others =>
             Ctx.Cursors (Fld).Predecessor));

   function Valid_Predecessor (Ctx : Context; Fld : Virtual_Field) return Boolean is
     ((case Fld is
          when F_Initial =>
             True,
          when F_Error_Code =>
             Ctx.Cursors (Fld).Predecessor = F_Initial,
          when F_Invalid_Session_ID | F_Registry_ID | F_Request_Response_Code | F_Reserved_Error_Data | F_Zero_Error_Data =>
             (Valid (Ctx.Cursors (F_Error_Code))
              and Ctx.Cursors (Fld).Predecessor = F_Error_Code),
          when F_Vendor_ID_Len =>
             (Valid (Ctx.Cursors (F_Registry_ID))
              and Ctx.Cursors (Fld).Predecessor = F_Registry_ID),
          when F_Response_Not_Ready_Data_RDT_Exponent =>
             (Valid (Ctx.Cursors (F_Zero_Error_Data))
              and Ctx.Cursors (Fld).Predecessor = F_Zero_Error_Data),
          when F_Vendor_ID_Double | F_Vendor_ID_Quad =>
             (Valid (Ctx.Cursors (F_Vendor_ID_Len))
              and Ctx.Cursors (Fld).Predecessor = F_Vendor_ID_Len),
          when F_Response_Not_Ready_Data_Request_Code =>
             (Valid (Ctx.Cursors (F_Response_Not_Ready_Data_RDT_Exponent))
              and Ctx.Cursors (Fld).Predecessor = F_Response_Not_Ready_Data_RDT_Exponent),
          when F_Opaque_Error_Data =>
             (Valid (Ctx.Cursors (F_Vendor_ID_Double))
              and Ctx.Cursors (Fld).Predecessor = F_Vendor_ID_Double)
             or (Valid (Ctx.Cursors (F_Vendor_ID_Len))
                 and Ctx.Cursors (Fld).Predecessor = F_Vendor_ID_Len)
             or (Valid (Ctx.Cursors (F_Vendor_ID_Quad))
                 and Ctx.Cursors (Fld).Predecessor = F_Vendor_ID_Quad),
          when F_Response_Not_Ready_Data_Token =>
             (Valid (Ctx.Cursors (F_Response_Not_Ready_Data_Request_Code))
              and Ctx.Cursors (Fld).Predecessor = F_Response_Not_Ready_Data_Request_Code),
          when F_Response_Not_Ready_Data_RDTM =>
             (Valid (Ctx.Cursors (F_Response_Not_Ready_Data_Token))
              and Ctx.Cursors (Fld).Predecessor = F_Response_Not_Ready_Data_Token),
          when F_Final =>
             (Valid (Ctx.Cursors (F_Invalid_Session_ID))
              and Ctx.Cursors (Fld).Predecessor = F_Invalid_Session_ID)
             or (Structural_Valid (Ctx.Cursors (F_Opaque_Error_Data))
                 and Ctx.Cursors (Fld).Predecessor = F_Opaque_Error_Data)
             or (Valid (Ctx.Cursors (F_Request_Response_Code))
                 and Ctx.Cursors (Fld).Predecessor = F_Request_Response_Code)
             or (Valid (Ctx.Cursors (F_Reserved_Error_Data))
                 and Ctx.Cursors (Fld).Predecessor = F_Reserved_Error_Data)
             or (Valid (Ctx.Cursors (F_Response_Not_Ready_Data_RDTM))
                 and Ctx.Cursors (Fld).Predecessor = F_Response_Not_Ready_Data_RDTM)
             or (Valid (Ctx.Cursors (F_Zero_Error_Data))
                 and Ctx.Cursors (Fld).Predecessor = F_Zero_Error_Data)));

   function Valid_Next (Ctx : Context; Fld : Field) return Boolean is
     (Valid_Predecessor (Ctx, Fld)
      and then Path_Condition (Ctx, Fld));

   function Available_Space (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Length is
     (Ctx.Last - Field_First (Ctx, Fld) + 1);

   function Sufficient_Space (Ctx : Context; Fld : Field) return Boolean is
     (Available_Space (Ctx, Fld) >= Field_Size (Ctx, Fld));

   function Present (Ctx : Context; Fld : Field) return Boolean is
     (Structural_Valid (Ctx.Cursors (Fld))
      and then Ctx.Cursors (Fld).First < Ctx.Cursors (Fld).Last + 1);

   function Structural_Valid (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Valid
      or Ctx.Cursors (Fld).State = S_Structural_Valid);

   function Valid (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Valid
      and then Ctx.Cursors (Fld).First < Ctx.Cursors (Fld).Last + 1);

   function Incomplete (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Incomplete);

   function Invalid (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Invalid
      or Ctx.Cursors (Fld).State = S_Incomplete);

   function Structural_Valid_Message (Ctx : Context) return Boolean is
     (Valid (Ctx, F_Invalid_Session_ID)
      or Structural_Valid (Ctx, F_Opaque_Error_Data)
      or Valid (Ctx, F_Request_Response_Code)
      or Valid (Ctx, F_Reserved_Error_Data)
      or Valid (Ctx, F_Response_Not_Ready_Data_RDTM)
      or (Valid (Ctx, F_Zero_Error_Data)
          and then RFLX_Types.Base_Integer (Ctx.Cursors (F_Error_Code).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Response_Not_Ready))));

   function Valid_Message (Ctx : Context) return Boolean is
     (Valid (Ctx, F_Invalid_Session_ID)
      or Valid (Ctx, F_Opaque_Error_Data)
      or Valid (Ctx, F_Request_Response_Code)
      or Valid (Ctx, F_Reserved_Error_Data)
      or Valid (Ctx, F_Response_Not_Ready_Data_RDTM)
      or (Valid (Ctx, F_Zero_Error_Data)
          and then RFLX_Types.Base_Integer (Ctx.Cursors (F_Error_Code).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Response_Not_Ready))));

   function Incomplete_Message (Ctx : Context) return Boolean is
     ((for some F in Field =>
          Incomplete (Ctx, F)));

   function Get_Error_Code (Ctx : Context) return RFLX.SPDM.Error_Code is
     (To_Actual (Ctx.Cursors (F_Error_Code).Value));

   function Get_Invalid_Session_ID (Ctx : Context) return RFLX.SPDM.Error_Session_ID is
     (To_Actual (Ctx.Cursors (F_Invalid_Session_ID).Value));

   function Get_Registry_ID (Ctx : Context) return RFLX.SPDM.Registry_ID is
     (To_Actual (Ctx.Cursors (F_Registry_ID).Value));

   function Get_Request_Response_Code (Ctx : Context) return RFLX.SPDM.Request_Code is
     (To_Actual (Ctx.Cursors (F_Request_Response_Code).Value));

   function Get_Reserved_Error_Data (Ctx : Context) return RFLX.SPDM.Reserved_8 is
     (To_Actual (Ctx.Cursors (F_Reserved_Error_Data).Value));

   function Get_Zero_Error_Data (Ctx : Context) return RFLX.SPDM.Zero_Error_Data is
     (To_Actual (Ctx.Cursors (F_Zero_Error_Data).Value));

   function Get_Vendor_ID_Len (Ctx : Context) return RFLX.SPDM.Vendor_ID_Len is
     (To_Actual (Ctx.Cursors (F_Vendor_ID_Len).Value));

   function Get_Response_Not_Ready_Data_RDT_Exponent (Ctx : Context) return RFLX.SPDM.RDT_Exponent is
     (To_Actual (Ctx.Cursors (F_Response_Not_Ready_Data_RDT_Exponent).Value));

   function Get_Vendor_ID_Double (Ctx : Context) return RFLX.SPDM.Vendor_ID_Double is
     (To_Actual (Ctx.Cursors (F_Vendor_ID_Double).Value));

   function Get_Vendor_ID_Quad (Ctx : Context) return RFLX.SPDM.Vendor_ID_Quad is
     (To_Actual (Ctx.Cursors (F_Vendor_ID_Quad).Value));

   function Get_Response_Not_Ready_Data_Request_Code (Ctx : Context) return RFLX.SPDM.Request_Code is
     (To_Actual (Ctx.Cursors (F_Response_Not_Ready_Data_Request_Code).Value));

   function Get_Response_Not_Ready_Data_Token (Ctx : Context) return RFLX.SPDM.Token is
     (To_Actual (Ctx.Cursors (F_Response_Not_Ready_Data_Token).Value));

   function Get_Response_Not_Ready_Data_RDTM (Ctx : Context) return RFLX.SPDM.RDTM is
     (To_Actual (Ctx.Cursors (F_Response_Not_Ready_Data_RDTM).Value));

   function Valid_Size (Ctx : Context; Fld : Field; Size : RFLX_Types.Bit_Length) return Boolean is
     ((if
          Fld = F_Opaque_Error_Data
          and then Ctx.Cursors (Fld).Predecessor = F_Vendor_ID_Double
       then
          Size <= Available_Space (Ctx, Fld)
       elsif
          Fld = F_Opaque_Error_Data
          and then Ctx.Cursors (Fld).Predecessor = F_Vendor_ID_Len
          and then (Ctx.Cursors (F_Vendor_ID_Len).Value = 0
                    and RFLX_Types.Bit_Length (Ctx.Cursors (F_Registry_ID).Value) = RFLX_Types.Bit_Length (To_Base_Integer (RFLX.SPDM.Reg_DMTF)))
       then
          Size <= Available_Space (Ctx, Fld)
       elsif
          Fld = F_Opaque_Error_Data
          and then Ctx.Cursors (Fld).Predecessor = F_Vendor_ID_Quad
       then
          Size <= Available_Space (Ctx, Fld)
       else
          Size = Field_Size (Ctx, Fld)))
    with
     Pre =>
       RFLX.SPDM.Error_Response.Valid_Next (Ctx, Fld);

   function Valid_Length (Ctx : Context; Fld : Field; Length : RFLX_Types.Length) return Boolean is
     (Valid_Size (Ctx, Fld, RFLX_Types.To_Bit_Length (Length)));

   function Context_Cursor (Ctx : Context; Fld : Field) return Field_Cursor is
     (Ctx.Cursors (Fld));

   function Context_Cursors (Ctx : Context) return Field_Cursors is
     (Ctx.Cursors);

   function Context_Cursors_Index (Cursors : Field_Cursors; Fld : Field) return Field_Cursor is
     (Cursors (Fld));

end RFLX.SPDM.Error_Response;
