          when F_Get_Capabilities_Request_Meas_Fresh_Cap =>
             Invalid (Ctx.Cursors (F_Get_Capabilities_Request_Meas_Cap)),
          when F_Negotiate_Algorithms_Request_Base_Asym_Algo_TPM_ALG_RSAPSS_4096 =>
             Invalid (Ctx.Cursors (F_Negotiate_Algorithms_Request_Base_Asym_Algo_TPM_ALG_RSASSA_4096)),
          when F_Get_Capabilities_Request_Meas_Cap =>
             Invalid (Ctx.Cursors (F_Get_Capabilities_Request_Chal_Cap)),
          when F_Negotiate_Algorithms_Request_Base_Asym_Algo_TPM_ALG_RSASSA_4096 =>
             Invalid (Ctx.Cursors (F_Negotiate_Algorithms_Request_Base_Asym_Algo_TPM_ALG_ECDSA_ECC_NIST_P256)),
          when F_Get_Capabilities_Request_Chal_Cap =>
             Invalid (Ctx.Cursors (F_Get_Capabilities_Request_Cert_Cap)),
          when F_Negotiate_Algorithms_Request_Base_Asym_Algo_TPM_ALG_ECDSA_ECC_NIST_P256 =>
             Invalid (Ctx.Cursors (F_Negotiate_Algorithms_Request_Base_Asym_Algo_TPM_ALG_RSAPSS_3072)),
          when F_Get_Capabilities_Request_Cert_Cap =>
             Invalid (Ctx.Cursors (F_Get_Capabilities_Request_Reserved_3)),
          when F_Negotiate_Algorithms_Request_Base_Asym_Algo_TPM_ALG_RSAPSS_3072 =>
             Invalid (Ctx.Cursors (F_Negotiate_Algorithms_Request_Base_Asym_Algo_TPM_ALG_RSASSA_3072)),
          when F_Get_Capabilities_Request_Reserved_3 =>
             Invalid (Ctx.Cursors (F_Get_Capabilities_Request_Handshake_In_The_Clear_Cap)),
          when F_Negotiate_Algorithms_Request_Base_Asym_Algo_TPM_ALG_RSASSA_3072 =>
             Invalid (Ctx.Cursors (F_Negotiate_Algorithms_Request_Base_Asym_Algo_TPM_ALG_RSAPSS_2048)),
          when F_Get_Capabilities_Request_Handshake_In_The_Clear_Cap =>
             Invalid (Ctx.Cursors (F_Get_Capabilities_Request_Key_Upd_Cap)),
          when F_Negotiate_Algorithms_Request_Base_Asym_Algo_TPM_ALG_RSAPSS_2048 =>
             Invalid (Ctx.Cursors (F_Negotiate_Algorithms_Request_Base_Asym_Algo_TPM_ALG_RSASSA_2048)),
          when F_Get_Capabilities_Request_Key_Upd_Cap =>
             Invalid (Ctx.Cursors (F_Get_Capabilities_Request_Hbeat_Cap)),
          when F_Negotiate_Algorithms_Request_Base_Asym_Algo_TPM_ALG_RSASSA_2048 =>
             Invalid (Ctx.Cursors (F_Negotiate_Algorithms_Request_Base_Asym_Algo_Reserved_1)),
          when F_Get_Capabilities_Request_Hbeat_Cap =>
             Invalid (Ctx.Cursors (F_Get_Capabilities_Request_Encap_Cap)),
          when F_Negotiate_Algorithms_Request_Base_Asym_Algo_Reserved_1 =>
             Invalid (Ctx.Cursors (F_Negotiate_Algorithms_Request_Base_Asym_Algo_TPM_ALG_ECDSA_ECC_NIST_P521)),
          when F_Get_Capabilities_Request_Encap_Cap =>
             Invalid (Ctx.Cursors (F_Get_Capabilities_Request_PSK_Cap)),
          when F_Negotiate_Algorithms_Request_Base_Asym_Algo_TPM_ALG_ECDSA_ECC_NIST_P521 =>
             Invalid (Ctx.Cursors (F_Negotiate_Algorithms_Request_Base_Asym_Algo_Reserved_2)),
          when F_Get_Capabilities_Request_PSK_Cap =>
             Invalid (Ctx.Cursors (F_Get_Capabilities_Request_Key_Ex_Cap)),
          when F_Negotiate_Algorithms_Request_Base_Asym_Algo_Reserved_2 =>
             Invalid (Ctx.Cursors (F_Negotiate_Algorithms_Request_Base_Hash_Algo_Reserved_1)),
          when F_Get_Capabilities_Request_Key_Ex_Cap =>
             Invalid (Ctx.Cursors (F_Get_Capabilities_Request_Mut_Auth_Cap)),
          when F_Negotiate_Algorithms_Request_Base_Hash_Algo_Reserved_1 =>
             Invalid (Ctx.Cursors (F_Negotiate_Algorithms_Request_Base_Hash_Algo_TPM_ALG_SHA3_512)),
          when F_Get_Capabilities_Request_Mut_Auth_Cap =>
             Invalid (Ctx.Cursors (F_Get_Capabilities_Request_Pub_Key_ID_Cap)),
          when F_Negotiate_Algorithms_Request_Base_Hash_Algo_TPM_ALG_SHA3_512 =>
             Invalid (Ctx.Cursors (F_Negotiate_Algorithms_Request_Base_Hash_Algo_TPM_ALG_SHA3_384)),
          when F_Get_Capabilities_Request_Pub_Key_ID_Cap =>
             Invalid (Ctx.Cursors (F_Get_Capabilities_Request_Reserved_4)),
          when F_Negotiate_Algorithms_Request_Base_Hash_Algo_TPM_ALG_SHA3_384 =>
             Invalid (Ctx.Cursors (F_Negotiate_Algorithms_Request_Base_Hash_Algo_TPM_ALG_SHA3_256)),
          when F_Get_Capabilities_Request_Reserved_4 =>
             True,
          when F_Negotiate_Algorithms_Request_Base_Hash_Algo_TPM_ALG_SHA3_256 =>
             Invalid (Ctx.Cursors (F_Negotiate_Algorithms_Request_Base_Hash_Algo_TPM_ALG_SHA_512)),
          when F_Negotiate_Algorithms_Request_Base_Hash_Algo_TPM_ALG_SHA_512 =>
             Invalid (Ctx.Cursors (F_Negotiate_Algorithms_Request_Base_Hash_Algo_TPM_ALG_SHA_384)),
          when F_Negotiate_Algorithms_Request_Base_Hash_Algo_TPM_ALG_SHA_384 =>
             Invalid (Ctx.Cursors (F_Negotiate_Algorithms_Request_Base_Hash_Algo_TPM_ALG_SHA_256)),
          when F_Negotiate_Algorithms_Request_Base_Hash_Algo_TPM_ALG_SHA_256 =>
             Invalid (Ctx.Cursors (F_Negotiate_Algorithms_Request_Base_Hash_Algo_Reserved_2)),
          when F_Negotiate_Algorithms_Request_Base_Hash_Algo_Reserved_2 =>
             Invalid (Ctx.Cursors (F_Negotiate_Algorithms_Request_Reserved_2)),
          when F_Negotiate_Algorithms_Request_Reserved_2 =>
             Invalid (Ctx.Cursors (F_Negotiate_Algorithms_Request_Reserved_3)),
          when F_Negotiate_Algorithms_Request_Reserved_3 =>
             Invalid (Ctx.Cursors (F_Negotiate_Algorithms_Request_Reserved_4)),
          when F_Negotiate_Algorithms_Request_Reserved_4 =>
             Invalid (Ctx.Cursors (F_Negotiate_Algorithms_Request_Ext_Asym_Count)),
          when F_Negotiate_Algorithms_Request_Ext_Asym_Count =>
             Invalid (Ctx.Cursors (F_Negotiate_Algorithms_Request_Ext_Hash_Count)),
          when F_Negotiate_Algorithms_Request_Ext_Hash_Count =>
             Invalid (Ctx.Cursors (F_Negotiate_Algorithms_Request_Reserved_5)),
          when F_Negotiate_Algorithms_Request_Reserved_5 =>
             Invalid (Ctx.Cursors (F_Negotiate_Algorithms_Request_Ext_Asym)),
          when F_Negotiate_Algorithms_Request_Ext_Asym =>
             Invalid (Ctx.Cursors (F_Negotiate_Algorithms_Request_Ext_Hash)),
          when F_Negotiate_Algorithms_Request_Ext_Hash =>
             Invalid (Ctx.Cursors (F_Negotiate_Algorithms_Request_Req_Alg_Structs)),
          when F_Negotiate_Algorithms_Request_Req_Alg_Structs =>
             True));

   function Sufficient_Buffer_Length (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Buffer /= null
      and Field_First (Ctx, Fld) + Field_Size (Ctx, Fld) < RFLX_Types.Bit_Length'Last
      and Ctx.First <= Field_First (Ctx, Fld)
      and Field_First (Ctx, Fld) + Field_Size (Ctx, Fld) - 1 <= Ctx.Written_Last)
    with
     Pre =>
       RFLX.SPDM.Request.Has_Buffer (Ctx)
       and RFLX.SPDM.Request.Valid_Next (Ctx, Fld);

   function Equal (Ctx : Context; Fld : Field; Data : RFLX_Types.Bytes) return Boolean is
     (Sufficient_Buffer_Length (Ctx, Fld)
      and then (case Fld is
                   when F_Get_Measurements_Request_Nonce_Data | F_Negotiate_Algorithms_Request_Ext_Asym | F_Negotiate_Algorithms_Request_Ext_Hash | F_Negotiate_Algorithms_Request_Req_Alg_Structs =>
                      Data'Length = RFLX_Types.To_Index (Field_Last (Ctx, Fld)) - RFLX_Types.To_Index (Field_First (Ctx, Fld)) + 1
                      and then (for all I in RFLX_Types.Index range RFLX_Types.To_Index (Field_First (Ctx, Fld)) .. RFLX_Types.To_Index (Field_Last (Ctx, Fld)) =>
                                   Ctx.Buffer.all (I) = Data (Data'First + (I - RFLX_Types.To_Index (Field_First (Ctx, Fld))))),
                   when others =>
                      False));

   procedure Reset_Dependent_Fields (Ctx : in out Context; Fld : Field) with
     Pre =>
       RFLX.SPDM.Request.Valid_Next (Ctx, Fld),
     Post =>
       Valid_Next (Ctx, Fld)
       and Invalid (Ctx.Cursors (Fld))
       and Invalid_Successor (Ctx, Fld)
       and Ctx.Buffer_First = Ctx.Buffer_First'Old
       and Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and Ctx.First = Ctx.First'Old
       and Ctx.Last = Ctx.Last'Old
       and Ctx.Cursors (Fld).Predecessor = Ctx.Cursors (Fld).Predecessor'Old
       and Has_Buffer (Ctx) = Has_Buffer (Ctx)'Old
       and Field_First (Ctx, Fld) = Field_First (Ctx, Fld)'Old
       and Field_Size (Ctx, Fld) = Field_Size (Ctx, Fld)'Old
       and (for all F in Field =>
               (if F < Fld then Ctx.Cursors (F) = Ctx.Cursors'Old (F) else Invalid (Ctx, F)))
   is
      First : constant RFLX_Types.Bit_Length := Field_First (Ctx, Fld) with
        Ghost;
      Size : constant RFLX_Types.Bit_Length := Field_Size (Ctx, Fld) with
        Ghost;
   begin
      pragma Assert (Field_First (Ctx, Fld) = First
                     and Field_Size (Ctx, Fld) = Size);
      for Fld_Loop in reverse Field'Succ (Fld) .. Field'Last loop
         Ctx.Cursors (Fld_Loop) := (S_Invalid, F_Final);
         pragma Loop_Invariant (Field_First (Ctx, Fld) = First
                                and Field_Size (Ctx, Fld) = Size);
         pragma Loop_Invariant ((for all F in Field =>
                                    (if F < Fld_Loop then Ctx.Cursors (F) = Ctx.Cursors'Loop_Entry (F) else Invalid (Ctx, F))));
      end loop;
      pragma Assert (Field_First (Ctx, Fld) = First
                     and Field_Size (Ctx, Fld) = Size);
      Ctx.Cursors (Fld) := (S_Invalid, Ctx.Cursors (Fld).Predecessor);
      pragma Assert (Field_First (Ctx, Fld) = First
                     and Field_Size (Ctx, Fld) = Size);
   end Reset_Dependent_Fields;

   function Composite_Field (Fld : Field) return Boolean is
     (Fld in F_Get_Measurements_Request_Nonce_Data | F_Negotiate_Algorithms_Request_Ext_Asym | F_Negotiate_Algorithms_Request_Ext_Hash | F_Negotiate_Algorithms_Request_Req_Alg_Structs);

   function Get (Ctx : Context; Fld : Field) return RFLX_Types.Base_Integer with
     Pre =>
       RFLX.SPDM.Request.Has_Buffer (Ctx)
       and then RFLX.SPDM.Request.Valid_Next (Ctx, Fld)
       and then RFLX.SPDM.Request.Sufficient_Buffer_Length (Ctx, Fld)
       and then not RFLX.SPDM.Request.Composite_Field (Fld)
   is
      First : constant RFLX_Types.Bit_Index := Field_First (Ctx, Fld);
      Last : constant RFLX_Types.Bit_Index := Field_Last (Ctx, Fld);
      Buffer_First : constant RFLX_Types.Index := RFLX_Types.To_Index (First);
      Buffer_Last : constant RFLX_Types.Index := RFLX_Types.To_Index (Last);
      Offset : constant RFLX_Types.Offset := RFLX_Types.Offset ((RFLX_Types.Byte'Size - Last mod RFLX_Types.Byte'Size) mod RFLX_Types.Byte'Size);
      Size : constant Positive := (case Fld is
          when F_Major_Version | F_Minor_Version =>
             4,
          when F_Code | F_Get_Capabilities_Request_Param_1 | F_Get_Certificate_Request_Slot | F_Get_Digests_Request_Param_1 =>
             8,
          when F_Get_Measurements_Request_Reserved_1 =>
             7,
          when F_Get_Version_Request_Param_1 | F_Negotiate_Algorithms_Request_Req_Alg_Struct_Count | F_Get_Capabilities_Request_Param_2 | F_Get_Certificate_Request_Param_2 | F_Get_Digests_Request_Param_2 =>
             8,
          when F_Get_Measurements_Request_Generate_Signature =>
             1,
          when F_Get_Version_Request_Param_2 | F_Negotiate_Algorithms_Request_Param_2 | F_Get_Capabilities_Request_Reserved_1 =>
             8,
          when F_Get_Certificate_Request_Offset =>
             16,
          when F_Get_Measurements_Request_Measurement_Operation =>
             8,
          when F_Negotiate_Algorithms_Request_Length =>
             16,
          when F_Get_Capabilities_Request_CT_Exponent =>
             8,
          when F_Get_Certificate_Request_Length =>
             16,
          when F_Negotiate_Algorithms_Request_Measurement_Specification_Reserved =>
             7,
          when F_Get_Capabilities_Request_Reserved_2 =>
             16,
          when F_Get_Measurements_Request_Reserved_2 =>
             4,
          when F_Negotiate_Algorithms_Request_Measurement_Specification_DMTF | F_Get_Capabilities_Request_MAC_Cap =>
             1,
          when F_Get_Measurements_Request_Slot_ID_Param =>
             4,
          when F_Negotiate_Algorithms_Request_Reserved_1 =>
             8,
          when F_Get_Capabilities_Request_Encrypt_Cap | F_Negotiate_Algorithms_Request_Base_Asym_Algo_TPM_ALG_ECDSA_ECC_NIST_P384 | F_Get_Capabilities_Request_Meas_Fresh_Cap | F_Negotiate_Algorithms_Request_Base_Asym_Algo_TPM_ALG_RSAPSS_4096 =>
             1,
          when F_Get_Capabilities_Request_Meas_Cap =>
             2,
          when F_Negotiate_Algorithms_Request_Base_Asym_Algo_TPM_ALG_RSASSA_4096 | F_Get_Capabilities_Request_Chal_Cap | F_Negotiate_Algorithms_Request_Base_Asym_Algo_TPM_ALG_ECDSA_ECC_NIST_P256 | F_Get_Capabilities_Request_Cert_Cap | F_Negotiate_Algorithms_Request_Base_Asym_Algo_TPM_ALG_RSAPSS_3072 | F_Get_Capabilities_Request_Reserved_3 | F_Negotiate_Algorithms_Request_Base_Asym_Algo_TPM_ALG_RSASSA_3072 | F_Get_Capabilities_Request_Handshake_In_The_Clear_Cap | F_Negotiate_Algorithms_Request_Base_Asym_Algo_TPM_ALG_RSAPSS_2048 | F_Get_Capabilities_Request_Key_Upd_Cap | F_Negotiate_Algorithms_Request_Base_Asym_Algo_TPM_ALG_RSASSA_2048 | F_Get_Capabilities_Request_Hbeat_Cap =>
             1,
          when F_Negotiate_Algorithms_Request_Base_Asym_Algo_Reserved_1 =>
             7,
          when F_Get_Capabilities_Request_Encap_Cap | F_Negotiate_Algorithms_Request_Base_Asym_Algo_TPM_ALG_ECDSA_ECC_NIST_P521 =>
             1,
          when F_Get_Capabilities_Request_PSK_Cap =>
             2,
          when F_Negotiate_Algorithms_Request_Base_Asym_Algo_Reserved_2 =>
             16,
          when F_Get_Capabilities_Request_Key_Ex_Cap =>
             1,
          when F_Negotiate_Algorithms_Request_Base_Hash_Algo_Reserved_1 =>
             2,
          when F_Get_Capabilities_Request_Mut_Auth_Cap | F_Negotiate_Algorithms_Request_Base_Hash_Algo_TPM_ALG_SHA3_512 | F_Get_Capabilities_Request_Pub_Key_ID_Cap | F_Negotiate_Algorithms_Request_Base_Hash_Algo_TPM_ALG_SHA3_384 =>
             1,
          when F_Get_Capabilities_Request_Reserved_4 =>
             15,
          when F_Negotiate_Algorithms_Request_Base_Hash_Algo_TPM_ALG_SHA3_256 | F_Negotiate_Algorithms_Request_Base_Hash_Algo_TPM_ALG_SHA_512 | F_Negotiate_Algorithms_Request_Base_Hash_Algo_TPM_ALG_SHA_384 | F_Negotiate_Algorithms_Request_Base_Hash_Algo_TPM_ALG_SHA_256 =>
             1,
          when F_Negotiate_Algorithms_Request_Base_Hash_Algo_Reserved_2 =>
             24,
          when F_Negotiate_Algorithms_Request_Reserved_2 | F_Negotiate_Algorithms_Request_Reserved_3 | F_Negotiate_Algorithms_Request_Reserved_4 =>
             32,
          when F_Negotiate_Algorithms_Request_Ext_Asym_Count | F_Negotiate_Algorithms_Request_Ext_Hash_Count =>
             8,
          when F_Negotiate_Algorithms_Request_Reserved_5 =>
             16,
          when others =>
             Positive'Last);
      Byte_Order : constant RFLX_Types.Byte_Order := (if
          Fld in F_Get_Capabilities_Request_Param_1 | F_Get_Digests_Request_Param_1 | F_Get_Measurements_Request_Reserved_1 | F_Get_Version_Request_Param_1 | F_Get_Capabilities_Request_Param_2 | F_Get_Digests_Request_Param_2 | F_Get_Measurements_Request_Generate_Signature | F_Get_Version_Request_Param_2 | F_Get_Capabilities_Request_Reserved_1 | F_Get_Measurements_Request_Measurement_Operation | F_Get_Capabilities_Request_CT_Exponent | F_Get_Capabilities_Request_Reserved_2 | F_Get_Measurements_Request_Reserved_2 | F_Get_Capabilities_Request_MAC_Cap | F_Get_Measurements_Request_Slot_ID_Param | F_Get_Capabilities_Request_Encrypt_Cap | F_Get_Capabilities_Request_Meas_Fresh_Cap | F_Get_Capabilities_Request_Meas_Cap | F_Get_Capabilities_Request_Chal_Cap | F_Get_Capabilities_Request_Cert_Cap | F_Get_Capabilities_Request_Reserved_3 | F_Get_Capabilities_Request_Handshake_In_The_Clear_Cap | F_Get_Capabilities_Request_Key_Upd_Cap | F_Get_Capabilities_Request_Hbeat_Cap | F_Get_Capabilities_Request_Encap_Cap | F_Get_Capabilities_Request_PSK_Cap | F_Get_Capabilities_Request_Key_Ex_Cap | F_Get_Capabilities_Request_Mut_Auth_Cap | F_Get_Capabilities_Request_Pub_Key_ID_Cap | F_Get_Capabilities_Request_Reserved_4
       then
          RFLX_Types.High_Order_First
       else
          RFLX_Types.Low_Order_First);
   begin
      return RFLX_Types.Extract (Ctx.Buffer, Buffer_First, Buffer_Last, Offset, Size, Byte_Order);
   end Get;

   procedure Verify (Ctx : in out Context; Fld : Field) is
      Value : RFLX_Types.Base_Integer;
   begin
      if
         Invalid (Ctx.Cursors (Fld))
         and then Valid_Predecessor (Ctx, Fld)
         and then Path_Condition (Ctx, Fld)
      then
         if Sufficient_Buffer_Length (Ctx, Fld) then
            Value := (if Composite_Field (Fld) then 0 else Get (Ctx, Fld));
            if
               Valid_Value (Fld, Value)
               and then Field_Condition (Ctx, Fld, Value)
            then
               pragma Assert ((if
                                  Fld = F_Get_Capabilities_Request_Reserved_4
                                  or Fld = F_Get_Certificate_Request_Length
                                  or Fld = F_Get_Digests_Request_Param_2
                                  or Fld = F_Get_Measurements_Request_Measurement_Operation
                                  or Fld = F_Get_Measurements_Request_Slot_ID_Param
                                  or Fld = F_Get_Version_Request_Param_2
                                  or Fld = F_Negotiate_Algorithms_Request_Req_Alg_Structs
                               then
                                  Field_Last (Ctx, Fld) mod RFLX_Types.Byte'Size = 0));
               pragma Assert ((((Field_Last (Ctx, Fld) + RFLX_Types.Byte'Size - 1) / RFLX_Types.Byte'Size) * RFLX_Types.Byte'Size) mod RFLX_Types.Byte'Size = 0);
               Ctx.Verified_Last := ((Field_Last (Ctx, Fld) + RFLX_Types.Byte'Size - 1) / RFLX_Types.Byte'Size) * RFLX_Types.Byte'Size;
               pragma Assert (Field_Last (Ctx, Fld) <= Ctx.Verified_Last);
               if Composite_Field (Fld) then
                  Ctx.Cursors (Fld) := (State => S_Structural_Valid, First => Field_First (Ctx, Fld), Last => Field_Last (Ctx, Fld), Value => Value, Predecessor => Ctx.Cursors (Fld).Predecessor);
               else
                  Ctx.Cursors (Fld) := (State => S_Valid, First => Field_First (Ctx, Fld), Last => Field_Last (Ctx, Fld), Value => Value, Predecessor => Ctx.Cursors (Fld).Predecessor);
               end if;
               Ctx.Cursors (Successor (Ctx, Fld)) := (State => S_Invalid, Predecessor => Fld);
            else
               Ctx.Cursors (Fld) := (State => S_Invalid, Predecessor => F_Final);
            end if;
         else
            Ctx.Cursors (Fld) := (State => S_Incomplete, Predecessor => F_Final);
         end if;
      end if;
   end Verify;

   procedure Verify_Message (Ctx : in out Context) is
   begin
      for F in Field loop
         pragma Loop_Invariant (Has_Buffer (Ctx)
                                and Ctx.Buffer_First = Ctx.Buffer_First'Loop_Entry
                                and Ctx.Buffer_Last = Ctx.Buffer_Last'Loop_Entry
                                and Ctx.First = Ctx.First'Loop_Entry
                                and Ctx.Last = Ctx.Last'Loop_Entry);
         Verify (Ctx, F);
      end loop;
   end Verify_Message;

   function Get_Get_Measurements_Request_Nonce_Data (Ctx : Context) return RFLX_Types.Bytes is
      First : constant RFLX_Types.Index := RFLX_Types.To_Index (Ctx.Cursors (F_Get_Measurements_Request_Nonce_Data).First);
      Last : constant RFLX_Types.Index := RFLX_Types.To_Index (Ctx.Cursors (F_Get_Measurements_Request_Nonce_Data).Last);
   begin
      return Ctx.Buffer.all (First .. Last);
   end Get_Get_Measurements_Request_Nonce_Data;

   procedure Get_Get_Measurements_Request_Nonce_Data (Ctx : Context; Data : out RFLX_Types.Bytes) is
      First : constant RFLX_Types.Index := RFLX_Types.To_Index (Ctx.Cursors (F_Get_Measurements_Request_Nonce_Data).First);
      Last : constant RFLX_Types.Index := RFLX_Types.To_Index (Ctx.Cursors (F_Get_Measurements_Request_Nonce_Data).Last);
   begin
      Data := [others => RFLX_Types.Byte'First];
      Data (Data'First .. Data'First + (Last - First)) := Ctx.Buffer.all (First .. Last);
   end Get_Get_Measurements_Request_Nonce_Data;

   procedure Generic_Get_Get_Measurements_Request_Nonce_Data (Ctx : Context) is
      First : constant RFLX_Types.Index := RFLX_Types.To_Index (Ctx.Cursors (F_Get_Measurements_Request_Nonce_Data).First);
      Last : constant RFLX_Types.Index := RFLX_Types.To_Index (Ctx.Cursors (F_Get_Measurements_Request_Nonce_Data).Last);
   begin
      Process_Get_Measurements_Request_Nonce_Data (Ctx.Buffer.all (First .. Last));
   end Generic_Get_Get_Measurements_Request_Nonce_Data;

   procedure Set (Ctx : in out Context; Fld : Field; Val : RFLX_Types.Base_Integer; Size : RFLX_Types.Bit_Length; State_Valid : Boolean; Buffer_First : out RFLX_Types.Index; Buffer_Last : out RFLX_Types.Index; Offset : out RFLX_Types.Offset) with
     Pre =>
       RFLX.SPDM.Request.Has_Buffer (Ctx)
       and then RFLX.SPDM.Request.Valid_Next (Ctx, Fld)
       and then RFLX.SPDM.Request.Valid_Value (Fld, Val)
       and then RFLX.SPDM.Request.Valid_Size (Ctx, Fld, Size)
       and then Size <= RFLX.SPDM.Request.Available_Space (Ctx, Fld)
       and then (if RFLX.SPDM.Request.Composite_Field (Fld) then Size mod RFLX_Types.Byte'Size = 0 else State_Valid),
     Post =>
       Valid_Next (Ctx, Fld)
       and then Invalid_Successor (Ctx, Fld)
       and then Buffer_First = RFLX_Types.To_Index (Field_First (Ctx, Fld))
       and then Buffer_Last = RFLX_Types.To_Index (Field_First (Ctx, Fld) + Size - 1)
       and then Offset = RFLX_Types.Offset ((RFLX_Types.Byte'Size - (Field_First (Ctx, Fld) + Size - 1) mod RFLX_Types.Byte'Size) mod RFLX_Types.Byte'Size)
       and then Ctx.Buffer_First = Ctx.Buffer_First'Old
       and then Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and then Ctx.First = Ctx.First'Old
       and then Ctx.Last = Ctx.Last'Old
       and then Ctx.Buffer_First = Ctx.Buffer_First'Old
       and then Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and then Ctx.First = Ctx.First'Old
