      pragma Assert (Ctx.P.Slots.Slot_Ptr_2 /= null);
      pragma Warnings (Off, """Ctx.P.Supp_Versions_Ctx"" is set by ""Take_Buffer"" but not used after the call");
      SPDM.Version_Number_Entries.Take_Buffer (Ctx.P.Supp_Versions_Ctx, Supp_Versions_Buffer);
      pragma Warnings (On, """Ctx.P.Supp_Versions_Ctx"" is set by ""Take_Buffer"" but not used after the call");
      pragma Assert (Ctx.P.Slots.Slot_Ptr_3 = null);
      pragma Assert (Supp_Versions_Buffer /= null);
      Ctx.P.Slots.Slot_Ptr_3 := Supp_Versions_Buffer;
      pragma Assert (Ctx.P.Slots.Slot_Ptr_3 /= null);
      pragma Warnings (Off, """Ctx.P.Resp_Alg_Structs_Ctx"" is set by ""Take_Buffer"" but not used after the call");
      SPDM.Resp_Alg_Structs.Take_Buffer (Ctx.P.Resp_Alg_Structs_Ctx, Resp_Alg_Structs_Buffer);
      pragma Warnings (On, """Ctx.P.Resp_Alg_Structs_Ctx"" is set by ""Take_Buffer"" but not used after the call");
      pragma Assert (Ctx.P.Slots.Slot_Ptr_4 = null);
      pragma Assert (Resp_Alg_Structs_Buffer /= null);
      Ctx.P.Slots.Slot_Ptr_4 := Resp_Alg_Structs_Buffer;
      pragma Assert (Ctx.P.Slots.Slot_Ptr_4 /= null);
      pragma Warnings (Off, """Ctx.P.Resp_Alg_Struct_Ctx"" is set by ""Take_Buffer"" but not used after the call");
      SPDM.Alg_Struct.Take_Buffer (Ctx.P.Resp_Alg_Struct_Ctx, Resp_Alg_Struct_Buffer);
      pragma Warnings (On, """Ctx.P.Resp_Alg_Struct_Ctx"" is set by ""Take_Buffer"" but not used after the call");
      pragma Assert (Ctx.P.Slots.Slot_Ptr_5 = null);
      pragma Assert (Resp_Alg_Struct_Buffer /= null);
      Ctx.P.Slots.Slot_Ptr_5 := Resp_Alg_Struct_Buffer;
      pragma Assert (Ctx.P.Slots.Slot_Ptr_5 /= null);
      pragma Warnings (Off, """Ctx.P.Measurement_Record_Ctx"" is set by ""Take_Buffer"" but not used after the call");
      SPDM.Measurement_Record.Take_Buffer (Ctx.P.Measurement_Record_Ctx, Measurement_Record_Buffer);
      pragma Warnings (On, """Ctx.P.Measurement_Record_Ctx"" is set by ""Take_Buffer"" but not used after the call");
      pragma Assert (Ctx.P.Slots.Slot_Ptr_6 = null);
      pragma Assert (Measurement_Record_Buffer /= null);
      Ctx.P.Slots.Slot_Ptr_6 := Measurement_Record_Buffer;
      pragma Assert (Ctx.P.Slots.Slot_Ptr_6 /= null);
      SPDM_Responder.Session_Allocator.Finalize (Ctx.P.Slots);
      Ctx.P.Next_State := S_End_Session;
   end Finalize;

   procedure Reset_Messages_Before_Write (Ctx : in out Context'Class) with
     Pre =>
       Initialized (Ctx),
     Post =>
       Initialized (Ctx)
   is
   begin
      case Ctx.P.Next_State is
         when S_Init =>
            null;
         when S_Receive_Get_Version =>
            SPDM.Request.Reset (Ctx.P.Request_Ctx, Ctx.P.Request_Ctx.First, Ctx.P.Request_Ctx.First - 1);
         when S_Prepare_Version | S_Send_Version =>
            null;
         when S_Receive_Get_Capabilities =>
            SPDM.Request.Reset (Ctx.P.Request_Ctx, Ctx.P.Request_Ctx.First, Ctx.P.Request_Ctx.First - 1);
         when S_Prepare_Capabilities | S_Send_Capabilities =>
            null;
         when S_Receive_Negotiate_Algorithms =>
            SPDM.Request.Reset (Ctx.P.Request_Ctx, Ctx.P.Request_Ctx.First, Ctx.P.Request_Ctx.First - 1);
         when S_Check_Algorithms_Req_Base_Asym_Alg | S_Prepare_Algorithms_Req_Base_Asym_Alg | S_Prepare_Algorithms | S_Send_Idle | S_Reset_Idle =>
            null;
         when S_Receive_Idle =>
            SPDM.Request.Reset (Ctx.P.Request_Ctx, Ctx.P.Request_Ctx.First, Ctx.P.Request_Ctx.First - 1);
         when S_Prepare_Digests | S_Check_Certificate | S_Prepare_Certificate | S_Reset_Measurements_Hash | S_Prepare_Measurements | S_Prepare_Measurements_Number_Of_Indices | S_Prepare_Measurements_All | S_Prepare_Measurements_Records | S_Prepare_Measurements_Slot | S_Prepare_Measurements_Response | S_Prepare_Measurements_Sign | S_Update_Measurement_Signature | S_Error_Unsupported_Request | S_Error_Invalid_Request | S_Error_Unspecified | S_Prepare_Error | S_Prepare_Zero_Data_Error | S_Prepare_Unexpected_Request_Error | S_Send_Error | S_End_Session =>
            null;
      end case;
   end Reset_Messages_Before_Write;

   procedure Tick (Ctx : in out Context'Class) is
   begin
      case Ctx.P.Next_State is
         when S_Init =>
            Init (Ctx);
         when S_Receive_Get_Version =>
            Receive_Get_Version (Ctx);
         when S_Prepare_Version =>
            Prepare_Version (Ctx);
         when S_Send_Version =>
            Send_Version (Ctx);
         when S_Receive_Get_Capabilities =>
            Receive_Get_Capabilities (Ctx);
         when S_Prepare_Capabilities =>
            Prepare_Capabilities (Ctx);
         when S_Send_Capabilities =>
            Send_Capabilities (Ctx);
         when S_Receive_Negotiate_Algorithms =>
            Receive_Negotiate_Algorithms (Ctx);
         when S_Check_Algorithms_Req_Base_Asym_Alg =>
            Check_Algorithms_Req_Base_Asym_Alg (Ctx);
         when S_Prepare_Algorithms_Req_Base_Asym_Alg =>
            Prepare_Algorithms_Req_Base_Asym_Alg (Ctx);
         when S_Prepare_Algorithms =>
            Prepare_Algorithms (Ctx);
         when S_Send_Idle =>
            Send_Idle (Ctx);
         when S_Reset_Idle =>
            Reset_Idle (Ctx);
         when S_Receive_Idle =>
            Receive_Idle (Ctx);
         when S_Prepare_Digests =>
            Prepare_Digests (Ctx);
         when S_Check_Certificate =>
            Check_Certificate (Ctx);
         when S_Prepare_Certificate =>
            Prepare_Certificate (Ctx);
         when S_Reset_Measurements_Hash =>
            Reset_Measurements_Hash (Ctx);
         when S_Prepare_Measurements =>
            Prepare_Measurements (Ctx);
         when S_Prepare_Measurements_Number_Of_Indices =>
            Prepare_Measurements_Number_Of_Indices (Ctx);
         when S_Prepare_Measurements_All =>
            Prepare_Measurements_All (Ctx);
         when S_Prepare_Measurements_Records =>
            Prepare_Measurements_Records (Ctx);
         when S_Prepare_Measurements_Slot =>
            Prepare_Measurements_Slot (Ctx);
         when S_Prepare_Measurements_Response =>
            Prepare_Measurements_Response (Ctx);
         when S_Prepare_Measurements_Sign =>
            Prepare_Measurements_Sign (Ctx);
         when S_Update_Measurement_Signature =>
            Update_Measurement_Signature (Ctx);
         when S_Error_Unsupported_Request =>
            Error_Unsupported_Request (Ctx);
         when S_Error_Invalid_Request =>
            Error_Invalid_Request (Ctx);
         when S_Error_Unspecified =>
            Error_Unspecified (Ctx);
         when S_Prepare_Error =>
            Prepare_Error (Ctx);
         when S_Prepare_Zero_Data_Error =>
            Prepare_Zero_Data_Error (Ctx);
         when S_Prepare_Unexpected_Request_Error =>
            Prepare_Unexpected_Request_Error (Ctx);
         when S_Send_Error =>
            Send_Error (Ctx);
         when S_End_Session =>
            null;
      end case;
      Reset_Messages_Before_Write (Ctx);
   end Tick;

   function In_IO_State (Ctx : Context'Class) return Boolean is
     (Ctx.P.Next_State in S_Receive_Get_Version | S_Send_Version | S_Receive_Get_Capabilities | S_Send_Capabilities | S_Receive_Negotiate_Algorithms | S_Send_Idle | S_Receive_Idle | S_Send_Error);

   procedure Run (Ctx : in out Context'Class) is
   begin
      Tick (Ctx);
      while
         Active (Ctx)
         and not In_IO_State (Ctx)
      loop
         pragma Loop_Invariant (Initialized (Ctx));
         Tick (Ctx);
      end loop;
   end Run;

   procedure Read (Ctx : Context'Class; Chan : Channel; Buffer : out RFLX_Types.Bytes; Offset : RFLX_Types.Length := 0) is
      function Read_Pre (Message_Buffer : RFLX_Types.Bytes) return Boolean is
        (Buffer'Length > 0
         and then Offset < Message_Buffer'Length);
      procedure Read (Message_Buffer : RFLX_Types.Bytes) with
        Pre =>
          Read_Pre (Message_Buffer)
      is
         Length : constant RFLX_Types.Index := RFLX_Types.Index (RFLX_Types.Length'Min (Buffer'Length, Message_Buffer'Length - Offset));
         Buffer_Last : constant RFLX_Types.Index := Buffer'First - 1 + Length;
      begin
         Buffer (Buffer'First .. RFLX_Types.Index (Buffer_Last)) := Message_Buffer (RFLX_Types.Index (RFLX_Types.Length (Message_Buffer'First) + Offset) .. Message_Buffer'First - 2 + RFLX_Types.Index (Offset + 1) + Length);
      end Read;
      procedure SPDM_Response_Read is new SPDM.Response.Generic_Read (Read, Read_Pre);
   begin
      Buffer := [others => 0];
      case Chan is
         when C_Transport =>
            case Ctx.P.Next_State is
               when S_Send_Version | S_Send_Capabilities | S_Send_Idle | S_Send_Error =>
                  SPDM_Response_Read (Ctx.P.Response_Ctx);
               when others =>
                  pragma Warnings (Off, "unreachable code");
                  null;
                  pragma Warnings (On, "unreachable code");
            end case;
      end case;
   end Read;

   procedure Write (Ctx : in out Context'Class; Chan : Channel; Buffer : RFLX_Types.Bytes; Offset : RFLX_Types.Length := 0) is
      Write_Buffer_Length : constant RFLX_Types.Length := Write_Buffer_Size (Ctx, Chan);
      function Write_Pre (Context_Buffer_Length : RFLX_Types.Length; Offset : RFLX_Types.Length) return Boolean is
        (Buffer'Length > 0
         and then Context_Buffer_Length = Write_Buffer_Length
         and then Offset <= RFLX_Types.Length'Last - Buffer'Length
         and then Buffer'Length + Offset <= Write_Buffer_Length);
      procedure Write (Message_Buffer : out RFLX_Types.Bytes; Length : out RFLX_Types.Length; Context_Buffer_Length : RFLX_Types.Length; Offset : RFLX_Types.Length) with
        Pre =>
          Write_Pre (Context_Buffer_Length, Offset)
          and then Offset <= RFLX_Types.Length'Last - Message_Buffer'Length
          and then Message_Buffer'Length + Offset = Write_Buffer_Length,
        Post =>
          Length <= Message_Buffer'Length
      is
      begin
         Length := Buffer'Length;
         Message_Buffer := [others => 0];
         Message_Buffer (Message_Buffer'First .. RFLX_Types.Index (RFLX_Types.Length (Message_Buffer'First) - 1 + Length)) := Buffer;
      end Write;
      procedure SPDM_Request_Write is new SPDM.Request.Generic_Write (Write, Write_Pre);
   begin
      case Chan is
         when C_Transport =>
            case Ctx.P.Next_State is
               when S_Receive_Get_Version | S_Receive_Get_Capabilities | S_Receive_Negotiate_Algorithms | S_Receive_Idle =>
                  SPDM_Request_Write (Ctx.P.Request_Ctx, Offset);
               when others =>
                  pragma Warnings (Off, "unreachable code");
                  null;
                  pragma Warnings (On, "unreachable code");
            end case;
      end case;
   end Write;

end RFLX.SPDM_Responder.Session;
