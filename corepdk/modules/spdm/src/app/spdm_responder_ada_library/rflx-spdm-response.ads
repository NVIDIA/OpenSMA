          when F_Algorithms_Response_Resp_Alg_Structs =>
             (Structural_Valid (Ctx.Cursors (F_Algorithms_Response_Ext_Hash))
              and Ctx.Cursors (Fld).Predecessor = F_Algorithms_Response_Ext_Hash),
          when F_Capabilities_Response_PSK_Cap =>
             (Valid (Ctx.Cursors (F_Capabilities_Response_Encap_Cap))
              and Ctx.Cursors (Fld).Predecessor = F_Capabilities_Response_Encap_Cap),
          when F_Capabilities_Response_Key_Ex_Cap =>
             (Valid (Ctx.Cursors (F_Capabilities_Response_PSK_Cap))
              and Ctx.Cursors (Fld).Predecessor = F_Capabilities_Response_PSK_Cap),
          when F_Capabilities_Response_Mut_Auth_Cap =>
             (Valid (Ctx.Cursors (F_Capabilities_Response_Key_Ex_Cap))
              and Ctx.Cursors (Fld).Predecessor = F_Capabilities_Response_Key_Ex_Cap),
          when F_Capabilities_Response_Reserved_4 =>
             (Valid (Ctx.Cursors (F_Capabilities_Response_Mut_Auth_Cap))
