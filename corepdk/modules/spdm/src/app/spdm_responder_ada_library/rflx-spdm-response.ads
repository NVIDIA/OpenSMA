             or (Valid (Ctx.Cursors (F_Error_Response_Zero_Error_Data))
                 and Ctx.Cursors (Fld).Predecessor = F_Error_Response_Zero_Error_Data)
             or (Structural_Valid (Ctx.Cursors (F_Measurements_Response_Opaque_Data))
                 and Ctx.Cursors (Fld).Predecessor = F_Measurements_Response_Opaque_Data)
             or (Structural_Valid (Ctx.Cursors (F_Measurements_Response_Signature))
                 and Ctx.Cursors (Fld).Predecessor = F_Measurements_Response_Signature)
             or (Structural_Valid (Ctx.Cursors (F_Version_Response_Version_Number_Entries))
                 and Ctx.Cursors (Fld).Predecessor = F_Version_Response_Version_Number_Entries)));

   function Valid_Next (Ctx : Context; Fld : Field) return Boolean is
     (Valid_Predecessor (Ctx, Fld)
      and then Path_Condition (Ctx, Fld));

   function Available_Space (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Length is
     (Ctx.Last - Field_First (Ctx, Fld) + 1);

   function Sufficient_Space (Ctx : Context; Fld : Field) return Boolean is
     (Available_Space (Ctx, Fld) >= Field_Size (Ctx, Fld));

   function Present (Ctx : Context; Fld : Field) return Boolean is
     (Structural_Valid (Ctx.Cursors (Fld))
      and then Ctx.Cursors (Fld).First < Ctx.Cursors (Fld).Last + 1);

   function Structural_Valid (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Valid
      or Ctx.Cursors (Fld).State = S_Structural_Valid);

   function Valid (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Valid
      and then Ctx.Cursors (Fld).First < Ctx.Cursors (Fld).Last + 1);

   function Incomplete (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Incomplete);

   function Invalid (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Invalid
      or Ctx.Cursors (Fld).State = S_Incomplete);

   function Structural_Valid_Message (Ctx : Context) return Boolean is
     (Structural_Valid (Ctx, F_Algorithms_Response_Resp_Alg_Structs)
      or (Valid (Ctx, F_Capabilities_Response_Pub_Key_ID_Cap)
          and then ((RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_Pub_Key_ID_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
                     or RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_Cert_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False)))
                    and ((RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_Encrypt_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))
                          and RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_MAC_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
                         or RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_Handshake_In_The_Clear_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False)))
                    and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_Handshake_In_The_Clear_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
                         or RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_Key_Ex_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
                    and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_Mut_Auth_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
                         or RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_Encap_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
                    and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_PSK_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.PSK_Resp_Unsupported))
                         or RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_Encrypt_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))
                         or RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_MAC_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
                    and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_Key_Ex_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
                         or RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_Encrypt_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))
                         or RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_MAC_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
                    and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_Key_Ex_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))
                         or RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_Encrypt_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
                         or RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_PSK_Cap).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.PSK_Resp_Unsupported)))
                    and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_Key_Ex_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))
                         or RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_MAC_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
                         or RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_PSK_Cap).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.PSK_Resp_Unsupported)))))
      or Structural_Valid (Ctx, F_Certificate_Response_Cert_Chain)
      or Structural_Valid (Ctx, F_Digests_Response_Digests_Data)
