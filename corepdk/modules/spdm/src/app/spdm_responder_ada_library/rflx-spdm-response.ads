   procedure Set_Major_Version (Ctx : in out Context; Val : RFLX.SPDM.Major_Version) with
     Inline_Always,
     Pre =>
       not Ctx'Constrained
       and then RFLX.SPDM.Response.Has_Buffer (Ctx)
       and then RFLX.SPDM.Response.Valid_Next (Ctx, RFLX.SPDM.Response.F_Major_Version)
       and then RFLX.SPDM.Valid_Major_Version (RFLX.SPDM.To_Base_Integer (Val))
       and then RFLX.SPDM.Response.Available_Space (Ctx, RFLX.SPDM.Response.F_Major_Version) >= RFLX.SPDM.Response.Field_Size (Ctx, RFLX.SPDM.Response.F_Major_Version)
       and then RFLX.SPDM.Response.Field_Condition (Ctx, RFLX.SPDM.Response.F_Major_Version, RFLX.SPDM.To_Base_Integer (Val)),
     Post =>
       Has_Buffer (Ctx)
       and Valid (Ctx, F_Major_Version)
