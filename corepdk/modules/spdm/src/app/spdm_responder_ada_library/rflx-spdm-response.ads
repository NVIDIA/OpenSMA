          and then RFLX_Types.Base_Integer (Ctx.Cursors (F_Error_Response_Error_Code).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Response_Not_Ready)))
      or (Structural_Valid (Ctx, F_Measurements_Response_Opaque_Data)
          and then RFLX_Types.Base_Integer (To_Base_Integer (Ctx.Has_Signature)) = RFLX_Types.Base_Integer (To_Base_Integer (False)))
      or Structural_Valid (Ctx, F_Measurements_Response_Signature)
      or Structural_Valid (Ctx, F_Version_Response_Version_Number_Entries));

   function Valid_Message (Ctx : Context) return Boolean is
