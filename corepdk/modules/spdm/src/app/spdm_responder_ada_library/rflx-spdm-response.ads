                              and then (RFLX_Types.Base_Integer (Cursors (F_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Certificate))
                                        and Cursors (F_Minor_Version).Value = 1)))
                and then (if
