                              and then Cursors (F_Algorithms_Response_Resp_Alg_Struct_Count).Predecessor = F_Code
                              and then RFLX_Types.Base_Integer (Cursors (F_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Algorithms))))
                and then (if
