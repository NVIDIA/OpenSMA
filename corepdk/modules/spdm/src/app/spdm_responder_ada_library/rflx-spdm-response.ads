                              and then Cursors (F_Capabilities_Response_Param_1).Predecessor = F_Code
                              and then (RFLX_Types.Base_Integer (Cursors (F_Code).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.Capabilities))
                                        and Cursors (F_Minor_Version).Value = 1)))
                and then (if
                             Structural_Valid (Cursors (F_Certificate_Response_Slot))
