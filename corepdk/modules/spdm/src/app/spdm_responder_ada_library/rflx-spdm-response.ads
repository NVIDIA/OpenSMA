   function Valid_Size (Ctx : Context; Fld : Field; Size : RFLX_Types.Bit_Length) return Boolean is
     ((if
          Fld = F_Error_Response_Opaque_Error_Data
          and then Ctx.Cursors (Fld).Predecessor = F_Error_Response_Vendor_ID_Double
       then
          Size <= Available_Space (Ctx, Fld)
       elsif
          Fld = F_Error_Response_Opaque_Error_Data
          and then Ctx.Cursors (Fld).Predecessor = F_Error_Response_Vendor_ID_Len
          and then (Ctx.Cursors (F_Error_Response_Vendor_ID_Len).Value = 0
                    and RFLX_Types.Bit_Length (Ctx.Cursors (F_Error_Response_Registry_ID).Value) = RFLX_Types.Bit_Length (To_Base_Integer (RFLX.SPDM.Reg_DMTF)))
       then
          Size <= Available_Space (Ctx, Fld)
       elsif
          Fld = F_Error_Response_Opaque_Error_Data
          and then Ctx.Cursors (Fld).Predecessor = F_Error_Response_Vendor_ID_Quad
       then
          Size <= Available_Space (Ctx, Fld)
       else
          Size = Field_Size (Ctx, Fld)))
    with
     Pre =>
       RFLX.SPDM.Response.Valid_Next (Ctx, Fld);

   function Valid_Length (Ctx : Context; Fld : Field; Length : RFLX_Types.Length) return Boolean is
     (Valid_Size (Ctx, Fld, RFLX_Types.To_Bit_Length (Length)));

