          when F_Measurements_Response_Opaque_Data =>
             RFLX_Types.Base_Integer (To_Base_Integer (Ctx.Has_Signature)) = RFLX_Types.Base_Integer (To_Base_Integer (False))
             or RFLX_Types.Base_Integer (To_Base_Integer (Ctx.Has_Signature)) = RFLX_Types.Base_Integer (To_Base_Integer (True)),
          when F_Algorithms_Response_Reserved_3 | F_Capabilities_Response_Chal_Cap | F_Digests_Response_Digests_Data | F_Measurements_Response_Signature | F_Algorithms_Response_Reserved_4 | F_Capabilities_Response_Cert_Cap =>
             True,
          when F_Algorithms_Response_Ext_Asym_Sel_Count =>
             Val <= 1,
          when F_Capabilities_Response_Cache_Cap =>
             True,
          when F_Algorithms_Response_Ext_Hash_Sel_Count =>
             Val <= 1,
          when F_Capabilities_Response_Handshake_In_The_Clear_Cap | F_Algorithms_Response_Reserved_5 | F_Capabilities_Response_Key_Upd_Cap | F_Algorithms_Response_Ext_Asym | F_Capabilities_Response_Hbeat_Cap =>
             True,
          when F_Algorithms_Response_Ext_Hash =>
             RFLX_Types.Base_Integer (Ctx.Cursors (F_Algorithms_Response_Length).Value) * 8 >= RFLX_Types.Base_Integer (Field_Last (Ctx, F_Algorithms_Response_Ext_Hash)) - RFLX_Types.Base_Integer (Ctx.Cursors (F_Algorithms_Response_Resp_Alg_Struct_Count).First) + 17,
          when F_Capabilities_Response_Encap_Cap | F_Algorithms_Response_Resp_Alg_Structs | F_Capabilities_Response_PSK_Cap | F_Capabilities_Response_Key_Ex_Cap | F_Capabilities_Response_Mut_Auth_Cap | F_Capabilities_Response_Reserved_4 =>
             True,
          when F_Capabilities_Response_Pub_Key_ID_Cap =>
             (Val = RFLX_Types.Base_Integer (To_Base_Integer (False))
              or RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_Cert_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False)))
             and ((RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_Encrypt_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))
                   and RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_MAC_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
                  or RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_Handshake_In_The_Clear_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False)))
             and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_Handshake_In_The_Clear_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
                  or RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_Key_Ex_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
             and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_Mut_Auth_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
                  or RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_Encap_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
             and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_PSK_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.PSK_Resp_Unsupported))
                  or RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_Encrypt_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))
                  or RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_MAC_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
             and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_Key_Ex_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
                  or RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_Encrypt_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))
                  or RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_MAC_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True)))
             and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_Key_Ex_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))
                  or RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_Encrypt_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
                  or RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_PSK_Cap).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.PSK_Resp_Unsupported)))
             and (RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_Key_Ex_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (True))
                  or RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_MAC_Cap).Value) = RFLX_Types.Base_Integer (To_Base_Integer (False))
                  or RFLX_Types.Base_Integer (Ctx.Cursors (F_Capabilities_Response_PSK_Cap).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.SPDM.PSK_Resp_Unsupported)))));

   function Field_Size (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Length is
     ((case Fld is
          when F_Major_Version | F_Minor_Version =>
             4,
          when F_Code | F_Algorithms_Response_Resp_Alg_Struct_Count | F_Capabilities_Response_Param_1 | F_Certificate_Response_Slot | F_Digests_Response_Param_1 | F_Error_Response_Error_Code | F_Measurements_Response_Number_Of_Indices | F_Version_Response_Param_1 | F_Algorithms_Response_Param_2 | F_Capabilities_Response_Param_2 | F_Certificate_Response_Param_2 =>
             8,
          when F_Digests_Response_Slot_Mask_Slot_7_Present =>
             1,
          when F_Error_Response_Invalid_Session_ID | F_Error_Response_Registry_ID | F_Error_Response_Request_Response_Code | F_Error_Response_Reserved_Error_Data | F_Error_Response_Zero_Error_Data =>
             8,
          when F_Measurements_Response_Reserved_1 =>
             4,
          when F_Version_Response_Param_2 =>
             8,
          when F_Algorithms_Response_Length =>
             16,
          when F_Capabilities_Response_Reserved_1 =>
             8,
          when F_Certificate_Response_Portion_Length =>
             16,
          when F_Digests_Response_Slot_Mask_Slot_6_Present =>
             1,
          when F_Error_Response_Vendor_ID_Len | F_Error_Response_Response_Not_Ready_Data_RDT_Exponent =>
             8,
          when F_Measurements_Response_Slot_ID =>
             4,
          when F_Version_Response_Reserved | F_Algorithms_Response_Measurement_Specification_Sel | F_Capabilities_Response_CT_Exponent =>
             8,
          when F_Certificate_Response_Remainder_Length =>
             16,
          when F_Digests_Response_Slot_Mask_Slot_5_Present =>
             1,
          when F_Error_Response_Vendor_ID_Double =>
             16,
          when F_Error_Response_Vendor_ID_Quad =>
             32,
          when F_Error_Response_Response_Not_Ready_Data_Request_Code | F_Measurements_Response_Number_Of_Blocks | F_Version_Response_Version_Number_Entry_Count | F_Algorithms_Response_Reserved_1 =>
             8,
          when F_Capabilities_Response_Reserved_2 =>
             16,
          when F_Certificate_Response_Cert_Chain =>
             RFLX_Types.Bit_Length (Ctx.Cursors (F_Certificate_Response_Portion_Length).Value) * 8,
          when F_Digests_Response_Slot_Mask_Slot_4_Present =>
             1,
          when F_Error_Response_Opaque_Error_Data =>
             (if
                 Ctx.Cursors (Fld).Predecessor = F_Error_Response_Vendor_ID_Double
              then
                 RFLX_Types.Bit_Length (Ctx.Written_Last) - RFLX_Types.Bit_Length (Ctx.Cursors (F_Error_Response_Vendor_ID_Double).Last)
              elsif
                 Ctx.Cursors (Fld).Predecessor = F_Error_Response_Vendor_ID_Len
                 and then (Ctx.Cursors (F_Error_Response_Vendor_ID_Len).Value = 0
                           and RFLX_Types.Bit_Length (Ctx.Cursors (F_Error_Response_Registry_ID).Value) = RFLX_Types.Bit_Length (To_Base_Integer (RFLX.SPDM.Reg_DMTF)))
              then
                 RFLX_Types.Bit_Length (Ctx.Written_Last) - RFLX_Types.Bit_Length (Ctx.Cursors (F_Error_Response_Vendor_ID_Len).Last)
              elsif
                 Ctx.Cursors (Fld).Predecessor = F_Error_Response_Vendor_ID_Quad
              then
                 RFLX_Types.Bit_Length (Ctx.Written_Last) - RFLX_Types.Bit_Length (Ctx.Cursors (F_Error_Response_Vendor_ID_Quad).Last)
              else
                 RFLX_Types.Unreachable),
          when F_Error_Response_Response_Not_Ready_Data_Token =>
             8,
          when F_Measurements_Response_Measurement_Record_Length =>
             24,
          when F_Version_Response_Version_Number_Entries =>
             RFLX_Types.Bit_Length (Ctx.Cursors (F_Version_Response_Version_Number_Entry_Count).Value) * 16,
          when F_Algorithms_Response_Measurement_Hash_Algo =>
             32,
          when F_Capabilities_Response_MAC_Cap | F_Digests_Response_Slot_Mask_Slot_3_Present =>
             1,
          when F_Error_Response_Response_Not_Ready_Data_RDTM =>
             8,
          when F_Measurements_Response_Measurement_Record =>
             RFLX_Types.Bit_Length (Ctx.Cursors (F_Measurements_Response_Measurement_Record_Length).Value) * 8,
          when F_Algorithms_Response_Base_Asym_Sel =>
             32,
          when F_Capabilities_Response_Encrypt_Cap | F_Digests_Response_Slot_Mask_Slot_2_Present =>
             1,
          when F_Measurements_Response_Nonce_Data =>
             256,
          when F_Algorithms_Response_Base_Hash_Sel =>
             32,
          when F_Capabilities_Response_Meas_Fresh_Cap | F_Digests_Response_Slot_Mask_Slot_1_Present =>
             1,
          when F_Measurements_Response_Opaque_Length =>
             16,
          when F_Algorithms_Response_Reserved_2 =>
             32,
          when F_Capabilities_Response_Meas_Cap =>
             2,
          when F_Digests_Response_Slot_Mask_Slot_0_Present =>
             1,
          when F_Measurements_Response_Opaque_Data =>
             RFLX_Types.Bit_Length (Ctx.Cursors (F_Measurements_Response_Opaque_Length).Value) * 8,
          when F_Algorithms_Response_Reserved_3 =>
             32,
          when F_Capabilities_Response_Chal_Cap =>
             1,
          when F_Digests_Response_Digests_Data =>
             (RFLX_Types.Bit_Length (Ctx.Cursors (F_Digests_Response_Slot_Mask_Slot_7_Present).Value) + RFLX_Types.Bit_Length (Ctx.Cursors (F_Digests_Response_Slot_Mask_Slot_6_Present).Value) + RFLX_Types.Bit_Length (Ctx.Cursors (F_Digests_Response_Slot_Mask_Slot_5_Present).Value) + RFLX_Types.Bit_Length (Ctx.Cursors (F_Digests_Response_Slot_Mask_Slot_4_Present).Value) + RFLX_Types.Bit_Length (Ctx.Cursors (F_Digests_Response_Slot_Mask_Slot_3_Present).Value) + RFLX_Types.Bit_Length (Ctx.Cursors (F_Digests_Response_Slot_Mask_Slot_2_Present).Value) + RFLX_Types.Bit_Length (Ctx.Cursors (F_Digests_Response_Slot_Mask_Slot_0_Present).Value) + RFLX_Types.Bit_Length (Ctx.Cursors (F_Digests_Response_Slot_Mask_Slot_1_Present).Value)) * RFLX_Types.Bit_Length (Ctx.Hash_Length) * 8,
          when F_Measurements_Response_Signature =>
             RFLX_Types.Bit_Length (Ctx.Signature_Length) * 8,
          when F_Algorithms_Response_Reserved_4 =>
             32,
          when F_Capabilities_Response_Cert_Cap =>
             1,
          when F_Algorithms_Response_Ext_Asym_Sel_Count =>
             8,
          when F_Capabilities_Response_Cache_Cap =>
             1,
          when F_Algorithms_Response_Ext_Hash_Sel_Count =>
             8,
          when F_Capabilities_Response_Handshake_In_The_Clear_Cap =>
             1,
          when F_Algorithms_Response_Reserved_5 =>
             16,
          when F_Capabilities_Response_Key_Upd_Cap =>
             1,
          when F_Algorithms_Response_Ext_Asym =>
             RFLX_Types.Bit_Length (Ctx.Cursors (F_Algorithms_Response_Ext_Asym_Sel_Count).Value) * 32,
          when F_Capabilities_Response_Hbeat_Cap =>
             1,
          when F_Algorithms_Response_Ext_Hash =>
             RFLX_Types.Bit_Length (Ctx.Cursors (F_Algorithms_Response_Ext_Hash_Sel_Count).Value) * 32,
          when F_Capabilities_Response_Encap_Cap =>
             1,
          when F_Algorithms_Response_Resp_Alg_Structs =>
             RFLX_Types.Bit_Length (Ctx.Cursors (F_Algorithms_Response_Length).Value) * 8 - RFLX_Types.Bit_Length (Ctx.Cursors (F_Algorithms_Response_Ext_Hash).Last) + RFLX_Types.Bit_Length (Ctx.Cursors (F_Algorithms_Response_Resp_Alg_Struct_Count).First) - 17,
          when F_Capabilities_Response_PSK_Cap =>
             2,
          when F_Capabilities_Response_Key_Ex_Cap | F_Capabilities_Response_Mut_Auth_Cap =>
             1,
          when F_Capabilities_Response_Reserved_4 =>
             15,
          when F_Capabilities_Response_Pub_Key_ID_Cap =>
             1));

   function Field_First (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Index is
     ((if Fld = F_Major_Version then Ctx.First else Ctx.Cursors (Ctx.Cursors (Fld).Predecessor).Last + 1));

   function Field_Last (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Length is
     (Field_First (Ctx, Fld) + Field_Size (Ctx, Fld) - 1);

   function Predecessor (Ctx : Context; Fld : Virtual_Field) return Virtual_Field is
     ((case Fld is
          when F_Initial =>
             F_Initial,
          when others =>
             Ctx.Cursors (Fld).Predecessor));

   function Valid_Predecessor (Ctx : Context; Fld : Virtual_Field) return Boolean is
     ((case Fld is
          when F_Initial =>
             True,
          when F_Major_Version =>
             Ctx.Cursors (Fld).Predecessor = F_Initial,
          when F_Minor_Version =>
             (Valid (Ctx.Cursors (F_Major_Version))
              and Ctx.Cursors (Fld).Predecessor = F_Major_Version),
          when F_Code =>
             (Valid (Ctx.Cursors (F_Minor_Version))
              and Ctx.Cursors (Fld).Predecessor = F_Minor_Version),
          when F_Algorithms_Response_Resp_Alg_Struct_Count | F_Capabilities_Response_Param_1 | F_Certificate_Response_Slot | F_Digests_Response_Param_1 | F_Error_Response_Error_Code | F_Measurements_Response_Number_Of_Indices | F_Version_Response_Param_1 =>
             (Valid (Ctx.Cursors (F_Code))
              and Ctx.Cursors (Fld).Predecessor = F_Code),
          when F_Algorithms_Response_Param_2 =>
             (Valid (Ctx.Cursors (F_Algorithms_Response_Resp_Alg_Struct_Count))
              and Ctx.Cursors (Fld).Predecessor = F_Algorithms_Response_Resp_Alg_Struct_Count),
          when F_Capabilities_Response_Param_2 =>
             (Valid (Ctx.Cursors (F_Capabilities_Response_Param_1))
              and Ctx.Cursors (Fld).Predecessor = F_Capabilities_Response_Param_1),
          when F_Certificate_Response_Param_2 =>
             (Valid (Ctx.Cursors (F_Certificate_Response_Slot))
              and Ctx.Cursors (Fld).Predecessor = F_Certificate_Response_Slot),
          when F_Digests_Response_Slot_Mask_Slot_7_Present =>
             (Valid (Ctx.Cursors (F_Digests_Response_Param_1))
              and Ctx.Cursors (Fld).Predecessor = F_Digests_Response_Param_1),
          when F_Error_Response_Invalid_Session_ID | F_Error_Response_Registry_ID | F_Error_Response_Request_Response_Code | F_Error_Response_Reserved_Error_Data | F_Error_Response_Zero_Error_Data =>
             (Valid (Ctx.Cursors (F_Error_Response_Error_Code))
              and Ctx.Cursors (Fld).Predecessor = F_Error_Response_Error_Code),
          when F_Measurements_Response_Reserved_1 =>
             (Valid (Ctx.Cursors (F_Measurements_Response_Number_Of_Indices))
              and Ctx.Cursors (Fld).Predecessor = F_Measurements_Response_Number_Of_Indices),
          when F_Version_Response_Param_2 =>
             (Valid (Ctx.Cursors (F_Version_Response_Param_1))
              and Ctx.Cursors (Fld).Predecessor = F_Version_Response_Param_1),
          when F_Algorithms_Response_Length =>
             (Valid (Ctx.Cursors (F_Algorithms_Response_Param_2))
              and Ctx.Cursors (Fld).Predecessor = F_Algorithms_Response_Param_2),
          when F_Capabilities_Response_Reserved_1 =>
             (Valid (Ctx.Cursors (F_Capabilities_Response_Param_2))
              and Ctx.Cursors (Fld).Predecessor = F_Capabilities_Response_Param_2),
          when F_Certificate_Response_Portion_Length =>
             (Valid (Ctx.Cursors (F_Certificate_Response_Param_2))
              and Ctx.Cursors (Fld).Predecessor = F_Certificate_Response_Param_2),
          when F_Digests_Response_Slot_Mask_Slot_6_Present =>
             (Valid (Ctx.Cursors (F_Digests_Response_Slot_Mask_Slot_7_Present))
              and Ctx.Cursors (Fld).Predecessor = F_Digests_Response_Slot_Mask_Slot_7_Present),
          when F_Error_Response_Vendor_ID_Len =>
             (Valid (Ctx.Cursors (F_Error_Response_Registry_ID))
              and Ctx.Cursors (Fld).Predecessor = F_Error_Response_Registry_ID),
          when F_Error_Response_Response_Not_Ready_Data_RDT_Exponent =>
             (Valid (Ctx.Cursors (F_Error_Response_Zero_Error_Data))
              and Ctx.Cursors (Fld).Predecessor = F_Error_Response_Zero_Error_Data),
          when F_Measurements_Response_Slot_ID =>
             (Valid (Ctx.Cursors (F_Measurements_Response_Reserved_1))
              and Ctx.Cursors (Fld).Predecessor = F_Measurements_Response_Reserved_1),
          when F_Version_Response_Reserved =>
             (Valid (Ctx.Cursors (F_Version_Response_Param_2))
              and Ctx.Cursors (Fld).Predecessor = F_Version_Response_Param_2),
          when F_Algorithms_Response_Measurement_Specification_Sel =>
             (Valid (Ctx.Cursors (F_Algorithms_Response_Length))
              and Ctx.Cursors (Fld).Predecessor = F_Algorithms_Response_Length),
          when F_Capabilities_Response_CT_Exponent =>
             (Valid (Ctx.Cursors (F_Capabilities_Response_Reserved_1))
              and Ctx.Cursors (Fld).Predecessor = F_Capabilities_Response_Reserved_1),
          when F_Certificate_Response_Remainder_Length =>
             (Valid (Ctx.Cursors (F_Certificate_Response_Portion_Length))
              and Ctx.Cursors (Fld).Predecessor = F_Certificate_Response_Portion_Length),
          when F_Digests_Response_Slot_Mask_Slot_5_Present =>
             (Valid (Ctx.Cursors (F_Digests_Response_Slot_Mask_Slot_6_Present))
              and Ctx.Cursors (Fld).Predecessor = F_Digests_Response_Slot_Mask_Slot_6_Present),
          when F_Error_Response_Vendor_ID_Double | F_Error_Response_Vendor_ID_Quad =>
             (Valid (Ctx.Cursors (F_Error_Response_Vendor_ID_Len))
              and Ctx.Cursors (Fld).Predecessor = F_Error_Response_Vendor_ID_Len),
          when F_Error_Response_Response_Not_Ready_Data_Request_Code =>
             (Valid (Ctx.Cursors (F_Error_Response_Response_Not_Ready_Data_RDT_Exponent))
              and Ctx.Cursors (Fld).Predecessor = F_Error_Response_Response_Not_Ready_Data_RDT_Exponent),
          when F_Measurements_Response_Number_Of_Blocks =>
             (Valid (Ctx.Cursors (F_Measurements_Response_Slot_ID))
              and Ctx.Cursors (Fld).Predecessor = F_Measurements_Response_Slot_ID),
          when F_Version_Response_Version_Number_Entry_Count =>
             (Valid (Ctx.Cursors (F_Version_Response_Reserved))
              and Ctx.Cursors (Fld).Predecessor = F_Version_Response_Reserved),
          when F_Algorithms_Response_Reserved_1 =>
             (Valid (Ctx.Cursors (F_Algorithms_Response_Measurement_Specification_Sel))
              and Ctx.Cursors (Fld).Predecessor = F_Algorithms_Response_Measurement_Specification_Sel),
          when F_Capabilities_Response_Reserved_2 =>
             (Valid (Ctx.Cursors (F_Capabilities_Response_CT_Exponent))
              and Ctx.Cursors (Fld).Predecessor = F_Capabilities_Response_CT_Exponent),
          when F_Certificate_Response_Cert_Chain =>
             (Valid (Ctx.Cursors (F_Certificate_Response_Remainder_Length))
              and Ctx.Cursors (Fld).Predecessor = F_Certificate_Response_Remainder_Length),
          when F_Digests_Response_Slot_Mask_Slot_4_Present =>
             (Valid (Ctx.Cursors (F_Digests_Response_Slot_Mask_Slot_5_Present))
              and Ctx.Cursors (Fld).Predecessor = F_Digests_Response_Slot_Mask_Slot_5_Present),
          when F_Error_Response_Opaque_Error_Data =>
             (Valid (Ctx.Cursors (F_Error_Response_Vendor_ID_Double))
              and Ctx.Cursors (Fld).Predecessor = F_Error_Response_Vendor_ID_Double)
             or (Valid (Ctx.Cursors (F_Error_Response_Vendor_ID_Len))
                 and Ctx.Cursors (Fld).Predecessor = F_Error_Response_Vendor_ID_Len)
             or (Valid (Ctx.Cursors (F_Error_Response_Vendor_ID_Quad))
                 and Ctx.Cursors (Fld).Predecessor = F_Error_Response_Vendor_ID_Quad),
          when F_Error_Response_Response_Not_Ready_Data_Token =>
             (Valid (Ctx.Cursors (F_Error_Response_Response_Not_Ready_Data_Request_Code))
              and Ctx.Cursors (Fld).Predecessor = F_Error_Response_Response_Not_Ready_Data_Request_Code),
          when F_Measurements_Response_Measurement_Record_Length =>
             (Valid (Ctx.Cursors (F_Measurements_Response_Number_Of_Blocks))
              and Ctx.Cursors (Fld).Predecessor = F_Measurements_Response_Number_Of_Blocks),
          when F_Version_Response_Version_Number_Entries =>
             (Valid (Ctx.Cursors (F_Version_Response_Version_Number_Entry_Count))
              and Ctx.Cursors (Fld).Predecessor = F_Version_Response_Version_Number_Entry_Count),
          when F_Algorithms_Response_Measurement_Hash_Algo =>
             (Valid (Ctx.Cursors (F_Algorithms_Response_Reserved_1))
              and Ctx.Cursors (Fld).Predecessor = F_Algorithms_Response_Reserved_1),
          when F_Capabilities_Response_MAC_Cap =>
             (Valid (Ctx.Cursors (F_Capabilities_Response_Reserved_2))
              and Ctx.Cursors (Fld).Predecessor = F_Capabilities_Response_Reserved_2),
          when F_Digests_Response_Slot_Mask_Slot_3_Present =>
             (Valid (Ctx.Cursors (F_Digests_Response_Slot_Mask_Slot_4_Present))
              and Ctx.Cursors (Fld).Predecessor = F_Digests_Response_Slot_Mask_Slot_4_Present),
          when F_Error_Response_Response_Not_Ready_Data_RDTM =>
             (Valid (Ctx.Cursors (F_Error_Response_Response_Not_Ready_Data_Token))
              and Ctx.Cursors (Fld).Predecessor = F_Error_Response_Response_Not_Ready_Data_Token),
          when F_Measurements_Response_Measurement_Record =>
             (Valid (Ctx.Cursors (F_Measurements_Response_Measurement_Record_Length))
              and Ctx.Cursors (Fld).Predecessor = F_Measurements_Response_Measurement_Record_Length),
          when F_Algorithms_Response_Base_Asym_Sel =>
             (Valid (Ctx.Cursors (F_Algorithms_Response_Measurement_Hash_Algo))
              and Ctx.Cursors (Fld).Predecessor = F_Algorithms_Response_Measurement_Hash_Algo),
          when F_Capabilities_Response_Encrypt_Cap =>
             (Valid (Ctx.Cursors (F_Capabilities_Response_MAC_Cap))
              and Ctx.Cursors (Fld).Predecessor = F_Capabilities_Response_MAC_Cap),
          when F_Digests_Response_Slot_Mask_Slot_2_Present =>
             (Valid (Ctx.Cursors (F_Digests_Response_Slot_Mask_Slot_3_Present))
              and Ctx.Cursors (Fld).Predecessor = F_Digests_Response_Slot_Mask_Slot_3_Present),
          when F_Measurements_Response_Nonce_Data =>
             (Structural_Valid (Ctx.Cursors (F_Measurements_Response_Measurement_Record))
              and Ctx.Cursors (Fld).Predecessor = F_Measurements_Response_Measurement_Record),
          when F_Algorithms_Response_Base_Hash_Sel =>
             (Valid (Ctx.Cursors (F_Algorithms_Response_Base_Asym_Sel))
              and Ctx.Cursors (Fld).Predecessor = F_Algorithms_Response_Base_Asym_Sel),
          when F_Capabilities_Response_Meas_Fresh_Cap =>
             (Valid (Ctx.Cursors (F_Capabilities_Response_Encrypt_Cap))
